@import "tokens.css";
/* Agent Portal - UI styles. Design tokens live in ui/tokens.css (@import below); this file is component CSS only.
   2026-11-16 file-modularity split: extracted from index.html.
   parent: index.html (markup-only shell) | siblings: ui/core.js, ui/uploads.js
   rule: memory/portal/file-modularity.md | served by GET /ui/app.css */


*{box-sizing:border-box}
body{margin:0;font-size:var(--fs-14);line-height:1.45;font-family:system-ui,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column}
header{display:flex;align-items:center;gap:var(--sp-12);padding:var(--sp-8) var(--sp-16);border-bottom:1px solid var(--line);background:var(--panel)}
header h1{font-size:var(--fs-15);margin:0;font-weight:600}
#status{margin-left:auto;display:flex;align-items:center;gap:var(--sp-8);color:var(--dim);font-size:var(--fs-12)}
.dot{width:8px;height:8px;border-radius:50%;background:var(--err)}
.dot.on{background:var(--ok)}
main{flex:1;display:flex;min-height:0}
aside{width:250px;border-right:1px solid var(--line);background:var(--panel);display:flex;flex-direction:column;min-height:0}
aside .ah{display:flex;align-items:center;padding:var(--sp-8) var(--sp-12);font-size:var(--fs-12);color:var(--dim);text-transform:uppercase;letter-spacing:.06em}
#addAgent{margin-left:auto;background:none;border:1px solid var(--line);color:var(--text);border-radius:8px;padding:3px var(--sp-8);cursor:pointer}
#addAgent:hover{border-color:var(--acc)}
#agentList{flex:1;overflow-y:auto;padding:var(--sp-4) var(--sp-8)}
.acard{display:flex;align-items:center;gap:var(--sp-8);padding:var(--sp-8);border-radius:8px;cursor:pointer;border:1px solid transparent;margin-bottom:var(--sp-4);background:var(--panel2)}
.acard:hover{border-color:var(--line)}
.acard.sel{border-color:var(--acc);background:var(--sel-bg)}
.acard .em{font-size:18px;width:26px;text-align:center}
.acard .nm{flex:1;min-width:0}
.acard .nm b{display:block;font-size:var(--fs-13);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.acard .nm span{font-size:var(--fs-11);color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}
.acard button{background:none;border:none;color:var(--dim);cursor:pointer;font-size:var(--fs-13);padding:2px var(--sp-4);border-radius:8px}
.acard button:hover{color:var(--text);background:var(--line)}
#chatCol{flex:1;display:flex;flex-direction:column;min-width:0}
#modeBar{display:flex;gap:var(--sp-8);padding:var(--sp-8) var(--sp-16);border-bottom:1px solid var(--line);align-items:center;background:var(--panel)}
.seg{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.seg button{background:none;border:none;color:var(--dim);padding:var(--sp-4) var(--sp-16);cursor:pointer;font-size:var(--fs-13)}
.seg button.on{background:var(--acc-active);color:var(--white)}
#modeHint{font-size:var(--fs-12);color:var(--dim)}
#resetBtn{margin-left:auto;background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:var(--sp-4) var(--sp-8);cursor:pointer;font-size:var(--fs-12)}
#resetBtn:hover{border-color:var(--warn);color:var(--text)}
#msgs{flex:1;overflow-y:auto;padding:var(--sp-16) var(--sp-16);display:flex;flex-direction:column;gap:var(--sp-12)}
.msg{max-width:78%;padding:var(--sp-8) var(--sp-12);border-radius:12px;background:var(--panel2);border:1px solid var(--line);white-space:pre-wrap;word-wrap:break-word}
.msg .who{font-size:var(--fs-11);font-weight:600;margin-bottom:3px;display:flex;gap:var(--sp-8);align-items:center}
.msg.you{align-self:flex-end;background:var(--msg-you);border-color:var(--msg-you-bd)}
.think{margin-top:var(--sp-4);font-size:var(--fs-11);color:var(--dim);border-left:2px solid var(--line);padding-left:var(--sp-8);white-space:pre-wrap}
.think summary{cursor:pointer;font-size:var(--fs-11);font-style:italic;color:var(--faint);user-select:none;list-style:none}
.think summary::-webkit-details-marker{display:none}
.think .tbody{max-height:120px;overflow-y:auto;margin-top:2px}
.thinkwrap{align-self:flex-start;max-width:62%;padding:3px var(--sp-8);border:1px dashed var(--line);border-radius:8px}
.silentpill{font-size:var(--fs-11);color:var(--dim);opacity:.85;white-space:nowrap}
.roundend{font-size:var(--fs-11);padding:var(--sp-4) var(--sp-8);border-radius:8px;margin-top:var(--sp-8)}
.roundend.ok{color:var(--ok);background:rgba(61,220,132,.08);border:1px solid rgba(61,220,132,.25)}
.roundend.warn{color:var(--warn);background:rgba(255,159,67,.08);border:1px solid rgba(255,159,67,.3)}
.roundend.dim{color:var(--dim);background:var(--panel2);border:1px solid var(--line)}
.msg.silentmsg .who{opacity:.6}
.msg.silentmsg .body{font-size:var(--fs-11);color:var(--faint);font-style:italic}
.tsec{margin-top:var(--sp-4);padding-left:var(--sp-8);border-left:1px solid var(--line)}
.tsec:first-child{margin-top:2px}
.tsec b{display:block;font-size:var(--fs-11);font-weight:600;color:var(--text);opacity:.8;margin-bottom:1px}
.msg .toolchip{display:inline-block;margin:var(--sp-4) var(--sp-4) 0 0;font-size:var(--fs-11);background:var(--line);border-radius:8px;padding:1px var(--sp-8);color:var(--warn)}
.dmpub{white-space:pre-wrap}
.dmseg{margin-top:var(--sp-8);border:1px solid var(--dm-border);background:rgba(138,99,210,.10);border-radius:8px;padding:var(--sp-4) var(--sp-8);font-size:var(--fs-12)}
.dmseg summary{cursor:pointer;color:var(--dm-text);user-select:none;font-weight:600}
.dmseg .dmbody{margin-top:var(--sp-4);white-space:pre-wrap;color:var(--dim);font-size:var(--fs-12)}
.typing{color:var(--dim);font-size:var(--fs-12);align-self:flex-start;padding:0 var(--sp-4)}
#composer{display:flex;gap:var(--sp-8);padding:var(--sp-12) var(--sp-16);border-top:1px solid var(--line);background:var(--panel)}
#input{flex:1;background:var(--panel2);border:1px solid var(--line);border-radius:8px;color:var(--text);padding:var(--sp-8) var(--sp-12);font-size:var(--fs-14);resize:none;height:44px}
#input:focus{outline:none;border-color:var(--acc)}
#send{background:var(--acc);border:none;color:var(--white);border-radius:8px;padding:0 var(--sp-16);cursor:pointer;font-size:var(--fs-14)}
#send:disabled{opacity:.5;cursor:default}
#attachWrap{position:relative}
#attach{background:none;border:1px solid var(--line);color:var(--acc);border-radius:8px;width:44px;height:44px;font-size:22px;line-height:1;cursor:pointer}
#attach:hover{border-color:var(--acc)}
.amenu{position:absolute;bottom:calc(100% + var(--sp-8));left:0;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:var(--sp-8);display:flex;flex-direction:column;gap:var(--sp-4);z-index:60;min-width:180px}
.amenu[hidden]{display:none}
.amenu button{background:none;border:none;color:var(--text);text-align:left;padding:var(--sp-8) var(--sp-8);border-radius:8px;cursor:pointer;font-size:var(--fs-13)}
.amenu button:hover{background:var(--panel)}
#chips{display:flex;flex-wrap:wrap;gap:var(--sp-8)}
#chips:not(:empty){padding:var(--sp-8) var(--sp-16) 0}
.chipfile{display:flex;align-items:center;gap:var(--sp-8);background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:var(--sp-4) var(--sp-8);font-size:var(--fs-12);max-width:360px}
.chipfile .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chipfile .sz{opacity:.6;flex:none}
.chipfile .st{color:var(--acc);flex:none}
.chipfile .st.err{color:var(--err)}
.chipfile button{background:none;border:none;color:var(--text);cursor:pointer;opacity:.7;flex:none}
#composer.dragover{outline:2px dashed var(--acc);outline-offset:-4px}
dialog{background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:12px;width:min(560px,92vw);padding:0}
dialog::backdrop{background:rgba(0,0,0,.55)}
.dhead{display:flex;align-items:center;padding:var(--sp-12) var(--sp-16);border-bottom:1px solid var(--line);font-weight:600}
.dhead button{margin-left:auto;background:none;border:none;color:var(--dim);cursor:pointer;font-size:var(--fs-16)}
.dbody{padding:var(--sp-16) var(--sp-16);display:flex;flex-direction:column;gap:var(--sp-8);max-height:70vh;overflow-y:auto}
.frow{display:flex;gap:var(--sp-8)}.frow>div{flex:1}
label{font-size:var(--fs-12);color:var(--dim);display:block;margin-bottom:3px}
input[type=text],input[type=number],select,textarea{width:100%;background:var(--panel2);border:1px solid var(--line);border-radius:8px;color:var(--text);padding:var(--sp-8) var(--sp-8);font-size:var(--fs-13)}
textarea{resize:vertical;min-height:64px}
.hint{font-size:var(--fs-11);color:var(--dim)}
.checks{display:flex;flex-wrap:wrap;gap:var(--sp-8)}
.checks label{display:flex;align-items:center;gap:var(--sp-4);font-size:var(--fs-12);color:var(--text);margin:0;background:var(--panel2);border:1px solid var(--line);padding:var(--sp-4) var(--sp-8);border-radius:8px;cursor:pointer}
.checks input{width:auto;margin:0}
.dfoot{display:flex;justify-content:flex-end;gap:var(--sp-8);padding:var(--sp-12) var(--sp-16);border-top:1px solid var(--line)}
.btn{border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:8px;padding:var(--sp-8) var(--sp-16);cursor:pointer;font-size:var(--fs-13)}
.btn.pri{background:var(--acc);border-color:var(--acc);color:var(--white)}
.toggle{display:flex;align-items:center;gap:var(--sp-8);font-size:var(--fs-13);color:var(--text)}
.busyspan{color:var(--muted);font-style:italic;animation:pulse 1.3s ease-in-out infinite}
@keyframes pulse{50%{opacity:.4}}
.flink{color:var(--link);text-decoration:none;border-bottom:1px dashed rgba(109,177,255,.5)}
.flink:hover{color:var(--link-hv);border-bottom-style:solid}
#peek{position:fixed;z-index:99;display:none;max-width:340px;background:var(--peek-bg);border:1px solid var(--peek-bd);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.5);font-size:var(--fs-11);color:var(--peek-tx)}
#peek .pk-h{padding:var(--sp-8) var(--sp-8);font-weight:600;border-bottom:1px solid var(--peek-bd);color:var(--link-hv)}
#peek .pk-sz{color:var(--muted);font-weight:400;margin-left:var(--sp-8)}
#peek .pk-body{margin:0;padding:var(--sp-8) var(--sp-8);white-space:pre-wrap;word-break:break-word;max-height:180px;overflow:auto;font-family:ui-monospace,Consolas,monospace;color:var(--peek-body)}
#actBtn{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:var(--sp-4) var(--sp-8);cursor:pointer;font-size:var(--fs-12)}
#actBtn:hover,#actBtn.on{border-color:var(--acc);color:var(--text)}
#actPanel{display:none;border-bottom:1px solid var(--line);background:var(--panel);max-height:240px;flex-direction:column}
#actPanel.open{display:flex}
#fleetPanel{display:none;border-bottom:1px solid var(--line);background:var(--panel);max-height:280px;flex-direction:column}
#fleetPanel.open{display:flex}
#fleetHead{display:flex;align-items:center;gap:var(--sp-8);padding:var(--sp-8) var(--sp-16);font-size:var(--fs-12);color:var(--dim);border-bottom:1px solid var(--line)}
#fleetBody{overflow-y:auto;padding:var(--sp-8) var(--sp-16)}
.frow-h{padding:var(--sp-8) 0;border-bottom:1px dashed var(--line);font-size:var(--fs-12)}
.frow-h:last-child{border-bottom:none}
.fdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:var(--sp-8);background:var(--dot-idle)}
.fdot.busy{background:var(--dot-busy)}
.fdot.idle{background:var(--ok)}
.fdot.unknown{background:var(--dot-err)}
.fmodels{color:var(--text);margin:3px 0 0 var(--sp-16);font-family:ui-monospace,Consolas,monospace;font-size:var(--fs-12)}
#fleetBtn{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:var(--sp-4) var(--sp-8);cursor:pointer;font-size:var(--fs-12)}
#fleetBtn:hover,#fleetBtn.on{border-color:var(--acc);color:var(--text)}
#opsPanel{display:none;border-bottom:1px solid var(--line);background:var(--panel);max-height:360px;flex-direction:column}
#opsPanel.open{display:flex}
#opsHead{display:flex;align-items:center;gap:var(--sp-8);padding:var(--sp-8) var(--sp-16);font-size:var(--fs-12);color:var(--dim);border-bottom:1px solid var(--line)}
#opsBody{overflow-y:auto;padding:var(--sp-8) var(--sp-16)}
.opsbox{font-size:var(--fs-12);line-height:1.6;font-family:ui-monospace,Consolas,monospace;white-space:pre-wrap;color:var(--dim);max-height:none;overflow:visible;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:var(--sp-4) var(--sp-8);margin-top:var(--sp-8)}
#gitMsg{flex:1;padding:var(--sp-4) var(--sp-8);font-size:var(--fs-12);background:var(--bg);border:1px solid var(--line);border-radius:8px;color:var(--text)}
.opsrow{display:flex;gap:var(--sp-8);margin-top:var(--sp-8);align-items:center}
#actHead{display:flex;align-items:center;gap:var(--sp-8);padding:var(--sp-8) var(--sp-16);font-size:var(--fs-12);color:var(--dim);border-bottom:1px solid var(--line)}
#actSel{width:auto;max-width:360px;padding:3px var(--sp-8);font-size:var(--fs-12)}
#actBody{overflow-y:auto;padding:var(--sp-8) var(--sp-16);font-size:var(--fs-12);line-height:1.7;font-family:ui-monospace,Consolas,monospace}
.aev{display:flex;gap:var(--sp-8);align-items:baseline;white-space:nowrap}
.aev .at{color:var(--faint);flex:none;width:64px}
.aev .an{font-weight:600;flex:none}
.aev .ax{color:var(--dim);overflow:hidden;text-overflow:ellipsis}
/* A3 ops-polish 11-13 (Designer): functional focus ring + status-line semantics */
#opsPanel button:focus-visible,#opsPanel input:focus-visible,
#modeBar button:focus-visible,.seg button:focus-visible{
  outline:2px solid var(--focus);outline-offset:2px}
#gitMsg{border-color:var(--line)}
#gitMsg:focus{border-color:var(--focus);outline:none}
/* A2 files-panel 11-13 (Designer): uploads/ listing; load-on-open + ↻ only, no polling */
#filesBtn{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:var(--sp-4) var(--sp-8);cursor:pointer;font-size:var(--fs-12)}
#filesBtn:hover,#filesBtn.on{border-color:var(--acc);color:var(--text)}
#filesPanel{display:none;border-bottom:1px solid var(--line);background:var(--panel);max-height:280px;flex-direction:column}
#filesPanel.open{display:flex}
#filesHead{display:flex;align-items:center;gap:var(--sp-8);padding:var(--sp-8) var(--sp-16);font-size:var(--fs-12);color:var(--dim);border-bottom:1px solid var(--line)}
#filesList{list-style:none;margin:0;padding:0;overflow:auto;font-size:var(--fs-12)}
#filesList li{padding:var(--sp-4) var(--sp-8);border-bottom:1px solid var(--line)}
#filesList a{color:var(--focus);text-decoration:none;display:block}
#filesList a:hover{text-decoration:underline}
.fs-meta{color:var(--dim);font-size:var(--fs-11);white-space:nowrap;margin-left:var(--sp-8)}
.fs-empty{padding:var(--sp-8);color:var(--dim)}
/* Goal Velocity dashboard (2026-11-15, Designer): /api/goals -> per-agent SVG rings */
#goalsBtn{background:none;border:1px solid var(--line);color:var(--dim);border-radius:8px;padding:var(--sp-4) var(--sp-8);cursor:pointer;font-size:var(--fs-12)}
#goalsBtn:hover,#goalsBtn.on{border-color:var(--acc);color:var(--text)}
#goalsPanel{display:none;border-bottom:1px solid var(--line);background:var(--panel);max-height:300px;flex-direction:column}
#goalsPanel.open{display:flex}
#goalsHead{display:flex;align-items:center;gap:var(--sp-8);padding:var(--sp-8) var(--sp-16);font-size:var(--fs-12);color:var(--dim);border-bottom:1px solid var(--line)}
#goalsBody{overflow-y:auto;padding:var(--sp-8) var(--sp-16);display:flex;flex-wrap:wrap;gap:var(--sp-8)}
.gtile{display:flex;align-items:center;gap:var(--sp-8);background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:var(--sp-8) var(--sp-12);min-width:170px}
.gring{position:relative;width:44px;height:44px;flex:none}
.gring svg{transform:rotate(-90deg)}
.gring .pct{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:var(--fs-11);font-weight:600}
.gname{font-size:var(--fs-12);font-weight:600}
.gmeta{font-size:var(--fs-11);color:var(--dim)}
.gblock{color:var(--warn);font-size:var(--fs-11)}
/* Motion spec (2026-11-15, Designer): 150-200ms on interactive elements only */
#modeBar button,.seg button,.btn,#send{transition:border-color .15s,color .15s,background-color .15s,opacity .15s}
.dot{transition:background-color .2s}
.flink{transition:color .15s,border-bottom-color .15s}
.toggles{display:inline-flex;gap:var(--sp-8)}
.vdiv{width:1px;height:16px;background:var(--line);margin:0 var(--sp-4)}

/* ---- User message queue + interrupted-run banner (2026-11-15) ---- */
#queuePanel{display:none;border-top:1px solid var(--line);background:var(--queue-bg);padding:var(--sp-8) var(--sp-12);max-height:140px;overflow-y:auto}
#queuePanel.has{display:block}
#queueHead{font-size:var(--fs-11);color:var(--queue-dim);text-transform:uppercase;letter-spacing:.06em;margin-bottom:var(--sp-4)}
.qrow{display:flex;align-items:center;gap:var(--sp-8);padding:3px 0;font-size:var(--fs-13)}
.qspin{width:12px;height:12px;border:2px solid var(--qspin-bd);border-top-color:var(--qspin-top);border-radius:50%;flex:none;animation:qspin .9s linear infinite}
@keyframes qspin{to{transform:rotate(360deg)}}
.qts{color:var(--queue-dim);font-size:var(--fs-11);flex:none}
.qtxt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--queue-tx)}
.qc{margin-left:auto;color:var(--queue-dim);font-size:var(--fs-11);flex:none}
#intBanner{display:none;margin:var(--sp-8) var(--sp-12);border:1px solid var(--int-border);background:var(--int-bg);color:var(--int-text);border-radius:8px;padding:var(--sp-8) var(--sp-12);font-size:var(--fs-13);align-items:center;gap:var(--sp-8)}
#intBanner.show{display:flex}
#intBanner .iact{margin-left:auto}

/* ---- Responsive pass (goal 7, set 2026-11-13): 768px + 375px breakpoints ---- */
@media (max-width:768px){
  aside{width:180px}
  header{flex-wrap:wrap;gap:var(--sp-8);padding:var(--sp-8) var(--sp-12)}
  #modeBar{flex-wrap:wrap;padding:var(--sp-8) var(--sp-12)}
  .opsrow{flex-wrap:wrap}
  #msgs{padding:var(--sp-12)}
  #composer{flex-wrap:wrap;padding:var(--sp-8) var(--sp-12)}
  #peek{max-width:calc(100vw - 24px)}
  dialog{width:min(560px,96vw)}
}
@media (max-width:375px){
  main{flex-direction:column}
  aside{width:100%;max-height:26vh;border-right:0;border-bottom:1px solid var(--line)}
  #agentList{display:flex;flex-direction:row;gap:var(--sp-4);overflow-x:auto;overflow-y:hidden}
  .acard{flex:0 0 auto;min-width:160px;margin-bottom:0}
  header h1{font-size:var(--fs-13)}
  #status{margin-left:0;width:100%;order:2}
  .opsbox{flex:1 1 100%}
  #msgs{padding:var(--sp-8);gap:var(--sp-8)}
  #composer{padding:var(--sp-8)}
  .frow{flex-direction:column;gap:var(--sp-8)}
  .dbody{padding:var(--sp-8) var(--sp-12)}
  #send{padding:0 var(--sp-16)}
}

/* Memory Health cards (Scribe goal 9, re-landed 2026-11-17) */
#memHealthBody{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px}
.mh-card{border:1px solid var(--line);border-radius:6px;padding:6px 8px;font-size:12px}
.mh-k{font-weight:600;font-size:11px;opacity:.75}
.mh-v{font-size:16px;font-weight:700;margin:2px 0}
.mh-d{opacity:.6;font-size:11px;line-height:1.3}

/* ---- FleetTopology diagram (Designer goal #9, 2026-11-17) — all values tokenized per :root layer ---- */
/* 2026-11-17 (Studio seat): REMOVED a self-referential :root alias block that was here
   (--bg:var(--bg) ... --faint:var(--faint), added with the FleetTopology section). A var()
   cycle makes every token guaranteed-invalid at computed-value time, so ALL themed rules
   fell back to browser defaults -> page rendered raw white ("too bright" report, 2026-11-17).
   Canonical production family = the dark :root above (Orchestrator ruling 2026-11-14,
   memory/portal/design-tokens.md). Do NOT re-add token aliases in a second :root; a
   light theme belongs under [data-theme=light] with literal values only. */
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,Segoe UI,Roboto,sans-serif;padding:20px}
h1{font-size:var(--fs-24);margin:0 0 4px;font-weight:650}
.sub{color:var(--dim);font-size:12px;margin:0 0 14px;line-height:1.5}
code{background:var(--line);border-radius:5px;padding:1px 5px;font-size:11px;color:var(--text)}
#fleetTopo{max-width:860px}
.legend{display:flex;gap:18px;font-size:11.5px;color:var(--dim);margin-top:12px;flex-wrap:wrap}
.legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:middle}
.ft-wrap{position:relative;width:100%;min-height:240px;font-family:system-ui,Segoe UI,Roboto,sans-serif}
.ft-svg{width:100%;height:auto;display:block;background:var(--bg);border:1px solid var(--line);border-radius:12px}
.ft-link{stroke:var(--line);stroke-width:1.5}
.ft-agentlink{stroke:var(--faint);stroke-width:1;opacity:.5}
.ft-host rect{fill:var(--panel);stroke:var(--line);stroke-width:1.5;transition:stroke .15s, fill .15s}
.ft-host:hover rect,.ft-host:focus rect{stroke:var(--acc);fill:var(--panel2)}
.ft-host:focus{outline:none}
.ft-portal rect{fill:var(--panel2);stroke:var(--line);stroke-width:1.5}
.ft-agent circle{fill:var(--faint)}
.ft-hostname{fill:var(--text);font-size:13px;font-weight:600}
.ft-subline{fill:var(--dim);font-size:10.5px}
.ft-state{stroke:rgba(0,0,0,.25)}
.ft-tooltip{position:absolute;z-index:5;max-width:250px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:11.5px;color:var(--text);box-shadow:0 6px 20px rgba(0,0,0,.4);pointer-events:none;line-height:1.5}
.ft-tt-head{display:flex;align-items:center;gap:6px;font-weight:600;margin-bottom:4px}
.ft-tt-head em{color:var(--dim);font-style:normal;font-weight:400}
.ft-tt-row{color:var(--dim);word-break:break-all}
.ft-tt-row b{color:var(--text);font-weight:600;margin-right:2px}
.ft-detail{position:absolute;right:10px;top:10px;z-index:4;width:230px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:12px;color:var(--text);box-shadow:0 8px 24px rgba(0,0,0,.5)}
.ft-dt-head{display:flex;align-items:center;gap:6px;font-size:13px;margin-bottom:2px}
.ft-dt-head em{color:var(--dim);font-style:normal;font-weight:400;font-size:11px}
.ft-dt-base{font-family:ui-monospace,Consolas,monospace;font-size:10.5px;color:var(--faint);word-break:break-all;margin-bottom:8px}
.ft-dt-sub{color:var(--dim);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;margin:6px 0 3px;font-weight:600}
.ft-models{margin:0;padding-left:16px;line-height:1.6}
.ft-quant{color:var(--acc);font-size:10px}
.ft-agents{display:flex;flex-wrap:wrap;gap:4px}
.ft-chip{background:var(--line);border-radius:8px;padding:1px 7px;font-size:11px;color:var(--text)}
.ft-empty{color:var(--faint);font-style:italic}

/* Notification System (Goal #5) */
#notifBell{background:none;border:none;cursor:pointer;color:var(--dim);padding:var(--sp-4);border-radius:var(--br-md);position:relative;display:flex;align-items:center}
#notifBell:hover{color:var(--text);background:var(--panel2)}
#notifBadge{position:absolute;top:0;right:0;background:var(--err);color:var(--white);font-size:var(--fs-11);font-weight:600;border-radius:50%;min-width:16px;height:16px;display:flex;align-items:center;justify-content:center;padding:0 3px}
#toastContainer{position:fixed;top:var(--sp-12);right:var(--sp-12);z-index:9999;display:flex;flex-direction:column;gap:var(--sp-4);max-width:320px}
.toast{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--acc);border-radius:var(--br-md);padding:var(--sp-8) var(--sp-12);font-size:var(--fs-14);color:var(--text);box-shadow:0 4px 12px rgba(0,0,0,.3);animation:toast-in .3s ease;display:flex;align-items:center;gap:var(--sp-8)}
.toast.t-ok{border-left-color:var(--ok)}
.toast.t-warn{border-left-color:var(--warn)}
.toast.t-err{border-left-color:var(--err)}
.toast.out{animation:toast-out .3s ease forwards}
.t-msg{flex:1;line-height:var(--lh-base)}
.t-x{background:none;border:none;color:var(--dim);cursor:pointer;font-size:var(--fs-18);padding:0 2px}
.t-x:hover{color:var(--text)}
@keyframes toast-in{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:none}}
@keyframes toast-out{from{opacity:1}to{opacity:0;transform:translateX(20px)}}
@media(prefers-reduced-motion:reduce){.toast,.toast.out{animation:none}}

/* Onboarding Tour (Goal #9) */
body.tour-on{overflow:hidden}
.tour-scrim{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:10000;transition:opacity .3s}
.tour-card{position:fixed;z-index:10001;background:var(--panel);border:1px solid var(--line);border-radius:var(--br-md);padding:var(--sp-12);max-width:280px;box-shadow:0 8px 32px rgba(0,0,0,.4);animation:toast-in .3s ease}
.tour-step{font-size:var(--fs-12);color:var(--dim);margin-bottom:var(--sp-4)}
.tour-title{font-size:var(--fs-15);font-weight:600;color:var(--text);margin-bottom:var(--sp-4)}
.tour-desc{font-size:var(--fs-14);color:var(--dim);line-height:var(--lh-base);margin-bottom:var(--sp-12)}
.tour-bar{display:flex;gap:var(--sp-8);align-items:center}
.tour-skip{background:none;border:none;color:var(--dim);font-size:var(--fs-12);cursor:pointer;padding:0}
.tour-skip:hover{color:var(--text)}
.tour-target{outline:2px solid var(--acc);outline-offset:2px;border-radius:var(--br-sm)}

/* Loading skeletons (Designer goal #6) - layout-matched placeholders + shimmer. */
.skel{position:relative;overflow:hidden;background:var(--line);border-radius:var(--br-sm)}
.skel::after{content:"";position:absolute;inset:0;transform:translateX(-100%);
  background:linear-gradient(90deg,transparent,var(--panel2),transparent);
  animation:skel-shimmer 1.4s ease-in-out infinite}
@keyframes skel-shimmer{100%{transform:translateX(100%)}}
.skel-dot{width:10px;height:10px;border-radius:var(--br-full);flex:none}
.skel-ring{width:44px;height:44px;border-radius:var(--br-full);flex:none}
.skel-line{height:12px;margin-bottom:var(--sp-4)}
.skel-row{display:flex;align-items:center;gap:var(--sp-8);padding:var(--sp-8) var(--sp-4)}
.skel-row .skel-line:last-child{margin-bottom:0}
.skel-tile{display:flex;align-items:center;gap:var(--sp-12);padding:var(--sp-8)}
@media(prefers-reduced-motion:reduce){.skel::after{animation:none;opacity:.4}}

/* ── Goal 10: Print-Ready Report Layout ─────────────────────────────── */
@media print{
  /* Reset to clean print base */
  *,*::before,*::after{animation:none!important;transition:none!important;box-shadow:none!important}
  body{background:var(--paper)!important;color:var(--black)!important;font-size:12px;line-height:1.4;margin:0;padding:0}

  /* Hide interactive / non-printable elements */
  .tabbar,.tabs,button,input,select,textarea,#printReportBtn,#resetBtn,
  .notif-bell,.toast-container,.skel,.empty-state-cta{display:none!important}

  /* Force all panels visible and expanded */
  .panel,.panel.collapsed,.panel[hidden]{display:block!important;visibility:visible!important;height:auto!important;overflow:visible!important}
  #fleetPanel,#goalsPanel,#opsPanel,#filesPanel{display:block!important;border:none!important;margin:0 0 var(--sp-12);padding:var(--sp-8) 0}

  /* Page breaks between major sections */
  #fleetPanel{page-break-after:always}
  #goalsPanel{page-break-after:always}
  #opsPanel{page-break-after:always}
  #filesPanel{page-break-before:avoid}

  /* Typography for print */
  h1,h2,h3{color:var(--black)!important}
  .hint,.dim{color:var(--print-dim)!important}
  .opsbox{border:1px solid var(--print-line);padding:var(--sp-6);font-family:monospace;font-size:11px;white-space:pre-wrap;word-break:break-all}

  /* Remove dark theme artifacts */
  [data-theme="dark"],body{background:var(--paper)!important}
  .card,.tile,.row{border:1px solid var(--print-border)!important;background:var(--paper)!important}

  /* Header/title for the report */
  body::before{content:"Agent Portal Report — " counter(date);display:block;font-size:18px;font-weight:bold;margin-bottom:var(--sp-8);border-bottom:2px solid var(--black);padding-bottom:var(--sp-4)}
}
