<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤖</text></svg>">
<title>Agent Portal</title>
<!-- 2026-11-16 file-modularity rule: this file is the MARKUP-ONLY shell.
     UI modules (edit those, not here): ui/app.css (styles) | ui/core.js (app logic)
     | ui/uploads.js (upload panel). Rule + budgets: memory/portal/file-modularity.md.
     PINNED in memory_mirror.py PIN_FILES - advance the pin in the same turn as any edit. -->
<link rel="stylesheet" href="ui/app.css">
</head>
<body>
<header>
  <h1>🤖 Agent Portal</h1>
  <span class="hint">backed by Unsloth Studio desktop harness · v3</span>
  <div id="status"><span class="dot" id="sdot"></span><span id="stext">checking studio…</span></div>
</header>
<main>
  <aside aria-label="Agent roster">
    <div class="ah">Agents <button id="addAgent" title="Add agent">＋ Add</button></div>
    <div id="agentList"></div>
  </aside>
  <div id="chatCol">
    <div id="modeBar">
      <nav class="seg" aria-label="Chat mode">
        <button id="mSolo" class="on">Solo</button>
        <button id="mGroup">Group</button>
      </nav>
      <span id="modeHint">Chatting with —</span><span id="xtalk" class="hint"></span><span id="busyHint" class="busyspan"></span>
      <button id="navToggle" class="nav-toggle" aria-label="Menu: panel toggles" aria-expanded="false" aria-controls="toggles">☰</button><span class="toggles" id="toggles"><button id="goalsBtn" title="Goal velocity: per-agent progress rings from memory/goals/">🎯 Goals</button><button id="actBtn" title="Activity timeline: every turn + tool call of each run, persisted per session (survives restarts)">⏱ Activity</button>
      <button id="fleetBtn" title="Fleet status: per-host loaded models + busy/idle/unknown; live while open">🛰 Fleet</button>
      <button id="filesBtn" title="Uploaded files (uploads/): humans' drop zone; lists on open, ↻ to re-list">📁 Files</button>
      <button id="opsBtn" title="Ops: local git status + commit, and prune fully-completed TODO sections into TODO_completed.md">🔧 Ops</button></span><span class="vdiv"></span>
      <button id="resetBtn" title="Reset conversation: clears chat history and the agent-to-agent counter">↺ Reset</button>
      <button id="stopBtn" disabled style="color:var(--err)" title="Stop this run now: aborts in-flight replies and closes the round as concluded">■ Stop</button>
    </div>
    <div id="actPanel">
      <div id="actHead"><span>session</span><select id="actSel"></select><span id="actStat" class="hint"></span>
        <button class="btn" id="actRefresh" style="margin-left:auto;padding:2px 10px;font-size:12px">↻ refresh</button></div>
      <div id="actBody"></div>
    </div>
    <div id="fleetPanel">
      <div id="fleetHead"><span>4-host fleet · live while open (5s refresh)</span><span id="fleetStat" class="hint">loading…</span></div>
      <div id="fleetTopo" role="img" aria-label="Fleet topology diagram: hosts and their agent nodes with live status"></div>
      <div id="fleetHealth" role="status" aria-label="Fleet health scores"></div>
<div id="fleetBody"></div>
    </div>
    <div id="opsPanel">
      <div id="opsHead"><span>Repo ops · local git in C:\Projects\Workspace</span><span id="opsStat" class="hint">loading…</span></div>
      <div id="opsBody">
        <div style="font-size:12px;color:var(--dim)">Working tree (uncommitted):</div>
        <div class="opsbox" id="gitStatus">—</div>
        <div style="font-size:12px;color:var(--dim);margin-top:6px">Recent commits:</div>
        <div class="opsbox" id="gitLog">—</div>
        <div style="font-size:12px;color:var(--dim);margin-top:6px">Sandbox merge queue (agent code edits captured before push-clobber):</div>
        <div class="opsbox" id="mergeQueue">—</div>
        <div style="font-size:12px;color:var(--dim);margin-top:8px">Host tiles · this portal's host (GET /api/ops):</div>
        <div class="opsrow" style="align-items:stretch">
          <div class="opsbox" id="diskTile" style="flex:1;max-height:none" aria-label="Disk usage">—</div>
          <div class="opsbox" id="uptimeTile" style="flex:1;max-height:none" aria-label="Portal uptime">—</div>
        </div>
        <div class="opsrow">
          <input id="gitMsg" placeholder="commit message…" aria-label="Commit message">
          <button class="btn" id="gitCommit">⬆ Commit all</button>
          <button class="btn" id="todoPrune" title="Moves TODO.md sections whose items are all [x] into TODO_completed.md (splits into numbered parts as it grows)">✂ Prune done TODO</button>
        </div>
        <div id="opsMsg" class="hint" role="status" aria-live="polite" style="margin-top:6px;font-size:12px"></div>
      </div>
    </div>
    <div id="filesPanel">
      <div id="filesHead"><span>uploads/ — humans' drop zone (shared agent folder)</span><button class="btn" id="filesRefresh" style="margin-left:auto;padding:2px 10px;font-size:12px" title="Re-list uploads/">↻ refresh</button></div>
      <ul id="filesList"></ul>
    </div>
    <div id="goalsPanel">
      <div id="goalsHead"><span>Goal velocity · live parse of memory/goals/</span><span id="goalsStat" class="hint">loading…</span></div>
      <div id="goalsBody"></div>
      <div id="goalsGit" class="hint" style="margin-top:6px;font-size:12px"></div>
      <div id="memHealthSection" style="margin-top:8px">
        <div class="hint" style="font-size:12px;margin-bottom:4px">Memory health · live from /api/memory-health</div>
        <div id="memHealthBody"></div>
      </div>
    </div>
    <div id="msgs"></div>
        <div id="intBanner"><span id="intText"></span><button id="intResume" class="iact">send continue prompt</button><button id="intDismiss">dismiss</button></div>
    <div id="queuePanel"><div id="queueHead">queued - waiting for agents to pick up</div><div id="queueList"></div></div>
<div id="composer">
      <textarea id="input" placeholder="Type a message…  (in Group mode, use @Name to address one agent; + or drag &amp; drop to attach files/folders)"></textarea>
      <div id="attachWrap">
        <button id="attach" title="Upload files or a folder to the shared agent folder (uploads/)">+</button>
        <div id="attachMenu" class="amenu" hidden>
          <button data-act="files">Upload files…</button>
          <button data-act="folder">Upload folder…</button>
        </div>
      </div>
      <button id="send">Send</button>
    </div>
    <input type="file" id="filePick" multiple hidden>
    <input type="file" id="dirPick" webkitdirectory hidden>
  </div>
</main>
<div id="peek"></div>

<dialog id="editor">
  <div class="dhead"><span id="edTitle">Edit agent</span><button id="edClose" title="Close">✕</button></div>
  <div class="dbody">
    <div class="frow">
      <div><label>Name</label><input type="text" id="f_name"></div>
      <div style="max-width:70px"><label>Emoji</label><input type="text" id="f_emoji" maxlength="4"></div>
      <div style="max-width:90px"><label>Color</label><input type="color" id="f_color" style="height:32px;padding:2px"></div>
    </div>
    <div><label>Short blurb (shown to other agents)</label><input type="text" id="f_blurb"></div>
    <div><label>Role / persona</label><textarea id="f_persona" rows="4" placeholder="You are …"></textarea></div>
    <label class="toggle" style="margin-bottom:6px"><input type="checkbox" id="f_net" style="width:auto"> Networked host (Studio on another machine)</label>
    <div id="netFields" style="display:none;margin-bottom:8px">
      <div class="frow">
        <div><label>Studio base URL</label><input type="text" id="f_studio" placeholder="http://Black:8888"></div>
        <div><label>API key (Bearer)</label><input type="password" id="f_key" placeholder="sk-unsloth-…"></div>
      </div>
      <div class="frow">
        <button class="btn" id="f_scan" style="height:30px">Scan models</button>
        <span id="f_scanstat" class="hint"></span>
      </div>
      <div class="frow">
        <div><label>RAG host <span class="hint">(blank = chat host)</span></label><input type="text" id="f_ragstudio" placeholder="http://127.0.0.1:8888 (White's index)"></div>
        <div><label>RAG API key <span class="hint">(blank = none / chat key)</span></label><input type="password" id="f_ragkey" placeholder="only if RAG host needs auth"></div>
      </div>
    </div>
    <div><label>Model (managed by Studio)</label><select id="f_model"></select></div>
    <div class="frow">
      <div><label>Temperature</label><input type="number" id="f_temp" step="0.1" min="0" max="2"></div>
      <div><label>Max tokens <span class="hint">(0 = Studio decides)</span></label><input type="number" id="f_maxtok" min="0" step="64"></div>
    </div>
    <div class="frow">
      <div><label>Reasoning effort <span class="hint">(managed by Studio harness)</span></label>
        <select id="f_reasoning">
          <option value="default">Default (Studio decides)</option>
          <option value="off">Off (no thinking)</option>
          <option value="minimal">Minimal</option><option value="low">Low</option>
          <option value="medium">Medium</option><option value="high">High</option>
          <option value="max">Max</option><option value="xhigh">X-High</option>
        </select></div>
      <div><label>Max tool calls <span class="hint">(0 = Studio decides)</span></label><input type="number" id="f_maxtools" min="0"></div>
    </div>
    <div><label>Tools (executed by the desktop harness, not in a sandbox)</label>
      <div class="checks" id="f_tools"></div>
      <label class="toggle" style="margin-top:6px"><input type="checkbox" id="f_runlocal" style="width:auto"> Run tools locally on this machine</label>
    </div>
    <div><label>RAG knowledge base</label>
      <label class="toggle" style="margin-bottom:4px"><input type="checkbox" id="f_rag" style="width:auto"> Enable RAG for this agent</label>
      <select id="f_kb"><option value="">(any / default knowledge base)</option></select>
    </div>
    <div><label>Memory cycle <span class="hint">(ReadMem before · StoreMem after each message)</span></label>
      <label class="toggle" style="margin-bottom:4px"><input type="checkbox" id="f_memcycle" style="width:auto"> Memory lookup + store around every message</label>
      <label class="toggle"><input type="checkbox" id="f_fastfirst" style="width:auto"> First reply to human: low reasoning + low context</label>
    </div>
  </div>
  <div class="dfoot">
    <button class="btn" id="edCancel">Cancel</button>
    <button class="btn pri" id="edSave">Save agent</button>
  </div>
</dialog>
<script src="ui/core.js"></script>
  <script src="ui/fleet_topology.js"></script>
<script src="ui/fleet_health.js"></script>

<script src="ui/uploads.js"></script>
</body>
</html>
