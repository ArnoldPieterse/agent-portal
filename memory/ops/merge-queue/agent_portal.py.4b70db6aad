#!/usr/bin/env python3
"""Multi-agent chat portal, backed by the Unsloth Studio desktop instance.

The portal is a thin web UI + proxy. Every LLM call goes to the local
Unsloth Studio /v1/chat/completions endpoint (the full harness: reasoning,
skills, RAG, tool execution). Nothing here loads models directly.
"""
import hashlib, json, mimetypes, os, re, shutil, subprocess, sys, threading, time, urllib.request, urllib.error, urllib.parse, uuid
from concurrent.futures import ThreadPoolExecutor, as_completed
import agent_queue as _aq   # 2026-11-17: starnet-style durable run queue + backpressure telemetry
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 8099
STUDIO = "http://127.0.0.1:8888"   # local Studio (White); remote hosts override per-agent


def studio_base(agent):
    """Per-agent Studio base URL (multi-host routing). Empty/missing = local Studio.
    A per-turn placement seat (thread-local, host-agnostic placement 2026-11-22) overrides
    when this turn runs on another host."""
    s = _seat_now()
    if s:
        return s["base"]
    return (agent or {}).get("studio") or STUDIO


def studio_headers(agent, extra=None):
    h = {"Content-Type": "application/json"}
    s = _seat_now()
    key = (s.get("key") or "") if s else ((agent or {}).get("api_key") or "")
    if key:
        h["Authorization"] = "Bearer " + key
    if extra:
        h.update(extra)
    return h


# ---- Model-load governance (2026-11-16, Orchestrator goal #2) -------------------
# The 2026-11-16 goal-setting round lost two seats (Orchestrator + Researcher) to
# UNLOADED models: LM Studio 404 "downloaded but not loaded" on every attempt, and the
# round looped on auto-resumes because a chair that can never answer can't conclude.
# Ground truth = a 1-token alias probe per agent's OWN studio base (the same path the
# portal uses for real requests; remote hosts override via agents.json 'studio').
MODEL_LOAD_BLOCK = False   # True = refuse to start a group run while any seat is down
_MODEL_LOAD_CACHE = {"ts": 0.0, "result": None}
# ---------------------------------------------------------------------------
# SEAT SELF-RECOVERY (2026-11-19) - escalation chain so down seats heal with
# NO human step (reboots approved 11-15, "accept and continue from human
# gates"): not_loaded -> native /api/inference/load; busy >30min -> wedged
# engine, unload+reload; host TCP down -> remote reboot via WinRM (boot tasks
# auto-load models); chain exhausted ~45min -> NEEDS-HUMAN line as LAST resort
# only. Load recipes mirror fleet_reload.py (per-host model_path + GPU/ctx).
# ---------------------------------------------------------------------------
_FLEET_RECOVER_RECIPES = {
    "Orchestrator": {"model_path": r"C:\Users\White\.lmstudio\models\lmstudio-community\Qwen3.8-27B-Q8_0",
                     "gguf_variant": "Q8_0", "gpu_ids": [1], "max_seq_length": 32768},
    "Researcher":   {"model_path": r"C:\Users\White\.lmstudio\models\unsloth\Qwen3.8-27B-Q4_K_S",
                     "gguf_variant": "UD-Q4_K_S", "gpu_ids": [0], "max_seq_length": 65536},
    "Builder":      {"model_path": r"C:\Users\black\.lmstudio\models\lmstudio-community\Qwen3.8-27B-Q8_0",
                     "gguf_variant": "Q8_0", "gpu_ids": [1], "max_seq_length": 32768},   # home = Black (2026-11-22)
    "Verifier":     {"model_path": r"C:\Users\black\.lmstudio\models\unsloth\Qwen3.8-27B-Q4_K_S",
                     "gguf_variant": "UD-Q4_K_S", "gpu_ids": [0], "max_seq_length": 65536},   # home = Black (2026-11-22, verifier-q4)
    "Scribe":       {"model_path": r"C:\Users\Red\models\Qwen3.8-27B-Q8_0",
                     "gguf_variant": "Q8_0", "gpu_ids": [1], "max_seq_length": 32768},
    "Mechanic":     {"model_path": r"C:\Users\Red\.cache\huggingface\hub\models--unsloth--Qwen3.8-27B-GGUF\snapshots\4ca720788d1e01f1bff70c033e0d0028fd02e502",
                     "gguf_variant": "UD-Q4_K_XL", "gpu_ids": [0], "max_seq_length": 65536},
    "Archivist":    {"model_path": r"C:\Users\pale\models\Qwen3.8-27B-Q8_0",
                     "gguf_variant": "Q8_0", "gpu_ids": [1], "max_seq_length": 32768},
    "Designer":     {"model_path": r"C:\Users\pale\models\Qwen3.8-27B-Q4_K_S",
                     "gguf_variant": "UD-Q4_K_S", "gpu_ids": [0], "max_seq_length": 65536},
}
_FLEET_REBOOT_USERS = {"IP_RED": "Red", "IP_PALE": "pale", "IP_BLACK": "black"}

def _agents_by_name():
    try:
        return {a.get("name"): a for a in json.load(open(os.path.join(HERE, "agents.json"), encoding="utf-8")).get("agents", [])}
    except Exception:
        return {}

def _studio_base(agent):
    return (agent.get("studio") or STUDIO).rstrip("/")

def _remote_host_ip(agent):
    import re as _re
    m = _re.search(r"//([\d.]+)", agent.get("studio") or "")
    return m.group(1) if m else None

def _host_alive(agent, timeout=3):
    ip = _remote_host_ip(agent)
    if not ip:
        return True   # local seat: the host is this machine
    import socket
    try:
        with socket.create_connection((ip, 8888), timeout=timeout):
            return True
    except Exception:
        return False

def _loaded_model_ids(agent, timeout=6):
    req = urllib.request.Request(_studio_base(agent) + "/api/inference/loaded-models")
    if agent.get("api_key"):
        req.add_header("Authorization", "Bearer " + agent["api_key"])
    with urllib.request.urlopen(req, timeout=timeout) as r:
        d = json.load(r)
    items = d if isinstance(d, list) else (d.get("data") or d.get("models") or [])
    return [m.get("id") for m in items if isinstance(m, dict) and m.get("id")]

def _seat_busy(agent):
    """True if the seat's model is RESIDENT (loaded) but not answering: fine
    while generating; unresponsive for 30+ min means a wedged engine.
    Alias seats match by canonical recipe id (agents.json holds aliases)."""
    rec = _FLEET_RECOVER_RECIPES.get(agent.get("name")) or {}
    mids = [x for x in (agent.get("model_id"), rec.get("id")) if x]
    # 2026-11-22 BUGFIX: recipes carry model_path, not 'id' - alias seats (archivist-q8)
    # never matched their resident canonical id (Qwen3.8-27B-Q8_0), so a WEDGED engine
    # (resident but unresponsive) was misread as 'not busy' and the unload+reload wedge
    # path never fired; plain reloads can't clear a stuck engine (Pale Q8, 19:30).
    mp = os.path.basename((rec.get("model_path") or "").replace("\\", "/"))
    if mp:
        mids.append(mp)
    try:
        ids = _loaded_model_ids(agent)
        return any(x in ids for x in mids)
    except Exception:
        return False

def _studio_recover(agent, reason):
    """Load - or unload+load - the seat's model via the NATIVE Studio API and
    poll until resident. Returns (ok, detail). Never touches a model that is
    mid-generation right now."""
    rec = _FLEET_RECOVER_RECIPES.get(agent.get("name"))
    if not rec:
        return False, "no load recipe for %s" % agent.get("name")
    base, key, mid = _studio_base(agent), agent.get("api_key"), agent.get("model_id")

    def call(method, path, body=None, timeout=60):
        h = {"Content-Type": "application/json"}
        if key:
            h["Authorization"] = "Bearer " + key
        data = json.dumps(body).encode() if body is not None else None
        try:
            with urllib.request.urlopen(urllib.request.Request(base + path, data=data, headers=h, method=method), timeout=timeout) as r:
                return r.status, r.read().decode("utf-8", "replace")[:300]
        except urllib.error.HTTPError as e:
            try:
                return e.code, e.read().decode("utf-8", "replace")[:200]
            except Exception:
                return e.code, str(e)[:100]
        except Exception as e:
            return 0, str(e)[:100]

    try:
        st, b = call("GET", "/api/inference/active-generations")
        if st == 200 and mid in b:
            return False, "model mid-generation - retry next tick"
    except Exception:
        pass
    # 'reload' must really UNLOAD+LOAD (2026-11-23): re-loading a resident model is a no-op
    # and cannot clear a wedged engine - Archivist/Pale stayed unreachable >1h on Lv 3 because
    # the streak>=8 branch passed reason='reload' while only 'wedged' unloaded. Tolerate an
    # unload failure (model may be absent) - the load below decides either way.
    if reason in ("wedged", "reload"):
        st, b = call("POST", "/api/inference/unload", {"model_path": rec["model_path"]})
        if reason == "wedged" and st not in (200, 201):
            return False, "unload -> %s %s" % (st, b[:80])
    body = dict(rec)
    body.update({"cache_type_kv": "q8_0", "n_parallel": 1, "tensor_parallel": False})
    st, b = call("POST", "/api/inference/load", body)
    # 409 active_generations (2026-11-22): the engine refuses a load while ANY chat is
    # generating - loading would stop that chat. A load must QUEUE behind in-flight work:
    # wait for generations to drain, then retry once. (Researcher's Q4 on White 409'd all
    # day: its home host was busy with other seats' turns at every retry instant.)
    if st == 409 and "active_generations" in b:
        drain = time.time() + 240
        while time.time() < drain:
            time.sleep(10)
            try:
                gst, gb = call("GET", "/api/inference/active-generations")
                if gst == 200:
                    g = json.loads(gb)
                    running = (g.get("running", len(g.get("thread_ids") or []))
                               if isinstance(g, dict) else len(g))
                    if not running:
                        break
            except Exception:
                pass
        st, b = call("POST", "/api/inference/load", body)
    if st not in (200, 201):
        return False, "load -> %s %s" % (st, b[:80])
    deadline = time.time() + 360   # async-ack: engine becomes resident later
    while time.time() < deadline:
        try:
            if mid in _loaded_model_ids(agent):
                return True, "resident"
        except Exception:
            pass
        try:   # alias seats: end-to-end probe (alias answers = truly recovered)
            req = urllib.request.Request(base.rstrip('/') + "/v1/chat/completions",
                                         data=json.dumps({"model": agent.get("model_id"),
                                                          "messages": [{"role": "user", "content": "."}],
                                                          "max_tokens": 1}).encode(),
                                         headers={"Content-Type": "application/json",
                                                  **({"Authorization": "Bearer " + key} if key else {})})
            with urllib.request.urlopen(req, timeout=30):
                return True, "alias answers"
        except Exception:
            pass
        time.sleep(15)
    return False, "load accepted but not resident after 6 min"

# ---- HOST-AGNOSTIC PLACEMENT (2026-11-22, user directive) ------------------------
# Agents are NOT pinned to hosts: if the agent's model is resident on any reachable host,
# the turn runs there (first available wins; home first). Working state is already
# host-independent (shared memory/ tree mirrored to every seat), so only the LLM call
# moves. Result: the whole fleet can operate from a single active host.
_SEAT_TL = threading.local()
_LOADED_IDS_CACHE = {}   # base -> (ts, [ids])


def _set_seat(seat):
    _SEAT_TL.seat = seat


def _seat_now():
    return getattr(_SEAT_TL, "seat", None)


def _fleet_bases():
    """Ordered unique remote (base, key) pairs from agents.json - the placement candidate set."""
    out = []
    try:
        for a in load_agents()["agents"]:
            b = (a.get("studio") or "").strip().rstrip("/")
            if b and all(b != x[0] for x in out):
                out.append((b, a.get("api_key") or ""))
    except Exception:
        pass
    return out


def _host_label(base):
    if not base or base.rstrip("/") == STUDIO.rstrip("/"):
        return "White (local)"
    m = re.search(r"//([\d.]+)", base)
    ip = m.group(1) if m else base
    return _FLEET_REBOOT_USERS.get(ip, ip)

_HOST_NAME_CACHE = None   # base -> friendly name (catalog _meta.hosts), cached for the process

def _fleet_host_names():
    """{base: friendly name} for every host in memory/llm/hotload-catalog.json (_meta.hosts:
    white/pale/black/red). The catalog is the source of truth for fleet membership, so hosts
    with no agents mapped (e.g. Black) still appear in the Fleet tab; bases the catalog
    doesn't know fall back to _host_label (WinRM user, else raw IP)."""
    global _HOST_NAME_CACHE
    if _HOST_NAME_CACHE is not None:
        return _HOST_NAME_CACHE
    names = {}
    try:
        cat = json.load(open(os.path.join(HERE, "memory", "llm", "hotload-catalog.json"), encoding="utf-8"))
        for hn, hv in (cat.get("_meta") or {}).get("hosts", {}).items():
            api = str(hv.get("api") or "").strip().rstrip("/")
            if api:
                names[api] = str(hn).capitalize()
    except Exception:
        pass
    _HOST_NAME_CACHE = names
    return names

def _friendly_host_name(base):
    """Display name for a Studio base: catalog host name, else WinRM user, else raw IP."""
    if not base or base.rstrip("/") == STUDIO.rstrip("/"):
        return "White (local)"
    return _fleet_host_names().get(base.rstrip("/")) or _host_label(base)

def _fleet_host_key(base):
    """Studio API key for a fleet base that no agents.json seat carries (e.g. Black).
    Without it the probe 401s and the host falsely shows 'unreachable' even though its
    Studio is up (2026-11-22). Keys live in host_api.py per the chat-only convention
    (never in memory files); the catalog host name maps to its load_key() argument."""
    hn = _fleet_host_names().get((base or "").rstrip("/"))
    if not hn:
        return ""
    try:
        import host_api
        return host_api.load_key(hn.upper()) or ""
    except Exception:
        return ""


def _base_alive(base, timeout=3):
    if not base or base.rstrip("/") == STUDIO.rstrip("/"):
        return True
    import socket
    m = re.search(r"//([\d.]+)", base)
    if not m:
        return False
    try:
        with socket.create_connection((m.group(1), 8888), timeout=timeout):
            return True
    except Exception:
        return False


def _loaded_ids_cached(base, key=""):
    now = time.time()
    hit = _LOADED_IDS_CACHE.get(base)
    if hit and now - hit[0] < 60:
        return hit[1]
    req = urllib.request.Request(base + "/api/inference/loaded-models")
    if key:
        req.add_header("Authorization", "Bearer " + key)
    with urllib.request.urlopen(req, timeout=8) as r:
        d = json.load(r)
    items = d if isinstance(d, list) else (d.get("data") or d.get("models") or [])
    ids = [x.get("id") for x in items if isinstance(x, dict) and x.get("id")]
    _LOADED_IDS_CACHE[base] = (now, ids)
    return ids


def _quant_family(variant):
    v = (variant or "").upper()
    if "Q8" in v:
        return "q8"
    if "Q4" in v:
        return "q4"
    return ""


# ---- LIVE PLACEMENT TRACKING (2026-11-22) -------------------------------------------
# "Which agents actually RAN where" - the Fleet tab shows this instead of the static
# agents.json home mapping, because placement is host-agnostic (first available host).
# In-memory only; a portal restart simply starts a fresh 10-minute window.
_ACTIVE_SEATS = {}        # base -> {agent name: last-run ts}
_ACTIVE_LOCK = threading.Lock()
ACTIVE_TTL_S = 600        # "active on this host" = ran here within the last 10 minutes

def _record_active(agent, base):
    try:
        with _ACTIVE_LOCK:
            _ACTIVE_SEATS.setdefault((base or "").rstrip("/"), {})[agent.get("name", "?")] = time.time()
    except Exception:
        pass

def _active_agents(base, ttl=ACTIVE_TTL_S):
    now = time.time()
    with _ACTIVE_LOCK:
        d = dict(_ACTIVE_SEATS.get((base or "").rstrip("/"), {}))
    return sorted(n for n, ts in d.items() if now - ts < ttl)

def _resolve_seat(agent):
    """Find a host where the agent's model is ALREADY resident (no loading). Home first,
    then local White, then other hosts in agents.json order (first available wins), then
    catalog-only hosts like Black (2026-11-22: it carries resident models but no
    agents.json seat maps it - appended LAST so existing preferences are unchanged).
    Returns {base, host, model, key[, fallback]} or None (caller falls back to the home
    hot-load path). On home the returned model is the agent's own alias id (behavior
    unchanged); on a foreign host it is the loaded-models id of the resident model. A
    quant-family fallback (q8<->q4) is offered ONLY when the home host itself is
    unreachable."""
    name = agent.get("name", "?")
    rec = _FLEET_RECOVER_RECIPES.get(name) or {}
    want = os.path.basename((rec.get("model_path") or "").replace("\\", "/"))
    gv = (rec.get("gguf_variant") or "").lower()
    home = _studio_base(agent)
    cands = [(home, "home")]
    # the local host is ALWAYS a candidate (it is not in agents.json 'studio' fields) and
    # sits right after home: White holds the Q8+Q4 pair and the canonical shared tree.
    if home.rstrip("/") != STUDIO.rstrip("/"):
        cands.append((STUDIO, _host_label(STUDIO)))
    for b, k in _fleet_bases():
        if b != home and b.rstrip("/") != STUDIO.rstrip("/"):
            cands.append((b, _host_label(b)))
    keys = {b: k for b, k in _fleet_bases()}
    keys.setdefault(STUDIO.rstrip("/"), "")
    # Catalog-only hosts (e.g. Black .99): resident models can serve overflow turns even
    # though no agents.json seat points at them. Appended after the mapped remotes.
    for cb in _fleet_host_names():
        if cb != home and cb.rstrip("/") != STUDIO.rstrip("/") and all(cb != c[0] for c in cands):
            cands.append((cb, _friendly_host_name(cb)))
            keys.setdefault(cb, _fleet_host_key(cb))
    home_reachable = True
    for i, (base, label) in enumerate(cands):
        if i == 0 and not _base_alive(base):
            home_reachable = False
            continue
        try:
            ids = _loaded_ids_cached(base, keys.get(base))
        except Exception:
            continue
        hit = None
        for x in ids:
            if want and (x == want or (gv and gv in (x or "").lower())):
                hit = x
                break
        if hit:
            return {"base": base, "host": label,
                    "model": agent.get("model_id") if i == 0 else hit,
                    "key": (agent.get("api_key") or "") if i == 0 else keys.get(base, "")}
    if not home_reachable:
        fam = _quant_family(rec.get("gguf_variant"))
        for i, (base, label) in enumerate(cands):
            if i == 0:
                continue
            try:
                ids = _loaded_ids_cached(base, keys.get(base))
            except Exception:
                continue
            for x in ids:
                if fam and fam in (x or "").lower():
                    return {"base": base, "host": label, "model": x,
                            "key": keys.get(base, ""), "fallback": True}
    return None


# ---- LOAD QUEUE (2026-11-22, user directive: "loads should be queued when only a few are
# available") - model loads are serialized PER HOST (one at a time). With only a few hosts /
# VRAM slots up, concurrent load attempts 409-thrash the Studios. Turn-start hot-loads and
# the autoloop recovery chain both go through this queue; while waiting we re-check residency
# so a shared/earlier load releases us WITHOUT a second load (dedup). Bounded wait + bounded
# per-host depth: when the queue is deep, new loads defer honestly (retry next tick) instead
# of piling up. Different hosts load in parallel.
_HOST_LOAD_SEMS = {}      # host base -> Semaphore(1): one model load at a time per host
_HOST_LOAD_WAITERS = {}   # host base -> current waiters (for honest "N ahead" messages)
_HOST_LOAD_ACTIVE = {}    # host base key -> {agent, model, since} of the in-flight load (Fleet tab)
_LOADQ_LOCK = threading.Lock()
LOADQ_WAIT_S = 150        # max seconds a TURN waits its turn in the load queue
LOADQ_MAX_WAITERS = 4     # per-host depth cap: beyond this, new loads defer honestly


def _host_load_sem(base):
    k = (base or "").rstrip("/")
    with _LOADQ_LOCK:
        s = _HOST_LOAD_SEMS.get(k)
        if s is None:
            s = threading.Semaphore(1)
            _HOST_LOAD_SEMS[k] = s
            _HOST_LOAD_WAITERS.setdefault(k, 0)
        return k, s


def _queued_model_load(agent, reason="load", wait_s=LOADQ_WAIT_S, wfile=None):
    """Run a model load (or unload+load for wedged/reload) through the per-host load queue.
    Returns (ok, detail). While queued we re-check residency every 15s: if another load made
    the model resident meanwhile, we release without loading again."""
    name = agent.get("name", "?")
    rec = _FLEET_RECOVER_RECIPES.get(name)
    if not rec:
        return False, "no load recipe for %s" % name
    base = _studio_base(agent)
    k, sem = _host_load_sem(base)
    with _LOADQ_LOCK:
        ahead = _HOST_LOAD_WAITERS.get(k, 0)
        if ahead >= LOADQ_MAX_WAITERS:
            return False, "load queue deep on %s (%d waiting) - deferred, retry shortly (auto)" % (_host_label(base), ahead)
        _HOST_LOAD_WAITERS[k] = ahead + 1

    def emit(note):
        if wfile is None:
            return
        try:
            wfile.write(b"data: " + json.dumps({"model_load": note}).encode() + b"\n\n")
            wfile.flush()
        except Exception:
            pass

    got = False
    deadline = time.time() + wait_s
    last_note = 0.0
    try:
        while True:
            if reason == "load" and _model_resident(agent, rec):
                return True, "resident (caught shared load)"
            got = sem.acquire(timeout=15)
            if got:
                # re-check AFTER acquiring: the load we queued behind may have finished while
                # we waited - take the seat without a second (double) load
                if reason == "load" and _model_resident(agent, rec):
                    return True, "resident (caught shared load)"
                with _LOADQ_LOCK:
                    _HOST_LOAD_ACTIVE[k] = {"agent": name,
                                            "model": rec.get("gguf_variant") or os.path.basename((rec.get("model_path") or "").replace("\\", "/")) or "?",
                                            "since": time.time()}
                break
            if time.time() >= deadline:
                with _LOADQ_LOCK:
                    n = max(0, _HOST_LOAD_WAITERS.get(k, 0) - 1)
                return False, "load queue busy on %s (%d ahead) - deferred, retry shortly (auto)" % (_host_label(base), n)
            if time.time() - last_note >= 30:
                last_note = time.time()
                emit("%s: queued for model load on %s (one load at a time per host)" % (name, _host_label(base)))
        ok, detail = _studio_recover(agent, reason)
        return ok, detail
    finally:
        with _LOADQ_LOCK:
            _HOST_LOAD_WAITERS[k] = max(0, _HOST_LOAD_WAITERS.get(k, 0) - 1)
            if got:
                _HOST_LOAD_ACTIVE.pop(k, None)
        if got:
            sem.release()


def _winrm_reboot(ip):
    """Remote reboot via WinRM (empty-password creds per hosts.md; approved
    11-15). The host's boot tasks auto-load its models after restart."""
    user = _FLEET_REBOOT_USERS.get(ip)
    if not user:
        return False, "no reboot target for %s" % ip
    ps_script = ("$cred = New-Object PSCredential('%s', (New-Object System.Security.SecureString))\n"
                 "Invoke-Command -ComputerName '%s' -Credential $cred -UseSSL:$false -ScriptBlock { Restart-Computer -Force }") % (user, ip)
    import subprocess as _sp
    try:
        pr = _sp.run(["powershell", "-NoProfile", "-Command", ps_script], capture_output=True, text=True, timeout=90)
        return (pr.returncode == 0), ((pr.stdout or "") + (pr.stderr or ""))[:120].strip()
    except Exception as e:
        return False, str(e)[:100]

def _recover_seat_async(name, agent, reason):
    def work():
        try:
            # through the per-host load queue: never double-load a host that is mid-load
            ok, detail = _queued_model_load(agent, reason, wait_s=300)
            print("[autoloop] recover %s (%s): %s - %s" % (name, reason, "OK" if ok else "FAIL", detail))
        except Exception as e:
            print("[autoloop] recover %s crashed: %s" % (name, str(e)[:80]))
    threading.Thread(target=work, daemon=True).start()


def _model_resident(agent, rec=None):
    """True if the agent's model is resident on its home Studio. loaded-models reports MODEL
    NAMES while alias seats carry ALIAS ids in agents.json (atlas-q8 vs Qwen3.8-27B-Q8_0), so
    match by model_id OR recipe model_path basename / gguf_variant."""
    mid = agent.get("model_id") or ""
    if rec is None:
        rec = _FLEET_RECOVER_RECIPES.get(agent.get("name", "?")) or {}
    try:
        ids = _loaded_model_ids(agent)
    except Exception:
        return False
    mp = os.path.basename((rec.get("model_path") or "").replace("\\", "/"))
    gv = (rec.get("gguf_variant") or "").lower()
    return any((mid and i == mid) or (mp and i == mp) or (gv and gv in (i or "").lower())
               for i in ids)


def _ensure_seat_ready(agent, wfile=None):
    """HOT LOAD ON DEMAND (P1, 2026-11-22): a called agent whose model is not resident gets
    hot-loaded NOW instead of erroring - the seat recovers inline with SSE progress frames
    ({"model_load": ...}), no human step. Called at the top of every stream_chat turn.
    Returns (ready, note). Never raises: on any internal failure it returns (True, "") and
    lets the normal upstream retry logic handle things as before."""
    name = agent.get("name", "?")
    mid = agent.get("model_id") or ""

    def emit(note):
        if wfile is None:
            return
        try:
            wfile.write(b"data: " + json.dumps({"model_load": note}).encode() + b"\n\n")
            wfile.flush()
        except Exception:
            pass

    try:
        # fast path 1: recent fleet cache says ok (60 s cache / 15 min per-seat trust)
        if _model_load_status().get(name, {}).get("status") == "ok":
            return True, ""
        # fast path 2: precise resident check on the seat's own Studio.
        if _model_resident(agent):
            return True, ""
        # host down -> remote reboot (boot tasks reload its models); fail this turn honestly
        ip = _remote_host_ip(agent)
        if ip and not _host_alive(agent):
            emit("%s: host %s is down - remote reboot initiated; model auto-loads on boot" % (name, ip))
            try:
                threading.Thread(target=_winrm_reboot, args=(ip,), daemon=True).start()
            except Exception:
                pass
            return False, "host %s down - reboot initiated (auto); retry in a few minutes" % ip
        if not _FLEET_RECOVER_RECIPES.get(name):
            return False, "no load recipe for %s" % name
        # hot-load via the seat recipe: native /api/inference/load + poll until resident
        emit("%s: model not resident - hot-loading now (queued per host; can take a few minutes)" % name)
        ok, detail = _queued_model_load(agent, "load", wfile=wfile)
        if ok:
            emit("%s: model resident - continuing" % name)
            return True, ""
        # 409 active_generations: something is generating on this Studio right now - it may be
        # OUR model mid-turn (alias mismatch hid it from the checks above). One last end-to-end
        # probe decides; if it answers, the seat is ready.
        if "active_generations" in detail or "409" in detail:
            try:
                req = urllib.request.Request(_studio_base(agent).rstrip("/") + "/v1/chat/completions",
                                             data=json.dumps({"model": mid,
                                                              "messages": [{"role": "user", "content": "."}],
                                                              "max_tokens": 1}).encode(),
                                             headers={"Content-Type": "application/json",
                                                       **({"Authorization": "Bearer " + agent["api_key"]}
                                                          if agent.get("api_key") else {})})
                with urllib.request.urlopen(req, timeout=90):
                    emit("%s: model resident (was mid-generation) - continuing" % name)
                    return True, ""
            except Exception:
                pass
        return False, "hot-load failed: %s" % detail
    except Exception as e:
        return True, ""   # never block a turn that could otherwise run




def _model_load_status(force=False, timeout=15):
    """Probe every agent's model alias (max_tokens=1) in parallel. Returns
    {agent: {status: ok|not_loaded|unreachable, ms: int[, detail]}}. Cached 60s so the
    run-start check and GET /api/models/status don't double-probe."""
    import urllib.request as _ur
    now = time.time()
    if not force and _MODEL_LOAD_CACHE["result"] and now - _MODEL_LOAD_CACHE["ts"] < 60:
        return _MODEL_LOAD_CACHE["result"]
    # Per-seat trust window (2026-11-17): a seat that answered OK within the last 15
    # min is reused without re-ping. Re-probing every ~60s queues behind model loads
    # on shared-VRAM Studios, so seats flapped in/out of the autoloop cast (2/8 seen)
    # while GPUs thrashed. Failed seats are still probed every tick.
    _per = _MODEL_LOAD_CACHE.get("per_seat") or {}
    trust = {n: s for n, s in _per.items()
             if not force and s["status"] == "ok" and now - s["ts"] < 900}
    out = dict(trust)

    def _probe(name, model, base, headers):
        body = json.dumps({"model": model,
                           "messages": [{"role": "user", "content": "ping"}],
                           "max_tokens": 1, "stream": False}).encode()
        req = _ur.Request(base.rstrip('/') + "/v1/chat/completions", data=body, headers=headers)
        t0 = time.time()
        try:
            _ur.urlopen(req, timeout=timeout)
            out[name] = {"status": "ok", "ms": int(1000 * (time.time() - t0))}
        except Exception as e:
            msg = str(e)
            if "404" in msg or "not loaded" in msg:
                out[name] = {"status": "not_loaded", "ms": int(1000 * (time.time() - t0)), "detail": msg[:120]}
            else:
                out[name] = {"status": "unreachable", "ms": int(1000 * (time.time() - t0)), "detail": msg[:120]}

    try:
        agents = load_agents()["agents"]
    except Exception:
        agents = []
    threads = [threading.Thread(target=_probe, args=(a.get("name", "?"),
                                                     a.get("model_id") or "?",
                                                     studio_base(a), studio_headers(a)), daemon=True)
               for a in agents if a.get("name", "?") not in trust]
    for t_ in threads:
        t_.start()
    for t_ in threads:
        t_.join(timeout=timeout + 5)
    _probed = {n: {"ts": now, "status": s["status"]} for n, s in out.items() if n not in trust}
    _per2 = dict(_per); _per2.update(_probed)
    _MODEL_LOAD_CACHE.update(ts=now, result=out, per_seat=_per2)
    return out


_ELEVATED_CACHE = {'v': None}


def _shell_elevated():
    """True if this process runs elevated (all agent terminal tools inherit it). Cached."""
    if _ELEVATED_CACHE['v'] is None:
        try:
            import ctypes
            _ELEVATED_CACHE['v'] = bool(ctypes.windll.shell32.IsUserAnAdmin())
        except Exception:
            _ELEVATED_CACHE['v'] = False
    return _ELEVATED_CACHE['v']


def rag_base(agent):
    """RAG search host. Per-agent `rag_studio` override for remote agents whose
    knowledge base lives on White (local Studio holds rag.db); empty = chat host."""
    return (agent or {}).get("rag_studio") or studio_base(agent)


def rag_headers(agent, extra=None):
    """Headers for RAG calls. `rag_api_key` overrides; the agent's own key applies
    only when RAG runs on the chat host (no rag_studio override)."""
    h = {"Content-Type": "application/json"}
    a = agent or {}
    key = a.get("rag_api_key") or ""
    if not key and not a.get("rag_studio"):
        key = a.get("api_key") or ""
    if key:
        h["Authorization"] = "Bearer " + key
    if extra:
        h.update(extra)
    return h
HERE = os.path.dirname(os.path.abspath(__file__))
AGENTS_FILE = os.path.join(HERE, "agents.json")
MEMORY_FILE = os.path.join(HERE, "memory.md")   # HOT shared file (state line + counter + hot notes)
MEMORY_DIR = os.path.join(HERE, "memory")      # modular memory tree: INDEX.md pointer map + topic modules
# 2026-11-15: human message queue + per-mode chat history + run state (refresh-safe portal).
# LOCAL-ONLY runtime state - the .gitignore allowlist keeps these out of the public repo.
USER_MSGS_FILE = os.path.join(HERE, "user_messages.json")      # ts + text + per-agent checked booleans
CHAT_HISTORY_FILES = {"group": os.path.join(HERE, "chat_history_group.json"),
                      "solo": os.path.join(HERE, "chat_history_solo.json")}
RUN_STATE_FILE = os.path.join(HERE, "run_state.json")
UMQ_MAX = 200           # queue cap (oldest entries drop first)
HIST_MAX = 200          # persisted history cap per mode
# 2026-11-11: agent tool calls execute in Studio's shared sandbox, NOT in HERE. Portal API requests
# pass no session_id (spec: session_id scopes the "tool execution sandbox"), so everything lands in
# the "_default" sandbox - that is where agents' built files actually live and must be servable from.
def _find_sandbox_dir():
    """The ~-based path breaks when the portal is launched from a shell whose USERPROFILE points
    elsewhere (2026-11-11: tool shell had USERPROFILE=C:\Projects\Workspace -> sandbox refs 404'd).
    Fall back to scanning the real user profiles for Studio's _default sandbox."""
    d = os.path.expanduser(os.path.join("~", ".unsloth", "studio", "sandbox", "_default"))
    if os.path.isdir(d):
        return d
    users = os.path.join(os.environ.get("SystemDrive", "C:") + "\\", "Users")
    if os.path.isdir(users):
        for u in sorted(os.listdir(users)):
            cand = os.path.join(users, u, ".unsloth", "studio", "sandbox", "_default")
            if os.path.isdir(cand):
                return cand
    return d

SANDBOX_DIR = _find_sandbox_dir()
UPLOAD_DIR = os.path.join(SANDBOX_DIR, "uploads")   # human uploads land in the shared agent folder
MAX_UPLOAD_BYTES = 4 * 1024 * 1024 * 1024            # 4 GB per file (streamed to disk, never buffered)

# ---------------------------------------------------------------- workspace <-> sandbox sync (two-way)
# Agent tools run in Studio's shared _default sandbox (SANDBOX_DIR), not HERE. Shared project
# state must exist THERE so agents can read it with their own python/terminal tools (2026-11-13:
# mount asymmetry). r29 (2026-11-13): the mirror is now TWO-WAY so agent work lands in HERE (and
# therefore in git) instead of being clobbered by the next push:
#   * Root docs - TODO.md, MEMORY.md: PUSH-ONLY from HERE. OPS r5 (2026-11-13): an LWW pull of
#     these let a stale whole-file rewrite in any seat (fresh mtime) clobber canonical at the next
#     turn boundary - the only remaining writer path after the SMB mirror was exonerated.
#   * memory/ leaves: last-writer-wins BOTH directions (mtime decides; 0.5 s tolerance).
#   * Code/config - the rest of the git-tracked allowlist: PUSH-ONLY from HERE (merge-queue rule:
#     sandbox edits to code are experiments until merged via upgrade-plan.md).
#   * Everything else in the sandbox: NEW-ONLY pull - a file absent from HERE is copied home,
#     an existing workspace file is NEVER overwritten. Junk exclusions keep agent experiments
#     (mingit copies, project clones, uploads) out of the workspace.
# mtime-guarded (copy2 preserves mtime -> steady state touches nothing); every error swallowed -
# a sync hiccup must never break chat.
SYNC_LWW = ["TODO.md", "MEMORY.md"]   # root docs: LWW push only (OPS r5); memory/ leaves stay LWW both ways
PUSH_FALLBACK_ALLOWLIST = ["TODO.md", "MEMORY.md", "agents.json", "agent_portal.py", "index.html"]
PULL_EXCLUDE_DIRS = {"mingit", "uploads", "__pycache__", ".unsloth_sandbox", "node_modules",
                     "agentportal_v1-git", "_boot2", "_bootstrap_test", "gapfix-test"}
PULL_EXCLUDE_FILES = {"mingit.zip"}
PULL_MAX_BYTES = 20 * 1024 * 1024     # size guard for new-only pulls


def _git_allowlist():
    """The git-tracked file set (curated .gitignore allowlist, ~43 files). Fallback list when
    the repo is missing so sync degrades gracefully."""
    try:
        import subprocess
        # 2026-11-15: portal runs under pythonw - CREATE_NO_WINDOW keeps child git consoles invisible (popup complaint)
        r = subprocess.run([GIT_EXE, "ls-files"], cwd=HERE, capture_output=True, text=True, timeout=15,
                           creationflags=0x08000000)
        out = [l.strip().replace("\\", "/") for l in (r.stdout or "").splitlines() if l.strip()]
        if out:
            return out
    except Exception:
        pass
    return list(PUSH_FALLBACK_ALLOWLIST)


def _same_file(a, b):
    """r16 structural fix (Builder 2026-11-13): byte-identical check (size + md5).
    Lets the sync no-op on identical content regardless of mtime noise - foreign-stamped
    copies, CRLF/LF rewrites, backup restores - so steady state touches nothing and the
    destination mtime is preserved. Any read error -> False (fall back to mtime LWW)."""
    try:
        sa, sb = os.stat(a), os.stat(b)
        if sa.st_size != sb.st_size:
            return False
        ha = hashlib.md5(open(a, 'rb').read()).hexdigest()
        hb = hashlib.md5(open(b, 'rb').read()).hexdigest()
        return ha == hb
    except OSError:
        return False


def _sync_workspace_to_sandbox():
    """Two-way sync HERE <-> SANDBOX_DIR (semantics in the header above).
    Returns (pushed, pulled) relative-path lists; both empty in steady state."""
    pushed, pulled = [], []
    try:
        if not os.path.isdir(SANDBOX_DIR):
            return pushed, pulled
        _merge_queue_scan()   # 2026-11-16: capture diverged push-only files BEFORE the push can clobber them
        # 1) LWW push: TODO.md / MEMORY.md + the whole memory/ tree (HERE wins only when newer)
        jobs = []
        for rel in SYNC_LWW:
            sp = os.path.join(HERE, rel)
            if os.path.isfile(sp):
                jobs.append((sp, os.path.join(SANDBOX_DIR, rel)))
        if os.path.isdir(MEMORY_DIR):
            for root, dirs, files in os.walk(MEMORY_DIR):
                dirs[:] = [d for d in dirs if not d.startswith(".")]
                for f in files:
                    if f.startswith("."):
                        continue
                    sp = os.path.join(root, f)
                    jobs.append((sp, os.path.join(SANDBOX_DIR, "memory", os.path.relpath(sp, MEMORY_DIR))))
        for src, dst in jobs:
            try:
                ss = os.stat(src)
                ds = os.stat(dst) if os.path.exists(dst) else None
                if ds is not None and _same_file(src, dst):
                    continue   # r16 structural fix: byte-identical -> no-op, preserve mtime
                if ds is None or ss.st_mtime > ds.st_mtime + 0.5:
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    shutil.copy2(src, dst)
                    pushed.append(os.path.relpath(src, HERE).replace(os.sep, "/"))
            except OSError:
                pass
        # 2) Push-only code/config: rest of the git allowlist (never pulled back - merge queue)
        for rel in _git_allowlist():
            if rel in SYNC_LWW or rel.startswith("memory/") or rel == ".gitignore":
                continue
            src = os.path.join(HERE, rel.replace("/", os.sep))
            dst = os.path.join(SANDBOX_DIR, rel.replace("/", os.sep))
            if not os.path.isfile(src):
                continue
            try:
                ss = os.stat(src)
                ds = os.stat(dst) if os.path.exists(dst) else None
                if ds is not None and _same_file(src, dst):
                    continue   # r16 structural fix: byte-identical -> no-op, preserve mtime
                if ds is None or ss.st_mtime > ds.st_mtime + 0.5:
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    shutil.copy2(src, dst)
                    pushed.append(rel)
            except OSError:
                pass
        # 3) Pull back to HERE: memory/ leaves ONLY. OPS r5 (2026-11-13): TODO.md / MEMORY.md are
        # PUSH-ONLY - a stale whole-file rewrite in any seat gets a fresh mtime and an LWW pull
        # would clobber canonical at the next turn boundary. memory/ leaves stay LWW (agent work).
        sb_mem = os.path.join(SANDBOX_DIR, "memory")
        if os.path.isdir(sb_mem):
            for root, dirs, files in os.walk(sb_mem):
                dirs[:] = [d for d in dirs if not d.startswith(".")]
                for f in files:
                    if f.startswith("."):
                        continue
                    sp = os.path.join(root, f)
                    rel = "memory/" + os.path.relpath(sp, sb_mem).replace(os.sep, "/")
                    dst = os.path.join(HERE, rel.replace("/", os.sep))
                    try:
                        ss = os.stat(sp)
                        ds = os.stat(dst) if os.path.exists(dst) else None
                        if ds is not None and _same_file(sp, dst):
                            continue   # r16 structural fix: byte-identical -> no-op, preserve mtime
                        if ds is None or ss.st_mtime > ds.st_mtime + 0.5:
                            os.makedirs(os.path.dirname(dst), exist_ok=True)
                            shutil.copy2(sp, dst)
                            pulled.append(rel)
                    except OSError:
                        pass
        # 4) New-only pull: any other sandbox file absent from HERE comes home (junk excluded)
        for root, dirs, files in os.walk(SANDBOX_DIR):
            relroot = os.path.relpath(root, SANDBOX_DIR).replace(os.sep, "/")
            dirs[:] = [d for d in dirs if not d.startswith(".") and d.lower() not in PULL_EXCLUDE_DIRS]
            for f in files:
                if f.startswith(".") or f.lower() in PULL_EXCLUDE_FILES:
                    continue
                sp = os.path.join(root, f)
                rel = (relroot + "/" + f) if relroot != "." else f
                dst = os.path.join(HERE, rel.replace("/", os.sep))
                try:
                    if os.path.exists(dst):
                        continue   # NEW-ONLY: never overwrite an existing workspace file
                    if os.path.getsize(sp) > PULL_MAX_BYTES:
                        continue
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    shutil.copy2(sp, dst)
                    pulled.append(rel)
                except OSError:
                    pass
    except Exception:
        pass
    return pushed, pulled


def _auto_commit():
    """Post-turn drift guard (Builder goal #5, 2026-11-13): commit whatever the two-way sync just
    moved so repo lag stays <= 1 turn. No-op when the tree is clean; errors swallowed."""
    try:
        if not os.path.isdir(os.path.join(HERE, ".git")):
            return None
        st = _git(["status", "--porcelain"])
        if not st["ok"] or not st["out"].strip():
            return None
        _git(["add", "-A"])
        c = _git(["commit", "-m", "auto: post-turn sync %s" % time.strftime("%Y-%m-%d %H:%M:%S")])
        if c["ok"] and "nothing to commit" not in (c["out"] + c["err"]).lower():
            head = _git(["log", "--oneline", "-1"])
            if head["ok"]:
                return head["out"].split(" ", 1)[0]
    except Exception:
        pass
    return None

MERGE_QUEUE_DIR = os.path.join(HERE, "memory", "ops", "merge-queue")
MERGE_QUEUE_LOG = os.path.join(HERE, "memory", "ops", "merge-queue.jsonl")


def _merge_queue_scan():
    """2026-11-16 (goal-stall fix): snapshot diverged push-only files BEFORE the sync can clobber them.
    Agent tools run in the sandbox; their edits to code/config files never pull back (push-only rule),
    so the next HERE->sandbox push silently destroys work that was never committed anywhere. Each new
    divergence is captured once per content hash: a snapshot under memory/ops/merge-queue/ plus a jsonl
    event - both inside memory/, so _auto_commit preserves them and POST /api/merge can restore."""
    events = []
    try:
        if not os.path.isdir(SANDBOX_DIR):
            return events
        allow = [r for r in _git_allowlist()
                 if not r.startswith("memory/") and r != ".gitignore" and r not in SYNC_LWW]
        for rel in sorted(allow):
            sp = os.path.join(SANDBOX_DIR, rel.replace("/", os.sep))
            hp = os.path.join(HERE, rel.replace("/", os.sep))
            if not (os.path.isfile(sp) and os.path.isfile(hp)) or _same_file(sp, hp):
                continue
            try:
                sha = hashlib.sha256(open(sp, "rb").read()).hexdigest()[:10]
                size = os.path.getsize(sp)
            except OSError:
                continue
            snap_name = rel.replace(os.sep, "__") + "." + sha
            snap_rel = "memory/ops/merge-queue/" + snap_name
            if not os.path.exists(os.path.join(HERE, snap_rel)):
                try:
                    os.makedirs(MERGE_QUEUE_DIR, exist_ok=True)
                    shutil.copy2(sp, os.path.join(HERE, snap_rel))
                except OSError:
                    snap_rel = None
            ev = {"ts": time.strftime("%Y-%m-%d %H:%M:%S"), "file": rel, "sha": sha,
                  "size": size, "snapshot": snap_rel}
            dup = False   # log each file+content once (the scan runs every sync)
            try:
                if os.path.isfile(MERGE_QUEUE_LOG):
                    tail = open(MERGE_QUEUE_LOG, encoding="utf-8", errors="replace").readlines()[-80:]
                    for l in tail:
                        try:
                            d = json.loads(l)
                        except Exception:
                            continue
                        if d.get("file") == rel and d.get("sha") == sha:
                            dup = True
                            break
            except OSError:
                pass
            if not dup:
                try:
                    os.makedirs(os.path.dirname(MERGE_QUEUE_LOG), exist_ok=True)
                    with open(MERGE_QUEUE_LOG, "a", encoding="utf-8") as f:
                        f.write(json.dumps(ev) + "\n")
                    events.append(ev)
                except OSError:
                    pass
    except Exception:
        pass
    try:
        _merge_queue_prune()
    except Exception:
        pass
    return events


def _merge_queue_prune(keep=10):
    """2026-11-23 (tree bloat): keep only the newest `keep` snapshots per base file.
    Snapshots are auto-committed to git, so pruned versions stay recoverable via
    history; /api/merge restore uses the newest snapshot of a base, which survives.
    Called at the end of every _merge_queue_scan so the queue self-maintains."""
    try:
        if not os.path.isdir(MERGE_QUEUE_DIR):
            return 0
        groups = {}
        for fn in os.listdir(MERGE_QUEUE_DIR):
            p = os.path.join(MERGE_QUEUE_DIR, fn)
            base, dot, sha = fn.rpartition(".")
            if not dot or len(sha) != 10:
                continue
            try:
                mt = os.path.getmtime(p)
            except OSError:
                mt = 0.0
            groups.setdefault(base, []).append((mt, fn))
        removed = 0
        for base, lst in groups.items():
            lst.sort(reverse=True)
            for _mt, fn in lst[keep:]:
                try:
                    os.remove(os.path.join(MERGE_QUEUE_DIR, fn))
                    removed += 1
                except OSError:
                    pass
        return removed
    except Exception:
        return 0


def _merge_queue_status():
    """GET /api/merge-queue: recent divergence events (newest first) + snapshot inventory."""
    out = {"ok": True, "events": [], "snapshots": []}
    try:
        if os.path.isfile(MERGE_QUEUE_LOG):
            lines = [l for l in open(MERGE_QUEUE_LOG, encoding="utf-8", errors="replace").readlines() if l.strip()]
            evs = []
            for l in lines[-40:]:
                try:
                    evs.append(json.loads(l))
                except Exception:
                    pass
            out["events"] = list(reversed(evs))
        if os.path.isdir(MERGE_QUEUE_DIR):
            out["snapshots"] = sorted(os.listdir(MERGE_QUEUE_DIR))[-40:]
    except Exception as e:
        out["ok"] = False
        out["error"] = str(e)[:200]
    return out


def _restore_merge_queue(body):
    """POST /api/merge {file, sha?}: restore a captured sandbox snapshot onto the root + commit.
    Only git-allowlisted files are restorable; latest snapshot for that file wins unless sha given."""
    rel = str((body or {}).get("file") or "").strip().replace("\\", "/")
    want_sha = str((body or {}).get("sha") or "").strip()[:10]
    if rel not in set(_git_allowlist()):
        return {"ok": False, "error": "file not in git allowlist: %s" % rel}
    prefix = rel.replace(os.sep, "__") + "."
    cands = []
    if os.path.isdir(MERGE_QUEUE_DIR):
        for fn in sorted(os.listdir(MERGE_QUEUE_DIR)):
            if fn.startswith(prefix) and (not want_sha or fn.endswith("." + want_sha)):
                cands.append(fn)
    if not cands:
        return {"ok": False, "error": "no snapshot for %s%s" % (rel, (" sha " + want_sha) if want_sha else "")}
    src = os.path.join(MERGE_QUEUE_DIR, cands[-1])
    dst = os.path.join(HERE, rel.replace("/", os.sep))
    try:
        shutil.copy2(src, dst)
    except OSError as e:
        return {"ok": False, "error": "copy failed: %s" % e}
    _git(["add", "-A"])
    c = _git(["commit", "-m", "merge: %s restored from sandbox snapshot %s" % (rel, cands[-1])])
    combined = (c["out"] + c["err"]).lower()
    return {"ok": True, "file": rel, "snapshot": cands[-1],
            "committed": c["ok"] and "nothing to commit" not in combined}


# ---------------------------------------------------------------- Portal API request queue (2026-11-25)
# Every agent gets file/terminal API access for the files the portal lists. Agents emit
# [[PORTAL-API]] blocks in their replies (one JSON call per line); the portal executes them
# when the turn ends. MUTATING calls are QUEUED as pending requests and only take effect on
# approval (human via the Requests panel, or an agent listed under "approvers" in the config).
# READ calls run synchronously. Results ride back to the calling agent on its next turn
# (PORTAL API RESULTS block, UMQ-style). Full reference: memory/portal/api-reqs.md.
APIQ_FILE = os.path.join(HERE, "memory", "ops", "api-reqs.json")
APIQ_AUDIT = os.path.join(HERE, "memory", "ops", "api-reqs.jsonl")
APIQ_RESULTS = os.path.join(HERE, "memory", "ops", "api-results.json")
APIQ_CONFIG = os.path.join(HERE, "memory", "ops", "api-reqs-config.json")
APIQ_LOCK = threading.RLock()
APIQ_MAX_PENDING_PER_AGENT = 25   # spam guard: per-agent pending cap
APIQ_MAX_CALLS_PER_REPLY = 5      # max [[PORTAL-API]] calls executed per reply
APIQ_CHANGE_CHARS = 200_000       # max total chars in linesToReplace
APIQ_CREATE_CHARS = 400_000       # max content for reqCreateFile
APIQ_CMD_CHARS = 2000             # max terminal command length
APIQ_READ_BYTES = 16384           # sync read cap per call (use range to page)
APIQ_TERM_TIMEOUT_S = 120         # terminal execution timeout
APIQ_OUT_CHARS = 8000             # captured stdout/stderr cap
APIQ_LIST_CAP = 4000              # listPortalFiles cap (matches /api/manifest)
APIQ_BLOCK_RE = re.compile(r"\[\[PORTAL-API\]\](.*?)\[\[/PORTAL-API\]\]", re.S)
APIQ_KINDS = ("change", "create", "delete", "terminal")


def _apiq_load():
    try:
        with open(APIQ_FILE, encoding="utf-8") as fh:
            d = json.load(fh)
        if isinstance(d, dict) and isinstance(d.get("requests"), dict):
            return d
    except Exception:
        pass
    return {"seq": 0, "requests": {}}


def _apiq_save(d):
    os.makedirs(os.path.dirname(APIQ_FILE), exist_ok=True)
    tmp = APIQ_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False)
    os.replace(tmp, APIQ_FILE)


def _apiq_audit(ev):
    """Append-only audit trail (jsonl) - survives restarts, auto-committed with memory/."""
    try:
        os.makedirs(os.path.dirname(APIQ_AUDIT), exist_ok=True)
        ev = dict(ev)
        ev.setdefault("ts", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
        with open(APIQ_AUDIT, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(ev, ensure_ascii=False) + "\n")
    except Exception:
        pass


def _apiq_config():
    """{approvers: [agent names allowed to approveReq/rejectReq]}. Default: humans only."""
    try:
        with open(APIQ_CONFIG, encoding="utf-8") as fh:
            d = json.load(fh)
        if isinstance(d, dict) and isinstance(d.get("approvers"), list):
            return d
    except Exception:
        pass
    return {"approvers": []}


def _apiq_now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _apiq_get(d, req_id):
    r = d["requests"].get(req_id)
    return r if isinstance(r, dict) else None


def _apiq_add_request(agent, kind, payload, note=""):
    """Create a PENDING request. Returns (req_dict, error_str)."""
    with APIQ_LOCK:
        d = _apiq_load()
        if kind not in APIQ_KINDS:
            return None, "unknown kind: %s" % kind
        pending_n = sum(1 for r in d["requests"].values() if r.get("status") == "pending")
        if pending_n >= APIQ_MAX_PENDING_PER_AGENT:
            return None, "pending cap reached (%d) - wait for approval or cancelReq yours" % APIQ_MAX_PENDING_PER_AGENT
        d["seq"] = int(d.get("seq", 0)) + 1
        rid = "R%04d" % d["seq"]
        req = {"id": rid, "ts": _apiq_now(), "agent": str(agent)[:60], "kind": kind,
               "status": "pending", "note": str(note or "")[:500], "result": None,
               "events": [{"ts": _apiq_now(), "event": "created", "by": str(agent)[:60]}]}
        req.update(payload)
        d["requests"][rid] = req
        # keep the store bounded: drop terminal output from requests older than 200 entries
        if len(d["requests"]) > 400:
            for old in sorted(d["requests"], key=lambda k: int(k[1:]))[:len(d["requests"]) - 400]:
                r = d["requests"].get(old) or {}
                if r.get("kind") == "terminal":
                    r.pop("stdout", None)
                    r.pop("stderr", None)
        _apiq_save(d)
    _apiq_audit({"event": "created", "id": rid, "agent": req["agent"], "kind": kind,
                 "file": req.get("file"), "command": (req.get("command") or "")[:200]})
    return req, None


def _apiq_apply_change(req):
    """Splice linesToReplace into range [a..b] (1-based inclusive) of the target file."""
    rel = str(req.get("file") or "")
    full = _safe_workspace_file(rel)
    if not full or os.path.isdir(full):
        return {"ok": False, "detail": "file not found in workspace: %s" % rel}
    rng = req.get("range")
    new_lines = req.get("linesToReplace")
    if isinstance(new_lines, str):
        new_lines = [new_lines]
    if (not isinstance(rng, (list, tuple)) or len(rng) != 2
            or not all(isinstance(x, int) for x in rng)):
        return {"ok": False, "detail": "range must be [start,end] integers"}
    a, b = rng[0], rng[1]
    if a < 1 or b < a or not isinstance(new_lines, list):
        return {"ok": False, "detail": "bad range/linesToReplace"}
    try:
        raw = open(full, "rb").read()
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        return {"ok": False, "detail": "file is not utf-8 text - refusing to splice"}
    eol = "\r\n" if text.count("\r\n") >= text.count("\n") // 2 and "\r\n" in text else "\n"
    lines = text.split(eol)
    n = len(lines)
    if b > n + 1 or (b == n + 1 and a != n + 1):
        return {"ok": False, "detail": "range [%d..%d] exceeds file (%d lines) - re-read with reqReadFile" % (a, b, n)}
    new_text = eol.join(lines[:a - 1] + [str(x) for x in new_lines] + lines[b:])
    if len(new_text.encode("utf-8", "replace")) > 32 * 1024 * 1024:
        return {"ok": False, "detail": "result would exceed 32MB"}
    try:
        with open(full, "wb") as fh:
            fh.write(new_text.encode("utf-8"))
    except OSError as e:
        return {"ok": False, "detail": "write failed: %s" % e}
    sha = hashlib.sha256(new_text.encode("utf-8")).hexdigest()[:12]
    return {"ok": True, "sha": sha,
            "detail": "%s: replaced lines %d..%d with %d line(s)" % (rel, a, b, len(new_lines))}


def _apiq_apply_create(req):
    rel = str(req.get("file") or "").replace("\\", "/").lstrip("/")
    if not rel or "\0" in rel:
        return {"ok": False, "detail": "bad file path"}
    content = req.get("content")
    if not isinstance(content, str):
        return {"ok": False, "detail": "content must be a string"}
    for base in (os.path.realpath(HERE), os.path.realpath(SANDBOX_DIR)):
        if not base or not os.path.isdir(base):
            continue
        full = os.path.realpath(os.path.join(base, rel))
        if full != base and not full.startswith(base + os.sep):
            continue
        if os.path.exists(full):
            return {"ok": False, "detail": "file already exists - use requestChange: %s" % rel}
        try:
            os.makedirs(os.path.dirname(full) or base, exist_ok=True)
            with open(full, "w", encoding="utf-8") as fh:
                fh.write(content)
        except OSError as e:
            return {"ok": False, "detail": "write failed: %s" % e}
        sha = hashlib.sha256(content.encode("utf-8")).hexdigest()[:12]
        return {"ok": True, "sha": sha, "detail": "created %s (%d chars)" % (rel, len(content))}
    return {"ok": False, "detail": "no writable base for path: %s" % rel}


def _apiq_apply_delete(req):
    rel = str(req.get("file") or "")
    full = _safe_workspace_file(rel)
    if not full:
        return {"ok": False, "detail": "file not found in workspace: %s" % rel}
    try:
        os.remove(full)
    except OSError as e:
        return {"ok": False, "detail": "delete failed: %s" % e}
    return {"ok": True, "detail": "deleted %s" % rel}


def _apiq_apply_terminal(req):
    cmd = str(req.get("command") or "")[:APIQ_CMD_CHARS]
    if not cmd.strip():
        return {"ok": False, "detail": "empty command"}
    try:
        p = subprocess.run(cmd, shell=True, cwd=HERE, capture_output=True,
                           timeout=APIQ_TERM_TIMEOUT_S)
        out = (p.stdout or b"").decode("utf-8", "replace")[:APIQ_OUT_CHARS]
        err = (p.stderr or b"").decode("utf-8", "replace")[:APIQ_OUT_CHARS]
        return {"ok": p.returncode == 0, "rc": p.returncode, "stdout": out,
                "stderr": err, "detail": "rc=%d (%d+/%d chars output)" % (p.returncode, len(out), len(err))}
    except subprocess.TimeoutExpired:
        return {"ok": False, "detail": "timeout after %ds" % APIQ_TERM_TIMEOUT_S}
    except Exception as e:
        return {"ok": False, "detail": "exec failed: %s" % e}


def _apiq_apply(req_id, by):
    """Approve+execute a pending request. Returns (req, error)."""
    with APIQ_LOCK:
        d = _apiq_load()
        req = _apiq_get(d, req_id)
        if not req:
            return None, "no such request: %s" % req_id
        if req.get("status") != "pending":
            return None, "request %s is %s, not pending" % (req_id, req.get("status"))
        kind = req.get("kind")
        if kind == "change":
            res = _apiq_apply_change(req)
        elif kind == "create":
            res = _apiq_apply_create(req)
        elif kind == "delete":
            res = _apiq_apply_delete(req)
        else:
            res = _apiq_apply_terminal(req)
        req["status"] = "applied" if res.get("ok") else "failed"
        req["result"] = {k: v for k, v in res.items() if k != "stdout" and k != "stderr"}
        if kind == "terminal":   # keep output on the record (capped) for viewTerminalOutput
            req["stdout"] = str(res.get("stdout") or "")[:APIQ_OUT_CHARS]
            req["stderr"] = str(res.get("stderr") or "")[:APIQ_OUT_CHARS]
        req.setdefault("events", []).append({"ts": _apiq_now(), "event": req["status"], "by": str(by)[:60]})
        _apiq_save(d)
    _apiq_audit({"event": req["status"], "id": req_id, "by": str(by)[:60],
                 "kind": kind, "file": req.get("file"), "detail": (res.get("detail") or "")[:300]})
    if res.get("ok") and kind in ("change", "create", "delete"):
        _auto_commit()   # provenance: applied agent edits land in git within the same turn
    return req, None


def _apiq_reject(req_id, reason, by):
    with APIQ_LOCK:
        d = _apiq_load()
        req = _apiq_get(d, req_id)
        if not req:
            return None, "no such request: %s" % req_id
        if req.get("status") != "pending":
            return None, "request %s is %s, not pending" % (req_id, req.get("status"))
        req["status"] = "rejected"
        req["result"] = {"ok": False, "detail": "rejected: %s" % str(reason or "")[:300]}
        req.setdefault("events", []).append({"ts": _apiq_now(), "event": "rejected",
                                             "by": str(by)[:60], "reason": str(reason or "")[:300]})
        _apiq_save(d)
    _apiq_audit({"event": "rejected", "id": req_id, "by": str(by)[:60],
                 "kind": req.get("kind"), "file": req.get("file"), "reason": str(reason or "")[:300]})
    return req, None


def _apiq_view(kind=None, status=None, limit=100):
    """Queue view for REST + agent calls. Newest first."""
    with APIQ_LOCK:
        d = _apiq_load()
    out = []
    for rid in sorted(d["requests"], key=lambda k: int(k[1:]), reverse=True):
        r = d["requests"][rid]
        if kind and r.get("kind") != kind:
            continue
        if status and r.get("status") != status:
            continue
        slim = {k: v for k, v in r.items() if k not in ("linesToReplace", "content", "stdout", "stderr")}
        if r.get("kind") == "change":
            slim["lineCount"] = len(r.get("linesToReplace") or [])
        elif r.get("kind") == "create":
            slim["contentChars"] = len(r.get("content") or "")
        out.append(slim)
        if len(out) >= limit:
            break
    return out


def _apiq_stats():
    with APIQ_LOCK:
        d = _apiq_load()
    st = {"pending": 0, "applied": 0, "rejected": 0, "failed": 0, "withdrawn": 0,
          "pending_file": 0, "pending_terminal": 0}
    for r in d["requests"].values():
        s = r.get("status") or "pending"
        if s in st:
            st[s] += 1
        if s == "pending":
            if r.get("kind") == "terminal":
                st["pending_terminal"] += 1
            else:
                st["pending_file"] += 1
    return st


def _apiq_history(limit=50, rng=None):
    """Processed requests (not pending), oldest first. rng = [a..b] 1-based slice or int N = last N."""
    with APIQ_LOCK:
        d = _apiq_load()
    done = [d["requests"][rid] for rid in sorted(d["requests"], key=lambda k: int(k[1:]))
            if d["requests"][rid].get("status") != "pending"]
    if isinstance(rng, (list, tuple)) and len(rng) == 2 and all(isinstance(x, int) for x in rng):
        a, b = max(1, rng[0]), rng[1]
        done = done[a - 1:b]
    else:
        n = int(limit)
        done = done[-n:] if n > 0 else []
    out = [{"id": r["id"], "ts": r.get("ts"), "agent": r.get("agent"), "kind": r.get("kind"),
            "file": r.get("file"), "command": (r.get("command") or "")[:160],
            "status": r.get("status"), "detail": ((r.get("result") or {}).get("detail") or "")[:200]}
           for r in done]
    return out


def _apiq_read_file(rel, rng=None):
    """Synchronous read (no queue): current content or a 1-based inclusive line range."""
    full = _safe_workspace_file(str(rel or ""))
    if not full or os.path.isdir(full):
        return {"ok": False, "detail": "file not found in workspace: %s" % rel}
    try:
        raw = open(full, "rb").read()
    except OSError as e:
        return {"ok": False, "detail": str(e)}
    if b"\x00" in raw[:8192]:
        return {"ok": False, "detail": "binary file - no text read (use runCMD to inspect)"}
    text = raw.decode("utf-8", "replace")
    lines = text.splitlines()
    total = len(lines)
    if isinstance(rng, (list, tuple)) and len(rng) == 2 and all(isinstance(x, int) for x in rng):
        a, b = max(1, min(rng[0], total)), max(1, min(rng[1], total))
        sel = lines[a - 1:b]
    else:
        a, b = 1, total
        sel = lines[:APIQ_READ_BYTES // 40]   # rough pre-trim so huge files stay bounded
    body = "\n".join("%5d| %s" % (a + i, l) for i, l in enumerate(sel))
    truncated = False
    if len(body.encode("utf-8", "replace")) > APIQ_READ_BYTES:
        cut = []
        size = 0
        for i, l in enumerate(sel):
            line = "%5d| %s\n" % (a + i, l)
            if size + len(line) > APIQ_READ_BYTES - 60:
                truncated = True
                break
            cut.append(line.rstrip("\n"))
            size += len(line)
        body = "\n".join(cut)
    return {"ok": True, "file": str(rel).replace("\\", "/"), "totalLines": total,
            "range": [a, b], "truncated": truncated, "content": body}


def _apiq_list_files():
    """The files the portal lists (same walk as /api/manifest)."""
    files = {}
    skip_dirs = {"__pycache__", ".unsloth-tmp", "unsloth-tmp", "AppData", "Microsoft", "Python"}
    for root in (HERE, SANDBOX_DIR):
        if not root:
            continue
        base = os.path.realpath(root)
        if not os.path.isdir(base):
            continue
        try:
            for dirpath, dirnames, filenames in os.walk(base):
                dirnames[:] = [x for x in dirnames if not x.startswith(".") and x not in skip_dirs]
                for fn in filenames:
                    if fn.startswith("."):
                        continue
                    fp = os.path.join(dirpath, fn)
                    try:
                        mt = os.stat(fp).st_mtime
                    except OSError:
                        continue
                    rel = os.path.relpath(fp, base).replace("\\", "/")
                    if root == HERE or rel not in files:
                        files[rel] = mt
        except OSError:
            continue
    out = [{"path": k, "mtime": round(v, 1)} for k, v in sorted(files.items())][:APIQ_LIST_CAP]
    return {"ok": True, "count": len(out), "files": out}


def _apiq_edit(req_id, agent, fields):
    with APIQ_LOCK:
        d = _apiq_load()
        req = _apiq_get(d, req_id)
        if not req:
            return None, "no such request: %s" % req_id
        if req.get("status") != "pending":
            return None, "request %s is %s - only pending requests can be edited" % (req_id, req.get("status"))
        if req.get("agent") != agent and agent not in _apiq_config()["approvers"]:
            return None, "not yours to edit (owner: %s)" % req.get("agent")
        changed = []
        for k in ("range", "linesToReplace", "content", "note", "command", "file"):
            if k in fields and fields[k] is not None:
                req[k] = fields[k]
                changed.append(k)
        if not changed:
            return None, "nothing to edit (allowed: range, linesToReplace, content, note, command, file)"
        req.setdefault("events", []).append({"ts": _apiq_now(), "event": "edited", "by": str(agent)[:60],
                                             "fields": changed})
        _apiq_save(d)
    _apiq_audit({"event": "edited", "id": req_id, "by": str(agent)[:60], "fields": changed})
    return req, None


def _apiq_cancel(req_id, agent):
    with APIQ_LOCK:
        d = _apiq_load()
        req = _apiq_get(d, req_id)
        if not req:
            return None, "no such request: %s" % req_id
        if req.get("status") != "pending":
            return None, "request %s is %s - only pending can be withdrawn" % (req_id, req.get("status"))
        if req.get("agent") != agent and agent not in _apiq_config()["approvers"]:
            return None, "not yours to withdraw (owner: %s)" % req.get("agent")
        req["status"] = "withdrawn"
        req.setdefault("events", []).append({"ts": _apiq_now(), "event": "withdrawn", "by": str(agent)[:60]})
        _apiq_save(d)
    _apiq_audit({"event": "withdrawn", "id": req_id, "by": str(agent)[:60], "kind": req.get("kind")})
    return req, None


def _apiq_dispatch(agent, call, args):
    """Execute ONE Portal API call. Returns a result dict (always has ok + detail)."""
    args = args if isinstance(args, dict) else {}
    approvers = set(_apiq_config()["approvers"])
    try:
        c = str(call or "").strip()
        if c in ("runCMD", "runTerminalReq"):
            cmd = str(args.get("command") or "")[:APIQ_CMD_CHARS]
            if not cmd.strip():
                return {"ok": False, "detail": "command required"}
            req, err = _apiq_add_request(agent, "terminal", {"command": cmd}, args.get("note"))
            return {"ok": True, "id": req["id"], "queued": True,
                    "detail": "terminal request queued: %s" % (err or cmd[:120])} if not err else {"ok": False, "detail": err}
        elif c == "requestChange":
            f = str(args.get("file") or "")
            rng = args.get("range")
            ltr = args.get("linesToReplace")
            if isinstance(ltr, str):
                ltr = [ltr]
            if not f:
                return {"ok": False, "detail": "file required"}
            if (not isinstance(rng, (list, tuple)) or len(rng) != 2
                    or not all(isinstance(x, int) for x in rng)):
                return {"ok": False, "detail": "range [start,end] required (1-based inclusive)"}
            if rng[0] < 1 or rng[1] < rng[0]:
                return {"ok": False, "detail": "range must be 1 <= start <= end"}
            if not isinstance(ltr, list) or sum(len(str(x)) for x in ltr) > APIQ_CHANGE_CHARS:
                return {"ok": False, "detail": "linesToReplace must be a string list <= %d chars" % APIQ_CHANGE_CHARS}
            req, err = _apiq_add_request(agent, "change",
                                         {"file": f.replace("\\", "/"), "range": [rng[0], rng[1]],
                                          "linesToReplace": [str(x) for x in ltr]}, args.get("note"))
            return ({"ok": True, "id": req["id"], "queued": True,
                     "detail": "change queued: %s [%d..%d] -> %d line(s)" % (f, rng[0], rng[1], len(ltr))}
                    if not err else {"ok": False, "detail": err})
        elif c == "reqCreateFile":
            f = str(args.get("file") or "")
            content = args.get("content")
            if not f or not isinstance(content, str) or len(content) > APIQ_CREATE_CHARS:
                return {"ok": False, "detail": "file + content (<= %d chars) required" % APIQ_CREATE_CHARS}
            req, err = _apiq_add_request(agent, "create",
                                         {"file": f.replace("\\", "/"), "content": content}, args.get("note"))
            return ({"ok": True, "id": req["id"], "queued": True,
                     "detail": "create queued: %s (%d chars)" % (f, len(content))}
                    if not err else {"ok": False, "detail": err})
        elif c == "reqDeleteFile":
            f = str(args.get("file") or "")
            if not f:
                return {"ok": False, "detail": "file required"}
            req, err = _apiq_add_request(agent, "delete", {"file": f.replace("\\", "/")}, args.get("note"))
            return ({"ok": True, "id": req["id"], "queued": True, "detail": "delete queued: %s" % f}
                    if not err else {"ok": False, "detail": err})
        elif c == "reqReadFile":
            return _apiq_read_file(str(args.get("file") or ""), args.get("range"))
        elif c == "listPortalFiles":
            r = _apiq_list_files()
            # keep the reply-to-agent payload small: newest 300 by mtime (path-sorted cap would
            # hide recently added files once the workspace passes 4000 entries)
            r["files"] = [{"path": x["path"], "mtime": x["mtime"]}
                          for x in sorted(r["files"], key=lambda x: -x["mtime"])[:300]]
            return r
        elif c == "viewRequestQueue":
            items = _apiq_view(status="pending", limit=30)
            return {"ok": True, "count": len(items), "requests": items}
        elif c == "viewTerminalQueue":
            items = _apiq_view(kind="terminal", status="pending", limit=30)
            return {"ok": True, "count": len(items), "requests": items}
        elif c == "getReqInfo":
            rid = str(args.get("reqID") or args.get("id") or "").upper()
            with APIQ_LOCK:
                d = _apiq_load()
                r = _apiq_get(d, rid)
                out = dict(r) if r else None
            if not out:
                return {"ok": False, "detail": "no such request: %s" % rid}
            if "linesToReplace" in out:   # full bodies stay in the store; agent gets a count
                out["lineCount"] = len(out.get("linesToReplace") or [])
                out.pop("linesToReplace")
            if "content" in out:
                out["contentChars"] = len(out.get("content") or "")
                out.pop("content")
            return {"ok": True, "request": out}
        elif c == "editReq":
            rid = str(args.get("reqID") or args.get("id") or "").upper()
            req, err = _apiq_edit(rid, agent, args)
            return ({"ok": True, "id": rid, "detail": "edited: %s" % ", ".join(k for k in args if k in ("range", "linesToReplace", "content", "note", "command", "file"))}
                    if not err else {"ok": False, "detail": err})
        elif c == "cancelReq":
            rid = str(args.get("reqID") or args.get("id") or "").upper()
            req, err = _apiq_cancel(rid, agent)
            return ({"ok": True, "id": rid, "detail": "withdrawn %s" % rid} if not err else {"ok": False, "detail": err})
        elif c == "getReqHistory":
            rng = args.get("range") or args.get("n")
            items = _apiq_history(limit=30, rng=rng)
            return {"ok": True, "count": len(items), "history": items}
        elif c in ("approveReq", "rejectReq"):
            rid = str(args.get("reqID") or args.get("id") or "").upper()
            if agent not in approvers and agent != "human":
                return {"ok": False, "detail": "%s is not an approver (config: memory/ops/api-reqs-config.json)" % c}
            if c == "approveReq":
                req, err = _apiq_apply(rid, agent)
                return ({"ok": True, "id": rid,
                         "detail": ((req or {}).get("result") or {}).get("detail", "applied")}
                        if not err else {"ok": False, "detail": err})
            req, err = _apiq_reject(rid, str(args.get("reason") or ""), agent)
            return ({"ok": True, "id": rid, "detail": "rejected %s" % rid} if not err else {"ok": False, "detail": err})
        elif c == "viewTerminalOutput":
            rid = str(args.get("reqID") or args.get("id") or "").upper()
            with APIQ_LOCK:
                d = _apiq_load()
                r = _apiq_get(d, rid)
            if not r:
                return {"ok": False, "detail": "no such request: %s" % rid}
            return {"ok": True, "id": rid, "status": r.get("status"),
                    "rc": (r.get("result") or {}).get("rc"),
                    "stdout": str(r.get("stdout") or "")[:APIQ_OUT_CHARS],
                    "stderr": str(r.get("stderr") or "")[:APIQ_OUT_CHARS]}
        elif c == "getQueueStats":
            return {"ok": True, **_apiq_stats()}
        else:
            return {"ok": False, "detail": "unknown call: %s (see memory/portal/api-reqs.md)" % c}
    except Exception as e:
        return {"ok": False, "detail": "error: %s" % str(e)[:200]}


def _apiq_execute(agent, text):
    """Parse [[PORTAL-API]] blocks out of a reply, execute the calls, queue results for the
    agent's next turn. Returns (clean_text, n_calls). The clean text has the blocks removed
    so chat/memory never see the raw JSON."""
    blocks = APIQ_BLOCK_RE.findall(text or "")
    if not blocks:
        return text, 0
    results = []
    for blk in blocks:
        for line in blk.splitlines():
            line = line.strip().rstrip(",")
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                results.append({"call": "?", "result": {"ok": False, "detail": "unparseable JSON line: %s" % line[:120]}})
                continue
            call = str(obj.get("call") or obj.get("fn") or "")
            args = obj.get("args") if isinstance(obj.get("args"), dict) else \
                   ({k: v for k, v in obj.items() if k not in ("call", "fn")} if isinstance(obj, dict) else {})
            results.append({"call": call, "result": _apiq_dispatch(agent, call, args)})
            if len(results) >= APIQ_MAX_CALLS_PER_REPLY:
                break
        if len(results) >= APIQ_MAX_CALLS_PER_REPLY:
            break
    clean = APIQ_BLOCK_RE.sub("", text or "")
    clean = re.sub(r"\n{3,}", "\n\n", clean).strip()
    _apiq_queue_results(agent, results)
    return clean, len(results)


# ---- per-agent result delivery (UMQ-style: injected next turn, marked seen once it reaches Studio) ----

def _apiq_read_results():
    try:
        with open(APIQ_RESULTS, encoding="utf-8") as fh:
            d = json.load(fh)
        if isinstance(d, dict) and isinstance(d.get("pending"), dict):
            return d
    except Exception:
        pass
    return {"pending": {}}


def _apiq_write_results(d):
    os.makedirs(os.path.dirname(APIQ_RESULTS), exist_ok=True)
    tmp = APIQ_RESULTS + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False)
    os.replace(tmp, APIQ_RESULTS)


def _apiq_queue_results(agent, results):
    if not results:
        return
    with APIQ_LOCK:
        d = _apiq_read_results()
        lst = d["pending"].setdefault(str(agent)[:60], [])
        for r in results:
            res = r.get("result") or {}
            entry = {"id": "ap-%s-%s" % (time.strftime("%H%M%S"), uuid.uuid4().hex[:5]),
                     "ts": _apiq_now(), "call": str(r.get("call") or "?")[:40],
                     "reqID": res.get("id"), "result": res}
            lst.append(entry)
        d["pending"][str(agent)[:60]] = lst[-25:]
        _apiq_write_results(d)


def _apiq_pending_for(agent):
    with APIQ_LOCK:
        d = _apiq_read_results()
    return list(d["pending"].get(str(agent)[:60]) or [])


def _apiq_check(ids, agent):
    """Mark result entries seen (called once the request reaches Studio - mirrors umq_check)."""
    ids = [i for i in (ids or []) if isinstance(i, str)]
    if not ids:
        return 0
    with APIQ_LOCK:
        d = _apiq_read_results()
        lst = d["pending"].get(str(agent)[:60])
        if not lst:
            return 0
        kept = [e for e in lst if e.get("id") not in ids]
        n = len(lst) - len(kept)
        if kept:
            d["pending"][str(agent)[:60]] = kept
        else:
            d["pending"].pop(str(agent)[:60], None)
        if n:
            _apiq_write_results(d)
    return n


def _safe_upload_path(rel):
    """Resolve an upload target inside UPLOAD_DIR. Returns (abs_path, clean_rel) or None.
    Anything is accepted as long as it stays under uploads/ - traversal, absolute paths,
    drive letters and NUL bytes are rejected."""
    try:
        rel = urllib.parse.unquote((rel or "").replace("\\", "/"))
    except Exception:
        return None
    if "\0" in rel:
        return None
    if re.match(r"^[A-Za-z]:", rel.lstrip("/")):
        return None   # absolute Windows path - reject outright
    if rel.startswith("/"):
        return None   # absolute POSIX-style path - reject outright (no silent relativizing)
    rel = rel.lstrip("/")
    if rel == "uploads":
        return None   # bare prefix, no file name
    if not rel.startswith("uploads/"):
        rel = "uploads/" + rel
    parts = [p for p in rel.split("/") if p not in ("", ".")]
    if len(parts) < 2 or any(p == ".." for p in parts):
        return None
    base = os.path.realpath(UPLOAD_DIR)
    full = os.path.realpath(os.path.join(base, *parts[1:]))   # parts[0] is the 'uploads' prefix itself
    if full != base and not full.startswith(base + os.sep):
        return None
    return full, "uploads/" + "/".join(parts[1:])

XTALK_LIMIT = 6                                  # FINITE cap, used when infinite_budget is OFF (default: ON = unlimited).
RESET_PHRASE = "counter reset"
_lock = threading.RLock()  # reentrant: _bump_counter/_reset_counter hold it while calling _write_memory

# ---- Per-message memory cycle (2026-11-14) --------------------------------------
# Every /api/chat turn runs: READMEM -> ADDCONTEXT -> main reply (+tools) -> STOREMEM.
# ReadMem/StoreMem are cheap auxiliary LLM rounds (low reasoning, tiny budget) that must
# NEVER break the main turn - they degrade to a no-op on any failure.
MEM_CYCLE_DEFAULT = True        # per-agent "mem_cycle": ReadMem before, StoreMem after
FAST_FIRST_DEFAULT = True       # per-agent "fast_first_reply": first reply to a human...
FIRST_REPLY_MAX_MSGS = 8        #   ...uses a low context window (last N messages)
FIRST_REPLY_REASONING = "low"   #   ...and low reasoning when the agent setting is "default"
MEM_LOOKUP_MAX_TOKENS = 250     # ReadMem routing call budget
MEM_STORE_MAX_TOKENS = 200      # StoreMem call budget
HOT_NOTE_MAX = 10               # keep only the newest N hot notes in memory.md
HOT_NOTE_CHARS = 140            # hard cap per stored note

# ---- Activity timeline (2026-11-12) --------------------------------------------
# Per-session audit log: every /api/chat turn appends JSONL events to
# activity/<session>.jsonl (start / tool / end / blocked / error / aborted).
# Survives portal restarts; read back via GET /api/activity?session=<id>.
ACTIVITY_DIR = os.path.join(HERE, "activity")
_act_lock = threading.Lock()


def _safe_session(sid):
    """Filename-safe session id. Empty/None -> shared 'default' file (legacy callers)."""
    s = re.sub(r"[^A-Za-z0-9_-]", "-", str(sid or "").strip())[:64]
    return s or "default"


def _act_log(session, ev):
    """Append one event to the session JSONL. Logging must NEVER break a chat."""
    try:
        os.makedirs(ACTIVITY_DIR, exist_ok=True)
        line = json.dumps({"ts": round(time.time(), 3), **ev}, ensure_ascii=False)
        with _act_lock:
            with open(os.path.join(ACTIVITY_DIR, session + ".jsonl"), "a", encoding="utf-8") as f:
                f.write(line + "\n")
    except Exception:
        pass


def _tool_names(tool):
    """Tool names from a stream 'tool' frame (object or list of call deltas)."""
    names = []
    for it in (tool if isinstance(tool, list) else [tool]):
        if not isinstance(it, dict):
            continue
        fn = it.get("function") or {}
        nm = it.get("name") or fn.get("name")
        if nm:
            names.append(str(nm)[:60])
    return names


def load_activity(session=None):
    """session None -> recent-sessions index; else that session's event list."""
    os.makedirs(ACTIVITY_DIR, exist_ok=True)
    if not session:
        out = []
        for fn in os.listdir(ACTIVITY_DIR):
            if not fn.endswith(".jsonl"):
                continue
            try:
                n, last_ts = 0, 0.0
                with open(os.path.join(ACTIVITY_DIR, fn), encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if not line:
                            continue
                        n += 1
                        try:
                            last_ts = max(last_ts, float(json.loads(line).get("ts", 0)))
                        except Exception:
                            pass
                out.append({"session": fn[:-6], "events": n, "last_ts": last_ts})
            except OSError:
                continue
        out.sort(key=lambda o: o["last_ts"], reverse=True)
        return {"sessions": out[:50]}
    sess = _safe_session(session)
    events = []
    try:
        with open(os.path.join(ACTIVITY_DIR, sess + ".jsonl"), encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    events.append(json.loads(line))
                except Exception:
                    pass
    except OSError:
        return {"session": sess, "events": []}
    return {"session": sess, "events": events[-2000:]}

_MEMORY_TEMPLATE = """<!-- state: {"inter_agent_replies": 0, "last_reset_by": "", "infinite_budget": true} -->
# Shared Group Memory

Global context shared by ALL agents in this project. Agent-to-agent replies in the
group chat are UNLIMITED by default (infinite budget ON); set infinite_budget to false
in the state line above to cap them at %d per prompt. The counter below tracks replies;
it resets with each new prompt, or immediately when a member explicitly says "%s".

## Counter
- inter_agent_replies_this_prompt: 0 / ∞
- last_reset_by: —

## Notes
(leave short shared notes here; visible to every agent)
""" % (XTALK_LIMIT, RESET_PHRASE)

_STATE_RE = re.compile(r"<!--\s*state:\s*(\{.*?\})\s*-->", re.S)

# Local tool suite the Studio harness exposes (run on the host, not in a sandbox).
LOCAL_TOOLS = ["web_search", "python", "terminal", "edit_file", "render_html"]
REASONING_LEVELS = ["default", "off", "minimal", "low", "medium", "high", "max", "xhigh"]


def _norm_tools(v):
    if isinstance(v, list):
        return [t for t in v if t in LOCAL_TOOLS]
    return []


def default_agent_fields():
    return {"temperature": 0.7, "max_tokens": 0, "reasoning": "default",
            "tools": [], "run_tools_locally": True, "max_tool_calls": 0,
            "rag": False, "rag_kb_id": "", "studio": "", "api_key": "",
            "rag_studio": "", "rag_api_key": "",
            "mem_cycle": True, "fast_first_reply": True}


def apply_agent_fields(agent, data):
    """Copy + normalize the editable profile fields from a request body."""
    for k in ("name", "emoji", "color", "persona", "blurb"):
        if k in data:
            agent[k] = (data[k] or "").strip() if isinstance(data[k], str) else data[k]
    if "model_id" in data:
        agent["model_id"] = data["model_id"] or ""
    if "temperature" in data:
        try:
            agent["temperature"] = float(data["temperature"])
        except (TypeError, ValueError):
            pass
    if "max_tokens" in data:
        try:
            agent["max_tokens"] = max(0, int(data["max_tokens"]))   # 0 = Studio decides
        except (TypeError, ValueError):
            pass
    if isinstance(data.get("reasoning"), str) and data["reasoning"] in REASONING_LEVELS:
        agent["reasoning"] = data["reasoning"]
    if "tools" in data:
        agent["tools"] = _norm_tools(data["tools"])
    if "run_tools_locally" in data:
        agent["run_tools_locally"] = bool(data["run_tools_locally"])
    if "max_tool_calls" in data:
        try:
            v = int(data["max_tool_calls"])
            agent["max_tool_calls"] = v if v > 0 else 0             # 0 = Studio decides
        except (TypeError, ValueError):
            pass
    if "rag" in data:
        agent["rag"] = bool(data["rag"])
    if "rag_kb_id" in data:
        agent["rag_kb_id"] = str(data["rag_kb_id"] or "")
    if "studio" in data:
        agent["studio"] = str(data["studio"] or "").strip()   # remote host base URL (multi-host)
    if "api_key" in data:
        agent["api_key"] = str(data["api_key"] or "")          # Bearer key for that host
    if "rag_studio" in data:
        agent["rag_studio"] = str(data["rag_studio"] or "").strip()  # RAG host override (empty = chat host)
    if "rag_api_key" in data:
        agent["rag_api_key"] = str(data["rag_api_key"] or "")      # Bearer key for the RAG host
    if "mem_cycle" in data:
        agent["mem_cycle"] = bool(data["mem_cycle"])
    if "fast_first_reply" in data:
        agent["fast_first_reply"] = bool(data["fast_first_reply"])


def studio_post(path, payload, timeout=30, agent=None):
    req = urllib.request.Request(studio_base(agent) + path, data=json.dumps(payload).encode(),
                                 headers=studio_headers(agent), method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def scan_remote_models(base_url, api_key="", timeout=20):
    """GET {base}/v1/models on a (possibly remote) Studio - the add-agent model scan.
    Returns (http_code, payload). 502 + error text when the host/key is unreachable.
    Kept separate from do_POST so it unit-tests without a live portal."""
    base = str(base_url or "").strip().rstrip("/")
    if not base:
        return 400, {"error": "base_url required", "data": []}
    if "://" not in base:                       # be lenient: host:port -> http://host:port
        base = "http://" + base
    h = {}
    key = str(api_key or "").strip()
    if key:
        h["Authorization"] = "Bearer " + key
    try:
        with urllib.request.urlopen(urllib.request.Request(base + "/v1/models", headers=h),
                                    timeout=timeout) as r:
            return 200, json.load(r)
    except Exception as e:
        return 502, {"error": str(e), "data": []}

# ---- Fleet Status panel (2026-11-13, 8-agent round-table decision) ----
FLEET_TTL = 15          # seconds; last_seen older than this => "unknown"
FLEET_PROBE_TIMEOUT = 2 # seconds per sub-probe; parallel probes keep a full snapshot < 5s
                        # even with all remotes down (a dead host fails its first sub-probe)
FLEET_MODELS_TTL = 30   # seconds; /v1/models refetch interval - the loaded-model list
                        # changes rarely, and Studio's /v1/models can stall >2s while a
                        # generation is active (observed 2026-11-15), so fetch on TTL and
                        # fall back to the last known list rather than failing the host.
_fleet_cache = {}       # base -> ts of last successful probe (stale aging)
_fleet_dead = {}        # base -> ts of last FAILED probe (negative cache: no re-probe within FLEET_TTL)
_fleet_models_cache = {}  # base -> (ts, [models]) - survives transient /v1/models stalls
_fleet_lock = threading.Lock()

def _fleet_probe(base, api_key="", timeout=3):
    """One lightweight per-host probe: active-generations + /v1/models (metadata only,
    no inference load; runs only when a human refreshes the panel). Short timeout so a
    dead host can't hang /api/fleet. Returns {generations, models} when the host's
    Studio answers its liveness endpoint, else None (= unknown)."""
    b = base.rstrip("/")
    h = {}
    if api_key:
        h["Authorization"] = "Bearer " + str(api_key)
    try:
        with urllib.request.urlopen(urllib.request.Request(b + "/api/inference/active-generations", headers=h), timeout=timeout) as r:
            gen = int(json.load(r).get("count", 0))
    except urllib.error.HTTPError as e:
        # The Studio ANSWERED, so the host IS up. 401/403 = our key is missing or expired:
        # report a distinct 'unauth' state instead of a false 'unreachable' (2026-11-22,
        # Black was alive but keyless-probed and showed down in the Fleet tab).
        if e.code in (401, 403):
            return {"generations": None, "models": [], "auth": False}
        return None
    except Exception:
        return None
    # Studio-side load visibility (2026-11-22): /api/inference/status reports the models
    # CURRENTLY LOADING on this engine - including loads the portal never initiated (boot
    # auto-load tasks, manual reloads). The Fleet tab shows these too, so a host mid-load
    # is visible no matter who started it. Best-effort: a slow status call must never
    # demote a live host to unknown.
    sl = []
    try:
        with urllib.request.urlopen(urllib.request.Request(b + "/api/inference/status", headers=h), timeout=timeout) as r:
            st = json.load(r)
        for m in (st.get("loading") or []):
            mid = str(m if not isinstance(m, dict) else (m.get("id") or m.get("model") or ""))
            if mid:
                sl.append(mid.replace("\\", "/").rsplit("/", 1)[-1])
    except Exception:
        pass
    # AG answered => the host IS reachable; state derives from generations. The model
    # list is display-only: fetch on TTL, fall back to the last known list (or empty)
    # when /v1/models stalls - never demote a live host to unknown for it.
    now = time.time()
    cached = _fleet_models_cache.get(b)
    if cached and now - cached[0] < FLEET_MODELS_TTL:
        models = cached[1]
    else:
        code, payload = scan_remote_models(b, api_key, timeout=timeout)
        if code != 200:
            models = cached[1] if cached else []
        else:
            models = []
            for m in (payload or {}).get("data", []):
                mid = str(m.get("id", ""))
                if "loaded" in m and not m["loaded"]:
                    continue
                qm = re.search(r"(UD-)?(Q\d+[A-Z0-9_]*|F16|BF16)", mid)
                models.append({"id": mid, "quant": qm.group(2) if qm else ""})
            _fleet_models_cache[b] = (now, models)
    return {"generations": gen, "models": models, "studio_loading": sl}

def _fleet_snapshot():
    """GET /api/fleet: live view of every host in agents.json (+ local Studio).
    State definitions (locked in round-table): busy = >=1 active generation on that
    Studio; idle = reachable with none; unknown = probe failed (last_seen then ages
    from cache; client renders stale/unknown, never green/idle).
    Budget: probes run IN PARALLEL with FLEET_PROBE_TIMEOUT and dead hosts are
    negatively cached for FLEET_TTL, so a full snapshot stays inside the panel's 5s
    refresh window even with every remote powered down (verified 2026-11-15 by
    memory/verifier/fleet_crosscheck.py)."""
    hosts, order = {}, []
    for a in load_agents().get("agents", []):
        b = studio_base(a).rstrip("/")
        if b not in hosts:
            hosts[b] = {"key": a.get("api_key") or "", "agents": []}
            order.append(b)
        hosts[b]["agents"].append(a.get("name"))
    local = STUDIO.rstrip("/")
    if local not in hosts:
        hosts[local] = {"key": "", "agents": []}
        order.insert(0, local)
    # Catalog hosts with no agents mapped (e.g. Black) still belong to the fleet picture:
    # they can serve as placement seats and carry model loads, so the tab must not hide them.
    # Their Studio keys come from host_api.py (no agents.json seat carries one for them).
    for cb in _fleet_host_names():
        if cb not in hosts:
            hosts[cb] = {"key": _fleet_host_key(cb), "agents": []}
            order.append(cb)
    now = time.time()

    def probe(b):
        with _fleet_lock:
            cached_dead = (now - _fleet_dead.get(b, 0)) < FLEET_TTL
        if cached_dead:
            return None
        res = _fleet_probe(b, hosts[b]["key"], timeout=FLEET_PROBE_TIMEOUT)
        with _fleet_lock:
            if res is not None:
                _fleet_cache[b] = time.time()
                _fleet_dead.pop(b, None)
            else:
                _fleet_dead[b] = time.time()
        return res

    results = {}
    with ThreadPoolExecutor(max_workers=max(1, len(order))) as ex:
        futs = {ex.submit(probe, b): b for b in order}
        for f in as_completed(futs):
            b = futs[f]
            try:
                results[b] = f.result()
            except Exception:
                results[b] = None

    rows = []
    for b in order:
        h = hosts[b]
        name = _friendly_host_name(b)
        row = {"host": name, "base": b, "agents": h["agents"], "models": [],
               "generations": 0, "state": "unknown", "last_seen": None, "reason": "",
               "host_loading": []}
        res = results.get(b)
        with _fleet_lock:
            if res is None:
                row["last_seen"] = _fleet_cache.get(b)
                row["reason"] = ("unreachable" if row["last_seen"] is None else
                                 "stale (%ds)" % int(now - row["last_seen"]))
        if res is not None:
            auth = res.pop("auth", None)
            row.update(res)
            if auth is False:
                # host up, probe rejected: show it as UP (counts toward 'reporting') but
                # flag the key problem instead of pretending to know its load state
                row["state"] = "unauth"
                row["generations"] = 0
                row["reason"] = "up - unauthenticated (key missing or expired)"
            else:
                row["state"] = "busy" if res.get("generations") else "idle"
            row["last_seen"] = now
        # Load queue (2026-11-22): in-flight load + waiters behind it, per host. The waiter
        # counter includes the runner itself while a load is active, so queued = waiters - 1.
        with _LOADQ_LOCK:
            act = _HOST_LOAD_ACTIVE.get(b.rstrip("/"))
            wait = _HOST_LOAD_WAITERS.get(b.rstrip("/"), 0)
        row["loading"] = dict(act) if act else None
        row["queued"] = max(0, wait - (1 if act else 0))
        # Host-side loads (2026-11-22): models Studio itself reports mid-load via
        # /api/inference/status - boot auto-loads and manual reloads included, not just
        # portal-initiated queue entries. This is why the panel used to read "empty"
        # while a host was plainly loading a model it started on its own.
        row["host_loading"] = (res or {}).get("studio_loading") or []
        row.pop("studio_loading", None)
        # Live placement (2026-11-22): agents that actually RAN on this host in the last
        # ACTIVE_TTL_S seconds - placement is host-agnostic, so this is the truth the tab
        # shows; h["agents"] stays the static home roster for reference.
        row["active"] = _active_agents(b)
        rows.append(row)
    return {"ts": now, "ttl": FLEET_TTL, "hosts": rows}


# ---------------------------------------------------------------------------
# 2026-11-16 (cycle-2 SLO pipeline + fleet endpoint + decision trace):
# perf ring buffer, fleet health snapshot, decisions API. Read-only/in-memory,
# no new dependencies.
# ---------------------------------------------------------------------------
import collections as _collections

_PERF = _collections.deque(maxlen=20000)   # (ts, path, ms)
_SERVER_START = time.time()


def _perf_record(path, ms):
    try:
        if "/api/run-events" not in path:   # SSE stream - not request latency
            _PERF.append((time.time(), path, ms))
    except Exception:
        pass


def _percentile(vals, pct):
    if not vals:
        return None
    vs = sorted(vals)
    k = (len(vs) - 1) * pct / 100.0
    f = int(k)
    c = min(f + 1, len(vs) - 1)
    return round(vs[f] + (vs[c] - vs[f]) * (k - f), 2)


def _perf_snapshot():
    """GET /api/perf (Builder cycle-2 goal 8): p50/p95/p99 per endpoint over a rolling
    60-min window. Feeds Ops sparkline tiles + Verifier SLO enforcement."""
    now = time.time()
    cutoff = now - 3600
    per = {}
    for ts, path, ms in _PERF:
        if ts >= cutoff:
            per.setdefault(path, []).append(ms)
    out = []
    for path, vals in sorted(per.items(), key=lambda kv: -len(kv[1])):
        out.append({"path": path, "n": len(vals),
                    "p50_ms": _percentile(vals, 50), "p95_ms": _percentile(vals, 95),
                    "p99_ms": _percentile(vals, 99)})
    return {"ok": True, "window_s": 3600, "endpoints": out}


# ---- Fleet Cockpit API (Orchestrator cycle-10 goal 3; re-landed 2026-11-23) ----
# The earlier REACHED marker was stale: the route had been lost in a refactor. This landing
# is live-verified: one call = full fleet picture for the Cockpit tab (builder goal 2).
_cockpit_cache = {"ts": 0.0, "data": None}
_COCKPIT_TTL = 15   # seconds; dashboard view - 15s freshness keeps responses well under 2s

def _cockpit_gpu_local(timeout=2):
    """Local GPU aggregate via nvidia-smi: vram_pct (all GPUs), cpu_pct (GPU util avg),
    temp_c (max). None on any failure - a missing GPU must never break the cockpit."""
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=timeout,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
        if out.returncode != 0:
            return None
        rows = [r.split(",") for r in out.stdout.strip().splitlines() if r.strip()]
        if not rows:
            return None
        util = sum(float(r[0]) for r in rows) / len(rows)
        used = sum(float(r[1]) for r in rows)
        total = sum(float(r[2]) for r in rows)
        temp = max(float(r[3]) for r in rows)
        return {"vram_pct": round(100.0 * used / total, 1) if total else None,
                "cpu_pct": round(util, 1), "temp_c": round(temp, 1)}
    except Exception:
        return None

def _cockpit_ts(s):
    """ISO timestamp string -> epoch seconds (0 on anything unparseable)."""
    try:
        from datetime import datetime
        return datetime.fromisoformat(str(s)).timestamp()
    except Exception:
        return 0.0


def _cockpit_snapshot():
    """GET /api/fleet/cockpit: agents (status/current_goal/last_active), hosts (vram/cpu/temp),
    goals {total,done,in_progress,blocked}, health_score, recent_decisions (last 10),
    predicted_risks (from the forecast engine). Local file reads + cached nvidia-smi; <2s."""
    now = time.time()
    if _cockpit_cache["data"] is not None and now - _cockpit_cache["ts"] < _COCKPIT_TTL:
        return _cockpit_cache["data"]
    # -- agents: config + last activity (decision log) + first open goal (evidence-gated ledger)
    last_active = {}
    # Last group run: every seat in its cast was active until it ended (epoch seconds).
    try:
        _gr = json.load(open(os.path.join(HERE, "group_run.json"), encoding="utf-8"))
        _end = float(_gr.get("ended") or 0)
        if _end > 0:
            for nm in (_gr.get("cast") or []):
                aid = str(nm).lower()
                if aid not in last_active or _end > _cockpit_ts(last_active[aid]):
                    # +00:00 suffix: fromisoformat then reads it as UTC, not local (machine is UTC+10)
                    last_active[aid] = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(_end)) + "+00:00"
    except Exception:
        pass
    try:
        with open(os.path.join(HERE, "memory", "ops", "decision-log.jsonl"), encoding="utf-8") as f:
            for line in f.readlines()[-300:]:
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                a = str(e.get("agent") or "").lower()
                ts = e.get("timestamp")
                if a and ts and (a not in last_active or ts > last_active[a]):
                    last_active[a] = ts
    except OSError:
        pass
    # roster_monitor flags (persisted until the seat recovers) outrank derived activity
    rm_flags = {}
    try:
        _rmf = json.load(open(os.path.join(HERE, "memory", "orchestrator",
                                           ".roster_monitor_state.json"), encoding="utf-8"))
        rm_flags = _rmf.get("flags") or {}
    except Exception:
        pass
    agents_out = []
    try:
        for a in load_agents().get("agents", []):
            aid = str(a.get("id") or "").lower()
            la = last_active.get(aid)
            if aid in rm_flags:
                status = "unresponsive"   # flagged by roster_monitor; persists until recovery
            elif la is None:
                status = "unknown"
            else:
                try:
                    age_h = (now - _cockpit_ts(la)) / 3600.0
                    status = "active" if age_h < 24 else "idle"
                except Exception:
                    status = "unknown"
            agents_out.append({"name": a.get("name"), "status": status,
                               "current_goal": None, "last_active": la})
    except Exception:
        pass
    parse = _goal_parser()
    if parse is not None:
        gdir = os.path.join(HERE, "memory", "goals")
        for ag in agents_out:
            fn = os.path.join(gdir, (ag["name"] or "").lower() + ".md")
            try:
                gs = parse(fn)
                ag["total"] = len(gs)
                ag["done"] = sum(1 for g in gs if g.get("status") == "reached")
                ag["blocked"] = sum(1 for g in gs if g.get("status") == "blocked")
                for g in gs:
                    if g.get("status") == "open":
                        ag["current_goal"] = (g.get("text") or "")[:160]
                        break
            except Exception:
                continue
    # -- hosts: local seat via nvidia-smi; remote mirror hosts from config (metrics null until probed)
    hosts_out = []
    local = _cockpit_gpu_local()
    if local is not None:
        hosts_out.append({"name": "White", **local})
    try:
        cfg = json.load(open(os.path.join(HERE, "memory_mirror_hosts.json"), encoding="utf-8"))
        for h in cfg.get("hosts", []):
            hosts_out.append({"name": h.get("name"), "vram_pct": None, "cpu_pct": None, "temp_c": None})
    except Exception:
        pass
    # Circuit breaker state (Mechanic cycle-10 goal 4): MANUAL REVIEW marks surface here.
    try:
        _cbdir = os.path.join(HERE, "memory", "mechanic")
        if _cbdir not in sys.path:
            sys.path.insert(0, _cbdir)
        import circuit_breaker as _cb
        for h in hosts_out:
            c = _cb.status().get(h.get("name"))
            if c:
                h["circuit"] = c
    except Exception:
        pass
    # -- goals (evidence-gated), health score, decisions, risks
    gs = _goals_snapshot()
    open_n = sum(a.get("open", 0) for a in gs.get("agents", []))
    blocked_n = sum(a.get("blocked", 0) for a in gs.get("agents", []))
    goals = {"total": gs.get("fleet_total", 0), "done": gs.get("fleet_done", 0),
             "in_progress": max(open_n - blocked_n, 0), "blocked": blocked_n}
    health = None
    try:
        with open(os.path.join(HERE, "memory", "ops", "health-score.jsonl"), encoding="utf-8") as f:
            _hl = [json.loads(l) for l in f.readlines() if l.strip()]
        health = _hl[-1] if _hl else None
        trend = [{"ts": h.get("ts"), "score": h.get("score")} for h in _hl[-7:]]
    except Exception:
        trend = []
    decisions = []
    try:
        with open(os.path.join(HERE, "memory", "ops", "decision-log.jsonl"), encoding="utf-8") as f:
            for line in f.readlines()[-10:]:
                if line.strip():
                    decisions.append(json.loads(line))
    except Exception:
        pass
    risks = []
    try:
        fc = json.load(open(os.path.join(HERE, "memory", "goals", "next10.json"), encoding="utf-8"))
        for item in fc.get("next10", [])[:5]:
            risks.append({"agent": item.get("agent"), "goal": (item.get("goal") or "")[:120],
                          "p_reached": item.get("p_reached"), "eta": item.get("eta")})
    except Exception:
        pass
    data = {"agents": agents_out, "hosts": hosts_out, "goals": goals,
            "health_score": (health or {}).get("score"),
            "health_trend": trend,
            "recent_decisions": decisions, "predicted_risks": risks,
            "generated": time.strftime("%Y-%m-%d %H:%M:%S")}
    try:
        import json as _json
        with open(os.path.join(HERE, "memory", "ops", "fleet-mode.json"), encoding="utf-8") as _f:
            _fm = _json.load(_f)
        data["fleet_mode"] = _fm.get("mode")
        data["last_activity"] = _fm.get("timestamp")
    except Exception:
        pass
    # cycle-15 designer: pass budget + 24h mode transitions + idle tasks + freshness
    try:
        with open(os.path.join(HERE, "memory", "ops", "pass-budget.json")) as _f:
            _pb = json.load(_f)
        data["pass_budget"] = {"budget": int(_pb.get("total", 0)),
                               "consumed": int(_pb.get("used", 0))}
    except Exception:
        pass
    try:
        with open(os.path.join(HERE, "memory", "ops", "mode-transitions.jsonl")) as _f:
            _mt = [json.loads(x) for x in _f.readlines()[-50:] if x.strip()]
        def _tsec(t):
            v = t.get("ts") or t.get("timestamp") or 0
            return float(v) if isinstance(v, (int, float)) else _cockpit_ts(v)
        _cut = time.time() - 24*3600
        data["mode_transitions"] = [t for t in _mt if _tsec(t) >= _cut][-24:]
    except Exception:
        pass
    try:
        with open(os.path.join(HERE, "memory", "ops", "idle-tasks.jsonl")) as _f:
            data["idle_tasks"] = [json.loads(x) for x in _f.readlines()[-12:] if x.strip()]
    except Exception:
        pass
    try:
        import importlib.util as _ilu
        _mf_path = os.path.join(HERE, "memory", "archivist", "mode_freshness.py")
        _spec = _ilu.spec_from_file_location("mode_freshness", _mf_path)
        _mf = _ilu.module_from_spec(_spec); _spec.loader.exec_module(_mf)
        data["freshness"] = _mf.check()
    except Exception:
        pass
    # Flowtrace (2026-11-24): log mode transitions + resolve mode forecasts on every poll.
    try:
        _madir = os.path.join(HERE, "memory", "archivist")
        if _madir not in sys.path:
            sys.path.insert(0, _madir)
        import mode_anomaly
        mode_anomaly.detect()
        mode_anomaly.evaluate()
    except Exception:
        pass
    _cockpit_cache.update(ts=now, data=data)
    return data


def _fleet_health_snapshot():
    """GET /api/health/fleet (Mechanic cycle-2 goal 8): single call = full fleet picture.
    Per host: latest structured probe state + SMB sync age; plus last plain-text probe
    line, git commit freshness (overall + memory/goals/) and portal uptime. All local
    file reads - no outbound calls (fast, safe when remotes are down)."""
    hosts_cfg = []
    try:
        cfg = json.load(open(os.path.join(HERE, "memory_mirror_hosts.json"), encoding="utf-8"))
        hosts_cfg = {h["name"]: h for h in cfg.get("hosts", [])}
    except Exception:
        pass
    host_order = list(hosts_cfg) or ["Red", "Pale", "Black"]
    probe = {}
    for cand in ("memory/ops/probe-evidence.jsonl", "memory/ops/fleet-probe-history.jsonl"):
        p = os.path.join(HERE, *cand.split("/"))
        if not os.path.isfile(p):
            continue
        try:
            for line in open(p, encoding="utf-8"):
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                for r in d.get("results", []):
                    name = r.get("host") or next(
                        (n for n, h in hosts_cfg.items() if h.get("ip") == r.get("ip")), None)
                    if name:
                        probe[name] = {"ts": d.get("ts"), "port": r.get("port"),
                                       "status": r.get("status"), "severity": r.get("severity")}
        except OSError:
            continue
    last_probe_line = None
    lp = os.path.join(HERE, "fleet_probe.log")
    if os.path.isfile(lp):
        try:
            lines = [l for l in open(lp, encoding="utf-8", errors="ignore").read().splitlines() if l.strip()]
            last_probe_line = lines[-1][:200] if lines else None
        except OSError:
            pass
    sync_ts = {}
    ml = os.path.join(HERE, "memory_mirror.log")
    if os.path.isfile(ml):
        try:
            for line in open(ml, encoding="utf-8"):
                if '"results"' not in line:
                    continue
                try:
                    d = json.loads(line)
                    tdt = time.mktime(time.strptime(d.get("t", ""), "%Y-%m-%d %H:%M:%S"))
                except Exception:
                    continue
                for h in d.get("results", []):
                    if h.get("host"):
                        sync_ts[h["host"]] = tdt   # later lines overwrite -> newest wins
        except OSError:
            pass
    now = time.time()
    out_hosts = {}
    for name in host_order + ["White"]:
        if name in out_hosts:
            continue
        e = {"probe": probe.get(name), "last_sync": None, "sync_age_s": None}
        if name in sync_ts:
            e["sync_age_s"] = int(now - sync_ts[name])
            e["last_sync"] = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(sync_ts[name]))
        out_hosts[name] = e
    git_head, git_goals = None, None
    try:
        import subprocess
        r = subprocess.run([GIT_EXE, "log", "-1", "--pretty=%h %ad", "--date=format:%Y-%m-%d %H:%M"],
                           cwd=HERE, capture_output=True, text=True, timeout=10, creationflags=0x08000000)
        git_head = r.stdout.strip() or None
        r2 = subprocess.run([GIT_EXE, "log", "-1", "--pretty=%h %ad", "--date=format:%Y-%m-%d %H:%M",
                             "--", "memory/goals"],
                            cwd=HERE, capture_output=True, text=True, timeout=10, creationflags=0x08000000)
        git_goals = r2.stdout.strip() or None
    except Exception:
        pass
    return {"ok": True, "generated": time.strftime("%Y-%m-%d %H:%M:%S"),
            "hosts": out_hosts, "last_probe_line": last_probe_line,
            "git_head": git_head, "git_goals_last_change": git_goals,
            "portal_uptime_s": int(now - _SERVER_START)}


def _decisions_snapshot():
    """GET /api/decisions (Scribe cycle-2 goal 1): trace 'what did we decide about X' to the
    exact source line. Scans TODO.md + memory/synthesis/ leaves for decision-keyword lines;
    returns newest 50 with file, section, line no, detected owner(s) and date context."""
    try:
        owners = [a.get("name", "") for a in load_agents().get("agents", [])]
    except Exception:
        owners = []
    kw = re.compile(r"(?i)\b(decision|decided|ruling|ratified|ratify(ies)?d?|veto(ed)?|superseded by|approved|rejected)\b")
    out = []
    sources = [os.path.join(HERE, "TODO.md")]
    syn = os.path.join(HERE, "memory", "synthesis")
    if os.path.isdir(syn):
        sources += [os.path.join(syn, f) for f in sorted(os.listdir(syn)) if f.endswith(".md")]
    for src in sources:
        if not os.path.isfile(src):
            continue
        rel = os.path.relpath(src, HERE).replace(os.sep, "/")
        section = ""
        try:
            mtime = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(src)))
        except OSError:
            mtime = ""
        for i, line in enumerate(open(src, encoding="utf-8", errors="replace"), 1):
            s = line.strip()
            if s.startswith("## "):
                section = s[3:80]
            if not s or s.startswith("#") and len(s) < 4:
                continue
            if kw.search(s):
                found = [o for o in owners if o and re.search(r"\b" + re.escape(o) + r"\b", s)]
                out.append({"file": rel, "line": i, "section": section, "mtime": mtime,
                            "owners": found, "text": s[:300]})
    out.sort(key=lambda d: (d["mtime"], d["line"]), reverse=True)
    return {"ok": True, "count": len(out), "decisions": out[:50]}


def _rag_search(agent, query):
    """Search the agent's RAG host for `query` and format the hits. Never raises -
    a RAG hiccup must not break a chat turn. Reused by ReadMem (memory cycle)."""
    q = (query or "").strip()
    if not q:
        return ""
    try:
        payload = {"query": q[:600], "top_k": 4}
        kb = agent.get("rag_kb_id") or ""
        if kb:
            payload["kb_id"] = kb
        req = urllib.request.Request(rag_base(agent) + "/api/rag/search",
                                     data=json.dumps(payload).encode(),
                                     headers=rag_headers(agent), method="POST")
        with urllib.request.urlopen(req, timeout=25) as r:
            res = json.load(r)
    except Exception:
        return ""
    hits = (res.get("results") or res.get("hits") or res.get("chunks") or []) \
        if isinstance(res, dict) else (res if isinstance(res, list) else [])
    blocks = []
    for h in hits[:4]:
        if isinstance(h, dict):
            txt = (h.get("text") or h.get("content") or h.get("snippet") or "").strip()
            src = (h.get("source") or h.get("document") or h.get("title") or "")
        else:
            txt, src = str(h).strip(), ""
        if txt:
            blocks.append("- " + ((src + ": ") if src else "") + txt[:700])
    if not blocks:
        return ""
    return ("RETRIEVED CONTEXT (from your RAG knowledge base; use when relevant):\n"
            + "\n".join(blocks))



# ---------------------------------------------------------------- local memory index + recall (2026-11-18)
_MEM_STOP = set("a an and are as at be but by for from had has have he her his i if in into is it its me my no not of on or our she so that the their them they this to was we were what when where which who will with you your about after again all also any because been before being between both can could did do does doing down during each few here how him herself himself more most other out over own same some such than then there those through too under until up very while within without would should may might must shall".split())
_MEM_IDX_CACHE = {"sig": None, "idx": {}}

def _mem_local_index():
    """Inverted term->[(file,line)] index over MEMORY.md, TODO.md, memory/**/*.md.
    Rebuilt only when the (mtime,size) signature changes. Never raises."""
    try:
        files = []
        for cand in ("MEMORY.md", "TODO.md"):
            p = os.path.join(HERE, cand)
            if os.path.isfile(p):
                files.append((cand, p))
        mdir = os.path.join(HERE, "memory")
        if os.path.isdir(mdir):
            for root, _d, fs in os.walk(mdir):
                for f in sorted(fs):
                    if f.endswith(".md"):
                        p = os.path.join(root, f)
                        files.append((os.path.relpath(p, HERE).replace(os.sep, "/"), p))
        sig, idx = [], {}
        for rel, p in files:
            try:
                stt = os.stat(p)
                sig.append(rel + ":" + str(int(stt.st_mtime)) + ":" + str(stt.st_size))
                for n, line in enumerate(open(p, encoding="utf-8", errors="replace").read().splitlines(), 1):
                    t = line.strip()
                    if len(t) < 4:
                        continue
                    for w in set(re.findall(r"[a-z0-9_]{3,}", t.lower())):
                        idx.setdefault(w, []).append((rel, n))
            except Exception:
                continue
        s = "|".join(sorted(sig))
        if _MEM_IDX_CACHE["sig"] != s:
            _MEM_IDX_CACHE.update(sig=s, idx=idx)
    except Exception:
        pass
    return _MEM_IDX_CACHE.get("idx") or {}


_UNDERSTANDING = None
def _understanding():
    """Lazy-load memory/researcher/understanding.py (never raises)."""
    global _UNDERSTANDING
    if _UNDERSTANDING is None:
        try:
            import importlib.util
            _p = os.path.join(HERE, "memory", "researcher", "understanding.py")
            spec = importlib.util.spec_from_file_location("agent_understanding", _p)
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _UNDERSTANDING = mod
        except Exception:
            _UNDERSTANDING = False
    return _UNDERSTANDING or None


def _mem_local_hits(messages, k=6):
    """Look up every keyword of the latest prompt in the local index; score lines by
    matched-term count; return a compact MEMORY INDEX HITS block (M1..Mk with file:line
    refs) for pre-context, or '' when nothing matches. Never raises."""
    try:
        q = ""
        for m in reversed(messages or []):
            c = (m.get("content") or "").strip()
            if c and (m.get("speaker") or "").strip().lower() == "you":
                q = c
                break
        if not q:
            for m in reversed(messages or []):
                c = (m.get("content") or "").strip()
                if c:
                    q = c
                    break
        words = [w for w in re.findall(r"[a-z0-9_]{3,}", q.lower()) if w not in _MEM_STOP]
        if not words:
            return ""
        # SYNONYMS (2026-11-18): expand each key term via the understanding module so
        # index lookups also catch near-synonyms used in memory files.
        _u = _understanding()
        if _u is not None:
            try:
                for w in set(words):
                    words.extend(x for x in _u.synonyms(w) if x not in _MEM_STOP)
            except Exception:
                pass
        score = {}
        idx = _mem_local_index()
        for w in set(words):
            for key in idx.get(w, []):
                score[key] = score.get(key, 0) + 1
        top = sorted(score.items(), key=lambda kv: (-kv[1], kv[0]))[:k]
        if not top:
            return ""
        out = ["MEMORY INDEX HITS (local memory files; fetch these refs with your tools when needed):"]
        for i, ((rel, n), sc) in enumerate(top, 1):
            try:
                txt = open(os.path.join(HERE, rel.replace("/", os.sep)), encoding="utf-8", errors="replace").read().splitlines()[n - 1].strip()[:110]
            except Exception:
                txt = ""
            out.append("M%d %s:%d (%dx) %s" % (i, rel, n, sc, txt))
        return "\n".join(out)
    except Exception:
        return ""


def _mem_recall_round(agent, messages, full):
    """POST-PROMPT recall (2026-11-18): after the main reply, one cheap aux round asks the
    LLM which MEMORY INDEX HITS (by M-number) actually matter for this prompt and distills
    them into <=3 bullet facts; stored via _append_hot_note so later ReadMem rounds see it.
    Never raises; degrades to a no-op."""
    try:
        block = _mem_local_hits(messages)
        if not block or not (full or "").strip():
            return
        latest = ""
        for m in reversed(messages or []):
            c = (m.get("content") or "").strip()
            if c and (m.get("speaker") or "").strip().lower() == "you":
                latest = c[:300]
                break
        sysp = ("You are a memory-recall assistant. The HITS below are indexed lines from the "
                "project's local memory files, tagged M1..Mn with file:line refs. Given the prompt "
                "and the agent's reply, pick the hits genuinely relevant to this exchange and output "
                "at most 3 bullet facts, each citing its M-number and ref. If none matter, output "
                "exactly NONE.")
        out = _aux_chat(agent, sysp, "PROMPT:\n" + latest + "\n\nAGENT REPLY:\n" + full[:500] + "\n\nHITS:\n" + block, 220).strip()
        if not out or out.upper().startswith("NONE"):
            return
        _append_hot_note("RECALL: " + out[:400].replace("\n", " | "))
    except Exception:
        return



def rag_prefetch(agent, messages):
    """If the agent has RAG on, pull relevant docs and fold them into the system
    prompt. Never raises - a RAG hiccup must not break a chat turn."""
    if not agent.get("rag"):
        return ""
    q = ""
    for m in reversed(messages or []):
        c = (m.get("content") or "").strip()
        if c and (m.get("speaker") or "").strip().lower() == "you":
            q = c
            break
    if not q:
        for m in reversed(messages or []):
            c = (m.get("content") or "").strip()
            if c:
                q = c
                break
    return _rag_search(agent, q)


def load_agents():
    with _lock:
        if os.path.exists(AGENTS_FILE):
            try:
                return json.load(open(AGENTS_FILE, encoding="utf-8"))
            except Exception:
                pass
    seed = {"agents": [
        {"id": "a-nova", "name": "Nova", "emoji": "\U0001F680", "color": "#3ddc84",
         "model_id": "unsloth/Qwen3.5-9B-GGUF", "temperature": 0.7, "max_tokens": 0,
         "reasoning": "default", "tools": [], "run_tools_locally": True, "max_tool_calls": 0,
         "rag": False, "rag_kb_id": "",
         "blurb": "Product-minded helper; concise and practical.",
         "persona": "You are Nova, a product-minded assistant. Be concise, concrete and practical. Prefer short paragraphs and bullet points."},
        {"id": "a-iris", "name": "Iris", "emoji": "\U0001F3AF", "color": "#b98cff",
         "model_id": "unsloth/gpt-oss-20b-gguf", "temperature": 0.9, "max_tokens": 0,
         "reasoning": "default", "tools": [], "run_tools_locally": True, "max_tool_calls": 0,
         "rag": False, "rag_kb_id": "",
         "blurb": "Creative writer; vivid and playful.",
         "persona": "You are Iris, a creative writer. Be vivid, playful and imaginative. Vary sentence rhythm and use concrete imagery."},
    ]}
    with _lock:
        json.dump(seed, open(AGENTS_FILE, "w", encoding="utf-8"), indent=2)
    return seed


def save_agents(data):
    with _lock:
        json.dump(data, open(AGENTS_FILE, "w", encoding="utf-8"), indent=2, ensure_ascii=False)


def get_agent(aid):
    for a in load_agents()["agents"]:
        if a["id"] == aid:
            return a
    return None


def build_system_prompt(agent, mode, all_agents, rag_context="", shared_memory="",
                        kind="prompt", lookup_context=""):
    parts = [agent.get("persona", "").strip()]
    if mode == "group":
        others = [f"- {a['name']}: {a.get('blurb') or a.get('persona','')[:120]}"
                  for a in all_agents if a["id"] != agent["id"]]
        lines = ["You are one of several AI agents sharing this group chat.",
                 "Other agents present:"] + others + ["Rules:"]
        if kind == "prompt":
            # First phase: the human's new message is addressed to the WHOLE group, so
            # every agent in the cast is expected to answer. (Previously the cross-talk
            # silence rules leaked here and Quinn went [SILENT] on ordinary greetings.)
            lines += [
              "- A new human message was just sent to the WHOLE group; other agents may have answered already.",
              "- Give your own brief response from your perspective (2-4 sentences). Do NOT reply [SILENT]",
              "  just because another agent already replied - only stay silent if the message clearly targets that other agent exclusively.",
            ]
        else:
            lines += [
              "- Reply only when directly addressed, or when you can add real value to the latest message.",
              "- If you have nothing meaningful to add to the latest message, reply with exactly [SILENT] - an empty"
              "  reply is never acceptable; the single token [SILENT] IS your silence.",
              "- When another agent just answered well, stay brief or do not repeat them.",
              "- Satisfaction check: when the discussion has reached a natural conclusion (you agree, or both",
              "  sides have fully stated their positions and nothing new remains), start your reply with",
              "  [CONCLUDED] followed by ONE sentence summarizing the outcome - this ends the round for everyone.",
            ]
        lines += [
             "- You MAY respond to another agent's message (challenge it, build on it),",
             f"  but the group allows at most {XTALK_LIMIT} agent-to-agent replies per human prompt;",
             f'  a member saying "{RESET_PHRASE}" resets that counter.',
             "- You MUST respond when another agent addresses you by name or asks you a question directly.",
             "- Private messages: write [DM @Name] ... to send text that ONLY that agent can see "
             "(everyone else sees a lock chip). Use for direct questions or sensitive hand-offs; "
             "text outside the markers stays public.",
             "- Project memory is modular: memory/INDEX.md is the pointer map. With python/terminal tools",
             "  (if enabled), grep it and read only the module you need - never paste whole modules into chat.",
             "- Keep replies short (2-4 sentences) unless asked to expand.",
             "- Address other agents by name when replying to them.",
             "- NO HUMAN GATES: never mark a lane 'blocked pending human action' or create a decision",
             "  gate for the human. If something is blocked, state the exact unblock step ONCE, then take",
             "  the best available alternative (different path, different tool, or delegate to another",
             "  agent by name) and keep working. The human only sets goals and reviews results -",
             "  they do not unblock lanes.",
             "- Project files follow the memory/ modularity rule (memory/portal/file-modularity.md):",
             "  keep every working file small enough for a small-context model to read whole; split big",
             "  ones into modules with header pointers to parent/sibling. index.html is markup-only -",
             "  its UI lives in ui/app.css, ui/core.js, ui/uploads.js (edit those, then advance the pin).",
             "- Goal lines: the ONLY form the Goals dashboard counts as blocked is an explicit",
             "  '(blocked: exact unblock step)' tag or [BLOCKED] on that line - plain prose containing",
             "  the word 'blocked' does not count."]
        parts.append("\n".join(lines))
    if agent.get("tools"):
        # 2026-11-10: group test "build a calculator app" - both agents CLAIMED builds ("Built and
        # rendered above") but never called a tool; no file existed on disk. Tool discipline rule.
        # 2026-11-11: tools actually run in Studio's shared sandbox (SANDBOX_DIR), not the project
        # workspace; agents must report RELATIVE paths so the portal can turn them into links.
        parts.append(
            "TOOLS: you have local tools (" + ", ".join(agent["tools"]) + ") that run on this host."
            " When the human asks you to build, create, or modify a file/app/snippet, DO IT with your"
            " tools - write real files into your working directory. Never say something is 'built',"
            " 'rendered', or 'done' unless a tool call in THIS reply succeeded; if a tool fails, say"
            " exactly what failed and what is still missing."
            " Your tool working directory is a shared agent folder: the human reaches your files"
            " through the portal by RELATIVE path (e.g. calculator-app/index.html). When reporting"
            " created files, use exactly that relative form as shown in your tool results - never"
            " invent drive letters or absolute paths. If you ever reported an absolute path or a"
            " drive letter (e.g. Z:\\...), it was wrong: restate that file by its relative path from"
            " your working directory. PINNED FILES (2026-11-16): index.html is pinned in memory_mirror.py"            " (PIN_FILES) - edits to it are REVERTED on the next mirror cycle unless you advance the pin:"            " copy the new file to memory/designer/index_html_CANONICAL_<sha12>_YYYY-MM-DDx.html, update"            " PIN_FILES in memory_mirror.py to the new sha12 (first 12 of sha1) + backup path, and commit."            " Never re-apply reverted work without repinning - that is the clobber loop.")
    # PORTAL FILE/TERMINAL API (2026-11-25): every agent can operate on the files the portal lists
    # via [[PORTAL-API]] blocks in its replies. Mutating calls queue for approval; reads run sync.
    parts.append(
        "PORTAL FILE/TERMINAL API: you can operate on ANY file the portal lists by emitting a"
        " [[PORTAL-API]] block in your reply - one JSON call per line, executed when your turn ends."
        " Example: [[PORTAL-API]] {\"call\":\"requestChange\",\"args\":{\"file\":\"agent_portal.py\","
        "\"range\":[34,502],\"linesToReplace\":[\"new line one\",\"new line two\"],\"note\":\"why\"}} [[/PORTAL-API]]"
        " Queued (applied after approval): requestChange{file,range[a..b] 1-based inclusive,linesToReplace[],note?} ·"
        " reqCreateFile{file,content,note?} · reqDeleteFile{file,note?} · runCMD|runTerminalReq{command,note?}."
        " Sync reads: reqReadFile{file,range?} (16KB cap) · listPortalFiles() · viewRequestQueue() ·"
        " viewTerminalQueue() · getReqInfo{reqID} · editReq{reqID, range?/linesToReplace?/content?/note?} ·"
        " cancelReq{reqID} · getReqHistory[n or [a..b]] · viewTerminalOutput{reqID} · getQueueStats()."
        " approveReq{reqID}/rejectReq{reqID,reason?} work only for configured approvers."
        " Rules: reqReadFile FIRST so your range matches the CURRENT lines; queued calls return a reqID -"
        " report it and do NOT re-submit; outcomes arrive as PORTAL API RESULTS on your next turn."
        " Full reference (read with your tools if enabled): memory/portal/api-reqs.md")
    if shared_memory:
        parts.append("SHARED GROUP MEMORY (global file memory.md, visible to all agents):\n"
                     + shared_memory.strip())
    if rag_context:
        parts.append(rag_context)
    if lookup_context:   # ReadMem output (2026-11-14): unlabelled, so solo/DM stays clean
        parts.append(lookup_context)
    return "\n".join(parts)


# ---------------------------------------------------------------- private messaging
# [DM @Name] ... opens a private segment visible ONLY to that agent (and its sender).
# Privacy is enforced HERE at prompt-build time: every /api/chat request gets the viewer's
# own redacted view of the thread, so remote agents on other hosts never see foreign DMs.

def parse_dm_segments(text):
    """Split a reply into [(kind, target, body)]: ("public", None, str) and ("dm", target_lower, str).
    A [DM @Name] marker opens a private segment running to the next marker or end of text;
    text before the first marker is public. Marker syntax is case-insensitive; empty segments
    are dropped. No markers -> single public segment (or [])."""
    t = (text or "").strip("\n")
    if not t.strip():
        return []
    marks = [(m.start(), m.end(), m.group(1).strip().lstrip("@").strip().lower())
             for m in re.finditer(r"\[DM\b\s*@?\s*([^\]\n]+?)\s*\]", t, re.I)]
    if not marks:
        return [("public", None, t)]
    segs = []
    prev = 0
    for i, (s, e, target) in enumerate(marks):
        pub = t[prev:s].strip()
        if pub:
            segs.append(("public", None, pub))
        end = marks[i + 1][0] if i + 1 < len(marks) else len(t)
        body = t[e:end].strip()
        if body.strip():
            segs.append(("dm", target, body))
        prev = end
    return segs


def render_dm_view(segs, viewer_name, sender_name):
    """Render parsed segments as the text a given agent should see: public text untouched,
    DMs addressed to the viewer in full (labelled private), everything else a lock chip."""
    vn = (viewer_name or "").lower()
    out = []
    for kind, target, body in segs:
        if kind == "public":
            out.append(body)
        elif target == vn:
            out.append("[Private message from %s]: %s" % (sender_name, body))
        else:
            out.append("\U0001F512 [private message to %s]" % target)
    return "\n".join(out).strip()


def to_openai_messages(agent, messages, mode, all_agents, rag_context="", shared_memory="",
                       kind="prompt", lookup_context=""):
    _sysp = build_system_prompt(agent, mode, all_agents, rag_context,
                                shared_memory, kind, lookup_context)
    try:
        if mode == "group":
            _fb = _forecast_block(agent.get("name"))
            if _fb:
                _sysp += "\n" + _fb
            _lb = _agent_lane_block(agent.get("name"))
            if _lb:
                _sysp += "\n" + _lb
    except Exception:
        pass
    msgs = [{"role": "system", "content": _sysp}]
    def _human(m):
        spk = (m.get("speaker") or "").strip()
        # Leniency: raw API clients send role=="user" without a speaker field;
        # the browser always sends speaker "You", so behavior is unchanged there.
        return spk.lower() == "you" or (not spk and (m.get("role") or "").lower() == "user")

    last_user = -1
    for i, m in enumerate(messages):
        if _human(m):
            last_user = i
    for i, m in enumerate(messages):
        who = (m.get("speaker") or "").strip()
        content = (m.get("content") or "").strip()
        if not content:
            continue
        if _human(m):
            shown = content
            if mode == "group":
                # Human-typed [DM @Name]: same per-viewer redaction as agent DMs - each
                # agent sees public text + DMs addressed to them only; others see a lock
                # chip. Unknown targets fail-open (no redaction) so content is never lost.
                segs = parse_dm_segments(content)
                dms = [t for k, t, b in segs if k == "dm"]
                if dms:
                    known = {a["name"].lower() for a in all_agents}
                    if all(t in known for t in dms):
                        shown = render_dm_view(segs, agent["name"], who or "You")
            msgs.append({"role": "user", "content": shown})
        else:
            if i > last_user:
                # Own past replies stay as assistant turns (continuity).
                # In group mode, OTHER agents' words must be user-role: if a
                # foreign reply lands as the final assistant turn, the model
                # sees no open user prompt and emits nothing (empty bubble).
                own = (mode != "group") or (who.lower() == agent["name"].lower())
                role = "assistant" if own else "user"
                prefix = "" if own else f"[{who}]: "
                shown = content
                if not own and mode == "group":
                    # DM redaction: the viewer sees public text + DMs addressed to them only.
                    # Unknown targets (not in the roster) disable redaction for this message -
                    # a [DM @Nobody] is just text, and hiding it would lose content for everyone.
                    segs = parse_dm_segments(content)
                    dms = [t for k, t, b in segs if k == "dm"]
                    if dms:
                        known = {a["name"].lower() for a in all_agents}
                        if all(t in known for t in dms):
                            shown = render_dm_view(segs, agent["name"], who)
                msgs.append({"role": role, "content": prefix + shown})
    return msgs


# ---------------------------------------------------------------- shared memory

# ---------------------------------------------------------------- user message queue (2026-11-15)
# Human messages sent while the group is working land in USER_MSGS_FILE instead of being
# dropped. Every group prompt build (prompt phase AND cross-talk rounds) injects this
# agent's pending in-scope entries into its system prompt and marks them seen for that
# agent once the request reaches Studio. @Name entries are private: only the named agent
# sees/checks them. The frontend polls /api/user-messages for the spinner state.
_umq_lock = threading.Lock()

def _umq_read():
    try:
        with open(USER_MSGS_FILE, encoding="utf-8") as fh:
            d = json.load(fh)
        if isinstance(d, dict) and isinstance(d.get("messages"), list):
            return d
    except Exception:
        pass
    return {"messages": []}

def _umq_write(d):
    tmp = USER_MSGS_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, ensure_ascii=False)
    os.replace(tmp, USER_MSGS_FILE)

def _umq_scope(m, all_names):
    """Agents an entry is addressed to (empty mentions = broadcast). Unknown names drop out."""
    names = m.get("mentions") or list(all_names)
    return [n for n in names if n in all_names]

def umq_add(text, mentions=None):
    text = (text or "").strip()[:20000]
    if not text:
        return None
    with _umq_lock:
        d = _umq_read()
        entry = {"id": "um-%s-%s" % (time.strftime("%Y%m%d-%H%M%S"), uuid.uuid4().hex[:6]),
                 "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                 "text": text,
                 "mentions": [str(x).strip() for x in (mentions or []) if str(x).strip()],
                 "checked": {}}
        d["messages"].append(entry)
        while len(d["messages"]) > UMQ_MAX:
            d["messages"].pop(0)
        _umq_write(d)
    return entry

def umq_pending_for(name, all_names):
    """Entries addressed to `name` that it has not seen yet."""
    with _umq_lock:
        d = _umq_read()
        out = []
        for m in d["messages"]:
            if name not in _umq_scope(m, all_names):
                continue
            if (m.get("checked") or {}).get(name):
                continue
            out.append(m)
    return out

def umq_check(ids, name, all_names=None):
    """Mark entries seen. name='*' marks every in-scope agent (frontend delivery pass)."""
    ids = [i for i in (ids or []) if isinstance(i, str)]
    if not ids:
        return 0
    with _umq_lock:
        d = _umq_read()
        n = 0
        for m in d["messages"]:
            if m.get("id") not in ids:
                continue
            if name == "*":
                if all_names:
                    targets = _umq_scope(m, all_names)
                else:
                    targets = m.get("mentions") or list((m.get("checked") or {}).keys())
            else:
                targets = [name]
            for t in targets:
                if not (m.get("checked") or {}).get(t):
                    m.setdefault("checked", {})[t] = True
                    n += 1
        if n:
            _umq_write(d)
    return n

def umq_view(all_names):
    """Latest entries + derived `processed` (every in-scope agent has seen it)."""
    with _umq_lock:
        d = _umq_read()
        out = []
        for m in d["messages"][-50:]:
            scope = _umq_scope(m, all_names)
            chk = m.get("checked") or {}
            mm = dict(m)
            mm["processed"] = (not scope) or all(chk.get(n2) for n2 in scope)
            out.append(mm)
    return out

# ---------------------------------------------------------------- chat history + run state (2026-11-15)
# Per-mode history persisted server-side so a browser refresh does not wipe the conversation;
# run_state.json carries a heartbeat while a run is busy so a reload can offer resume.
def _load_history(mode):
    path = CHAT_HISTORY_FILES.get(mode)
    if not path:
        return []
    try:
        with open(path, encoding="utf-8") as fh:
            d = json.load(fh)
        h = d.get("history") if isinstance(d, dict) else d
        if isinstance(h, list):
            return [x for x in h if isinstance(x, dict) and x.get("speaker")]
    except Exception:
        pass
    return []

def _save_history(mode, history):
    path = CHAT_HISTORY_FILES.get(mode)
    if not path:
        return False
    try:
        clean = []
        for x in (history or [])[-HIST_MAX:]:
            if isinstance(x, dict) and x.get("speaker"):
                clean.append({"speaker": str(x["speaker"])[:100],
                              "content": str(x.get("content", ""))[:20000]})
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump({"history": clean}, fh, ensure_ascii=False)
        os.replace(tmp, path)
        return True
    except Exception:
        return False

def _load_run_state():
    try:
        with open(RUN_STATE_FILE, encoding="utf-8") as fh:
            d = json.load(fh)
        if isinstance(d, dict):
            return d
    except Exception:
        pass
    return {"busy": False}

def _save_run_state(d):
    try:
        tmp = RUN_STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(d if isinstance(d, dict) else {"busy": bool(d)}, fh)
        os.replace(tmp, RUN_STATE_FILE)
    except Exception:
        pass

def load_memory():
    """Return (file_text, state) for the global memory.md. Creates it if missing."""
    with _lock:
        try:
            text = open(MEMORY_FILE, encoding="utf-8").read().strip()
        except Exception:
            text = ""
    st = {"inter_agent_replies": 0, "last_reset_by": "", "infinite_budget": True}
    m = _STATE_RE.search(text)
    if m:
        try:
            d = json.loads(m.group(1))
            st["inter_agent_replies"] = max(0, int(d.get("inter_agent_replies", 0)))
            st["last_reset_by"] = str(d.get("last_reset_by") or "")[:60]
            if "infinite_budget" in d:   # key absent (old files) = ON: unlimited by default
                st["infinite_budget"] = bool(d["infinite_budget"])
        except Exception:
            pass
    if not text:
        _write_memory(_MEMORY_TEMPLATE, st)
        return _MEMORY_TEMPLATE, st
    return text, st


def _write_memory(text, st):
    """Persist counter state: rewrite the state line + Counter section, keep the rest."""
    inf = bool(st.get("infinite_budget", True))
    state_line = "<!-- state: %s -->" % json.dumps(
        {"inter_agent_replies": st["inter_agent_replies"],
         "last_reset_by": st["last_reset_by"],
         "infinite_budget": inf}, ensure_ascii=False)
    if _STATE_RE.search(text):
        text = _STATE_RE.sub(lambda _: state_line, text, count=1)
    else:
        text = state_line + "\n" + text
    cap = "∞" if inf else XTALK_LIMIT
    block = ("## Counter\n"
             f"- inter_agent_replies_this_prompt: {st['inter_agent_replies']} / {cap}\n"
             f"- last_reset_by: {st['last_reset_by'] or '—'}\n")
    if "## Counter" in text:
        # `\n?` tolerates a final counter line without trailing newline (load strips it).
        text = re.sub(r"## Counter\n(?:- .+\n?)*", block, text, count=1)
    else:
        text = text.rstrip() + "\n\n" + block
    with _lock:
        open(MEMORY_FILE, "w", encoding="utf-8").write(text)


def _read_state_unlocked():
    """Parse the state line from memory.md. Caller must hold _lock."""
    text = ""
    try:
        text = open(MEMORY_FILE, encoding="utf-8").read().strip()
    except Exception:
        pass
    st = {"inter_agent_replies": 0, "last_reset_by": "", "infinite_budget": True}
    m = _STATE_RE.search(text)
    if m:
        try:
            d = json.loads(m.group(1))
            st["inter_agent_replies"] = max(0, int(d.get("inter_agent_replies", 0)))
            st["last_reset_by"] = str(d.get("last_reset_by") or "")[:60]
            if "infinite_budget" in d:   # key absent (old files) = ON: unlimited by default
                st["infinite_budget"] = bool(d["infinite_budget"])
        except Exception:
            pass
    return text, st


def _reset_counter():
    """Atomically zero the shared counter (new human prompt). Returns fresh state.
    Idempotent, so all agents of a PARALLEL prompt phase can fire it at once.
    Preserves infinite_budget - a reset must not silently re-cap the budget."""
    with _lock:
        text, st = _read_state_unlocked()
        st["inter_agent_replies"] = 0
        st["last_reset_by"] = ""
        _write_memory(text, st)
        return st


def _bump_counter(agent_name, kind, text):
    """Atomic read-modify-write of the shared counter after a group reply.
    The whole RMW happens inside ONE lock hold, so simultaneous replies from
    parallel agent streams can never lose an increment (old code read N in two
    threads and both wrote N+1). Returns the new state."""
    with _lock:
        text_file, st = _read_state_unlocked()
        if RESET_PHRASE in text.lower():
            st["inter_agent_replies"] = 0
            st["last_reset_by"] = agent_name[:60]
        elif kind == "cross-talk":
            st["inter_agent_replies"] += 1
        _write_memory(text_file, st)
        return st


def _shared_memory_block(st):
    """Compact view of the shared counter from memory.md, injected into every
    agent's prompt so all agents see the same state."""
    inf = bool(st.get("infinite_budget", True))
    lines = ["SHARED GROUP MEMORY (global file memory.md - visible to ALL agents):",
             f"- inter_agent_replies_this_prompt: {st['inter_agent_replies']} / {'∞ (unlimited)' if inf else XTALK_LIMIT}"]
    if st.get("last_reset_by"):
        lines.append(f"- last_reset_by: {st['last_reset_by']}")
    if inf:
        lines.append('Rule: agent-to-agent replies are UNLIMITED this prompt (infinite budget ON). '
                     'End the discussion when it is settled - reply [CONCLUDED] once the task is done, '
                     'or [SILENT] when you have nothing new to add.')
    else:
        lines.append('Rule: at most %d agent-to-agent replies per human prompt; a member saying "%s" resets the counter.'
                     % (XTALK_LIMIT, RESET_PHRASE))
    idx = _index_block()
    if idx:
        lines.append("MEMORY MAP (pointer index - open a module only when you need its detail):")
        lines.append(idx)
    lp = _live_plan_block()
    if lp:   # STEP 4: live goal + project state, so agents don't need file access for the plan
        lines.append(lp)
    return "\n".join(lines)


def _index_block():
    """Compact pointer map injected into group prompts instead of full notes."""
    try:
        t = open(os.path.join(MEMORY_DIR, "INDEX.md"), encoding="utf-8").read().strip()
        # 2026-11-23: budget raised 1600->2400 so the full lane+module pointer map survives
        # injection (the forecast/goals pointers must be visible to every seat).
        return t[:2400]
    except Exception:
        return ""


def _live_plan_block():
    """Live plan injected into group prompts (file-access STEP 4, approved 2026-11-13):
    the top section of TODO.md (the live goal) + MEMORY.md's GOAL line, so every agent sees
    what the project is currently doing even when its host's sandbox mirror lags. Both reads
    are capped for prompt budget; any failure -> "" (a missing plan must never break chat)."""
    out = []
    try:
        t = open(os.path.join(HERE, "TODO.md"), encoding="utf-8").read()
        m = re.search(r"^## .+?(?=^## |\Z)", t, re.M | re.S)
        if m:
            out.append("LIVE PLAN (top of TODO.md - what this project is working on right now):"
                       "\n" + m.group(0).strip()[:1200])
    except Exception:
        pass
    try:
        t = open(os.path.join(HERE, "MEMORY.md"), encoding="utf-8").read()
        m = re.search(r"^## GOAL.*?(?=^## |\Z)", t, re.M | re.S)
        if m:
            out.append("PROJECT STATE (MEMORY.md goal line):"
                       "\n" + m.group(0).strip()[:600])
    except Exception:
        pass
    return "\n\n".join(out)


def _ack_nudge(agent, messages, kind="cross-talk", all_agents=None):
    """Deterministic ack nudge (not model judgment).
    prompt:     fires when the HUMAN named this agent in their latest message.
    cross-talk: fires when another agent named this agent since the last human message,
                or sent them a [DM @Name] private message. DMs to OTHER agents are
                redacted before the name scan, so a foreign DM's content can't nudge you."""
    name = re.escape(agent["name"])
    msgs = messages or []
    users = [i for i, m in enumerate(msgs) if (m.get("speaker") or "").strip().lower() == "you"]
    if kind == "prompt":
        if users and re.search(rf"\b{name}\b", msgs[users[-1]].get("content") or "", re.I):
            return "NOTE: The human addressed you by name in their latest message - respond."
        return ""
    start = users[-1] + 1 if users else 0
    for m in reversed(msgs[start:]):
        who = (m.get("speaker") or "").strip()
        if not who or who.lower() == agent["name"].lower():
            continue
        c = m.get("content") or ""
        segs = parse_dm_segments(c)
        dms = [t for k, t, b in segs if k == "dm"]
        if dms and agent["name"].lower() in dms:
            return ("NOTE: %s sent you a PRIVATE message - respond briefly to it; its content "
                    "is visible only to the two of you." % who)
        if dms and all_agents is not None:
            known = {a["name"].lower() for a in all_agents}
            if all(t in known for t in dms):
                c = render_dm_view(segs, agent["name"], who)   # redact foreign DMs before the name scan
        if re.search(rf"\b{name}\b", c, re.I):
            return ("NOTE: %s addressed you by name in their latest message - respond briefly "
                    "unless you have nothing to add ([SILENT])." % who)
    return ""


def _safe_memory_file(rel):
    """Resolve a relative path inside MEMORY_DIR. Returns abs path or None (no traversal)."""
    rel = (rel or "").replace("\\", "/").lstrip("/")
    if not rel:
        return None
    base = os.path.realpath(MEMORY_DIR)
    full = os.path.realpath(os.path.join(base, rel))
    if full != base and not full.startswith(base + os.sep):
        return None
    return full if os.path.isfile(full) else None


def _safe_workspace_file(rel):
    """Resolve a relative path inside HERE or the Studio agent sandbox (SANDBOX_DIR). Returns abs
    path or None (no traversal). Used by /api/file and /api/file/raw so agents' replies can link to
    files they created - those land in the sandbox, not HERE (2026-11-11)."""
    rel = (rel or "").replace("\\", "/").lstrip("/")
    if not rel or "\0" in rel:
        return None
    for base in (os.path.realpath(HERE), os.path.realpath(SANDBOX_DIR)):
        full = os.path.realpath(os.path.join(base, rel))
        if full != base and not full.startswith(base + os.sep):
            continue
        if os.path.exists(full):  # files AND folders (folder refs get a listing peek)
            return full
    return None


# ---------------------------------------------------------------- per-message memory cycle (2026-11-14)

def _aux_chat(agent, system, user, max_tokens):
    """One NON-streaming auxiliary LLM round on the agent's own Studio host
    (low reasoning, tiny budget, short timeout). Returns content; "" on ANY failure."""
    try:
        body = {"model": (_seat_now() or {}).get("model") or agent["model_id"],
                "messages": [{"role": "system", "content": system},
                             {"role": "user", "content": user}],
                "max_tokens": max_tokens,
                "temperature": 0.0,
                "stream": False,
                "enable_thinking": True,
                "reasoning_effort": FIRST_REPLY_REASONING}
        req = urllib.request.Request(studio_base(agent) + "/v1/chat/completions",
                                     data=json.dumps(body).encode(),
                                     headers=studio_headers(agent))
        with urllib.request.urlopen(req, timeout=30) as r:
            res = json.load(r)
        return ((res.get("choices") or [{}])[0].get("message") or {}).get("content") or ""
    except Exception:
        return ""


def _mem_lookup_round(agent, messages):
    """READMEM: one cheap aux round BEFORE the main reply. A router call sees the incoming
    message + memory map + current hot notes and emits ONE search query (or NONE); the fetch
    reuses _rag_search. Current hot notes are always included in the output so STOREMEM's
    notes feed back into later rounds (closing the loop). Returns a context block or ""; any
    failure degrades to "" - ReadMem must never break or hang the main turn."""
    try:
        latest = ""
        for m in reversed(messages or []):
            c = (m.get("content") or "").strip()
            if c:
                latest = c[:600]
                break
        if not latest:
            return ""
        idx = _index_block()[:800]
        notes = _hot_notes_block()[:600]
        parts = []
        if notes:
            parts.append("HOT NOTES (shared memory.md, newest last):\n" + notes)
        sysp = ("You are the memory-lookup router for agent %s. Decide whether the incoming "
                "message needs anything MORE from project memory than the hot notes shown. "
                "Reply with EXACTLY ONE line: a short search query of at most 8 words, or "
                'NONE if the hot notes and map already cover it.' % agent.get("name", "?"))
        user = "MEMORY MAP:\n" + (idx or "(empty)")
        if notes:
            user += "\n\nHOT NOTES:\n" + notes
        user += "\n\nINCOMING MESSAGE:\n" + latest
        out = _aux_chat(agent, sysp, user, MEM_LOOKUP_MAX_TOKENS)
        q = " ".join(out.split())[:120]
        if q and not q.upper().startswith("NONE"):
            ctx = _rag_search(agent, q)   # ReadMem reuses the RAG fetch path
            if ctx:
                parts.append(ctx.replace(
                    "RETRIEVED CONTEXT (from your RAG knowledge base; use when relevant):",
                    'LOOKED-UP MEMORY (query: "%s"): ' % q[:80]))
        return "\n\n".join(parts)
    except Exception:
        return ""


def _mem_store_round(agent, messages, reply):
    """STOREMEM: one cheap aux round AFTER the main reply. Distills at most ONE durable note
    (<= HOT_NOTE_CHARS chars) about what just happened; "" when nothing is worth storing or
    on any failure."""
    try:
        tail = []
        for m in (messages or [])[-6:]:
            c = (m.get("content") or "").strip()
            if c:
                tail.append("%s: %s" % ((m.get("speaker") or "?")[:20], c[:300]))
        sysp = ("You are the memory keeper for agent %s. From this exchange, decide whether "
                "there is ONE fact worth remembering for future rounds (a decision made, a "
                "task completed, an open question, a correction). Reply with EXACTLY ONE line: "
                "the note in at most 140 characters, no preamble - or NONE if nothing is "
                "durable enough to store." % agent.get("name", "?"))
        user = ("\n".join(tail) if tail else "(no earlier messages)") + \
               "\n\nYOUR REPLY:\n" + (reply or "")[:600]
        out = _aux_chat(agent, sysp, user, MEM_STORE_MAX_TOKENS)
        note = " ".join(out.split())
        if not note or note.upper().startswith("NONE"):
            return ""
        return note[:HOT_NOTE_CHARS]
    except Exception:
        return ""


def _hot_notes_block():
    """The '## Hot Notes' section of memory.md (newest last), or "" if absent."""
    with _lock:
        text, _st = _read_state_unlocked()
    m = re.search(r"## Hot Notes\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1).strip() if m else ""


def _append_hot_note(note):
    """Atomically append one hot note to memory.md: dedupe (case-insensitive), keep only the
    newest HOT_NOTE_MAX, rewrite via _write_memory so the state line + Counter stay intact.
    Returns True if stored, False on duplicate/empty. Never raises."""
    body = " ".join((note or "").split()).lstrip("-").strip()[:HOT_NOTE_CHARS]
    if not body:
        return False
    with _lock:
        text, st = _read_state_unlocked()
        m = re.search(r"## Hot Notes\n(.*?)(?=^## |\Z)", text, re.M | re.S)
        existing = [l.strip() for l in (m.group(1).splitlines() if m else [])
                    if l.strip().startswith("- ")]
        if any(e.lstrip("-").strip().lower() == body.lower() for e in existing):
            return False   # duplicate - skip
        notes = existing + ["- " + body]
        if len(notes) > HOT_NOTE_MAX:
            notes = notes[-HOT_NOTE_MAX:]   # keep the newest
        block = "## Hot Notes\n" + "\n".join(notes) + "\n"
        if m:
            text = text[:m.start()] + block + text[m.end():]
        else:
            # First-time insert: place BEFORE '## Counter' (not at the file end), so entries
            # appended later by agents can't land inside/after the notes section.
            cm = re.search(r"^## Counter\n", text, re.M)
            if cm:
                text = text[:cm.start()] + block + "\n" + text[cm.start():]
            else:
                text = text.rstrip() + "\n\n" + block
        _write_memory(text, st)
        return True


def _group_round_summary(agent, messages, all_agents):
    """CROSS-TALK ORIENTATION (2026-11-14): one line per OTHER agent - what they last said
    since the human's latest message (private-to-you DMs flagged, foreign content excluded) -
    so each cross-talk round starts knowing where everyone stands. Group mode only."""
    msgs = messages or []
    users = [i for i, m in enumerate(msgs) if (m.get("speaker") or "").strip().lower() == "you"]
    start = users[-1] + 1 if users else 0
    lines = ["GROUP ROSTER - where each agent stands RIGHT NOW (summary before your round):"]
    for a in all_agents:
        if a["id"] == agent.get("id"):
            continue
        name = a.get("name", "?")
        said = ""
        for m in reversed(msgs[start:]):
            who = (m.get("speaker") or "").strip()
            if not who or who.lower() != name.lower():
                continue
            c = (m.get("content") or "").strip()
            if not c:
                continue
            segs = parse_dm_segments(c)
            pub = " ".join(b for k, _t, b in segs if k == "public").strip()
            said = (pub or "(private message to you)")[:150]
            break
        blurb = (a.get("blurb") or "")[:60]
        lines.append("- %s (%s) just said: %s" % (name, blurb,
                     ('"%s"' % said) if said else "no words yet this round"))
    return "\n".join(lines)


def stream_chat(wfile, agent, messages, mode, kind="prompt", session=None):
    # Activity timeline: one JSONL event per phase into activity/<session>.jsonl.
    session = _safe_session(session)
    who = agent.get("name", "?")[:60]
    t0 = time.time()
    _act_log(session, {"agent": who, "event": "start", "kind": kind, "mode": mode})
    # HOST-AGNOSTIC PLACEMENT (2026-11-22): the agent's model may be resident on ANOTHER
    # reachable host (home down or unloaded) - run this turn THERE; first available wins.
    # The thread-local seat then redirects every LLM call of this turn (main + aux rounds).
    _seat = None
    try:
        _seat = _resolve_seat(agent)
    except Exception:
        _seat = None
    if _seat:
        _record_active(agent, _seat["base"])   # LIVE PLACEMENT: this turn runs on that host
    if _seat and _seat["base"] != _studio_base(agent):
        _set_seat(_seat)
        _act_log(session, {"agent": who, "event": "placed",
                           "host": _seat.get("host"), "model": _seat.get("model")})
        try:
            wfile.write(b"data: " + json.dumps({"model_load": "%s -> placed on %s (%s resident%s)" % (
                who, _seat.get("host"), _seat["model"], ", quant fallback" if _seat.get("fallback") else "")}).encode() + b"\n\n")
            wfile.flush()
        except Exception:
            pass
    # HOT LOAD ON DEMAND (P1, 2026-11-22): when no other host serves the model, before ANY
    # work on this turn (incl. the READMEM aux round) make sure the HOME seat's model is
    # resident - hot-load it now instead of erroring.
    if not _seat:
        try:
            _ready, _load_note = _ensure_seat_ready(agent, wfile)
            if _ready:
                _record_active(agent, _studio_base(agent))   # hot-loaded home seat now serves it
            if not _ready:
                _act_log(session, {"agent": who, "event": "model_load_fail", "detail": _load_note[:300]})
                wfile.write(b"data: " + json.dumps(
                    {"error": "model not available for %s - auto-recovery in progress: %s" % (who, _load_note)}).encode() + b"\n\n")
                wfile.write(b"data: [DONE]\n\n")
                wfile.flush()
                return
        except Exception:
            pass
    all_agents = load_agents()["agents"]
    _, mem_st = load_memory() if mode == "group" else (None, None)
    if mode == "group" and kind == "prompt":
        # A new human prompt starts a fresh agent-to-agent budget. Atomic:
        # every agent of the parallel prompt phase fires this at once (idempotent zero).
        if mem_st["inter_agent_replies"] or mem_st.get("last_reset_by"):
            mem_st = _reset_counter()
    mem_block = _shared_memory_block(mem_st) if mode == "group" else ""
    if mode == "group":
        nudge = _ack_nudge(agent, messages, kind, all_agents)
        if nudge:
            mem_block = (mem_block + "\n" if mem_block else "") + nudge
        if kind == "cross-talk":
            # CROSS-TALK ORIENTATION: one line per other agent on where they stand, so each
            # round starts with the group's current state instead of a blank slate.
            roster = _group_round_summary(agent, messages, all_agents)
            if roster:
                mem_block = (mem_block + "\n" if mem_block else "") + roster
    # USER MESSAGE QUEUE (2026-11-15): human messages sent while the group was working.
    # Injected into THIS agent's prompt now; marked seen for it once the request reaches Studio.
    umq_ids = []
    if mode == "group":
        pend = umq_pending_for(who, [a.get("name", "") for a in all_agents])
        if pend:
            ul = ["USER MESSAGE QUEUE (user_messages.json - human messages that arrived while the group was working; they ARE part of this turn):"]
            for m in pend:
                tag = "PRIVATE, addressed only to you" if m.get("mentions") else "broadcast to all agents"
                ul.append("- [%s] %s (%s) You: %s" % (m["id"], m["ts"], tag, m["text"][:4000]))
            ul.append("Rule: act on them in your reply. Private entries are for you alone - do not quote them publicly unless asked.")
            mem_block = (mem_block + "\n\n" if mem_block else "") + "\n".join(ul)
            umq_ids = [m["id"] for m in pend]
        gb = _agent_goals_block(who)   # goal-drift fix: every group turn sees this agent's open goals
        if gb:
            mem_block = (mem_block + "\n\n" if mem_block else "") + gb
    # PORTAL API RESULTS (2026-11-25): outcomes of this agent's [[PORTAL-API]] calls from earlier
    # turns. Injected now; marked seen once the request reaches Studio (same pattern as UMQ).
    apiq_ids = []
    apend = _apiq_pending_for(who)
    if apend:
        al = ["PORTAL API RESULTS (outcomes of your [[PORTAL-API]] calls from earlier turns - act on them, do NOT re-submit):"]
        for r in apend[-10:]:
            rid = (" %s" % r["reqID"]) if r.get("reqID") else ""
            al.append("- %s%s -> %s" % (r["call"], rid, json.dumps(r.get("result") or {}, ensure_ascii=False)[:600]))
        al.append("Use the reqIDs above with getReqInfo/editReq/cancelReq; viewRequestQueue shows what is still pending.")
        mem_block = (mem_block + "\n\n" if mem_block else "") + "\n".join(al)
        apiq_ids = [r["id"] for r in apend]
    # Blocked cross-talk rounds skip ReadMem entirely (checked BEFORE any aux round).
    if kind == "cross-talk" and not mem_st.get("infinite_budget", True) \
            and mem_st["inter_agent_replies"] >= XTALK_LIMIT:
        wfile.write(b"data: " + json.dumps(
            {"blocked": f"agent-to-agent reply limit reached ({mem_st['inter_agent_replies']}/{XTALK_LIMIT})"}
        ).encode() + b"\n\n")
        _act_log(session, {"agent": who, "event": "blocked",
                           "detail": f"agent-to-agent limit {mem_st['inter_agent_replies']}/{XTALK_LIMIT}"})
        wfile.write(b"data: [DONE]\n\n")
        wfile.flush()
        return
    # READMEM (2026-11-14): cheap aux round fetches memory context for THIS message.
    mem_cycle = bool(agent.get("mem_cycle", MEM_CYCLE_DEFAULT))
    lookup_ctx = ""
    if mem_cycle:
        t_rm = time.time()
        lookup_ctx = _mem_lookup_round(agent, messages)
        _lh = _mem_local_hits(messages)
        if _lh:
            lookup_ctx = (lookup_ctx + "\n\n" + _lh) if lookup_ctx else _lh
        # UNDERSTANDING (2026-11-18): dictionary meaning + usage of the prompt's key
        # terms (U-ref indexed, pointers into memory/researcher/dictionary_*.json)
        # folded into pre-context before the main LLM prompt.
        try:
            _u = _understanding()
            if _u is not None:
                _ub = _u.understanding_block(messages)
                if _ub:
                    lookup_ctx = (lookup_ctx + "\n\n" + _ub) if lookup_ctx else _ub
        except Exception:
            pass
        _act_log(session, {"agent": who, "event": "readmem",
                           "dur": round(time.time() - t_rm, 2), "chars": len(lookup_ctx)})
    # FAST FIRST REPLY: the first reply to a human uses a low context window (last N
    # messages) and low reasoning when the agent's setting is left at "default".
    fast_first = kind == "prompt" and bool(agent.get("fast_first_reply", FAST_FIRST_DEFAULT))
    msgs_llm = (messages[-FIRST_REPLY_MAX_MSGS:]
                if fast_first and len(messages or []) > FIRST_REPLY_MAX_MSGS else (messages or []))
    rag_context = rag_prefetch(agent, msgs_llm)
    body = {"model": (_seat_now() or {}).get("model") or agent["model_id"],
            "messages": to_openai_messages(agent, msgs_llm, mode, all_agents,
                                           rag_context, mem_block, kind, lookup_ctx),
            "stream": True,
            "temperature": float(agent.get("temperature", 0.7))}
    mt = int(agent.get("max_tokens") or 0)
    if mt > 0:
        body["max_tokens"] = mt
    eff = agent.get("reasoning", "default")
    if fast_first and eff == "default":
        eff = FIRST_REPLY_REASONING
    if mode == "group" and eff == "default":
        # 2026-11-15: unbounded default thinking is fatal in group mode - the prompt already
        # holds ~17k tokens on a 32k window, so deep reasoning eats the whole window and Studio
        # returns "spent the whole of its 32768-token window on reasoning" with NO answer
        # (Builder/Verifier/Archivist, runs of 11-15). Cap it like the fast-first path.
        eff = FIRST_REPLY_REASONING
    if eff == "off":
        body["enable_thinking"] = False
    elif eff != "default":
        body["enable_thinking"] = True
        body["reasoning_effort"] = eff
    tools = agent.get("tools") or []
    if tools:
        # enable_tools=true is REQUIRED: without it Studio never injects the tool
        # system-prompt block into the chat template, so the model has no idea it
        # can call tools (diagnosed 2026-11-10: web_search "false" claim + hung probe).
        body["enable_tools"] = True
        # permission_mode="off" is REQUIRED alongside enable_tools for local tool
        # execution without the X-Unsloth-Events confirm flow; without it Studio
        # rejects the request with HTTP 400 (param=confirm_tool_calls, found 2026-11-10).
        body["permission_mode"] = "off"
        body["enabled_tools"] = tools
        body["run_tools_locally"] = bool(agent.get("run_tools_locally", True))
        mtc = int(agent.get("max_tool_calls") or 0)
        if mtc > 0:
            body["max_tool_calls_per_message"] = mtc
    req = urllib.request.Request(studio_base(agent) + "/v1/chat/completions",
                                 data=json.dumps(body).encode(),
                                 headers=studio_headers(agent))

    def _open_upstream():
        # 2026-11-15: transient remote-Studio hiccups killed whole turns instantly - empty-body
        # HTTP 400s (model swap/unload on Black, runs g-1a1de52..g-1a1debfa) and later full host
        # unreachability (Black .99 asleep: WinError 10060, run g-1a1def4). Retry before giving
        # up; longer backoff for connection-level failures since a sleeping host takes time to wake.
        for attempt in range(3):
            try:
                r = urllib.request.urlopen(req, timeout=300)
                if umq_ids:  # request reached Studio => queued messages are now in this context
                    umq_check(umq_ids, who)
                if apiq_ids:
                    _apiq_check(apiq_ids, who)   # same guarantee for Portal API results
                return r
            except Exception as e:
                code = getattr(e, "code", None)
                http_transient = isinstance(e, urllib.error.HTTPError) and \
                    code in (400, 408, 425, 429, 500, 502, 503, 504)
                conn_transient = isinstance(e, (urllib.error.URLError, ConnectionError, TimeoutError))
                if not (http_transient or conn_transient) or attempt == 2:
                    raise
                wait_s = (10 * (attempt + 1)) if http_transient else (30 * (attempt + 1))
                _act_log(session, {"agent": who, "event": "retry", "error": str(e)[:200],
                                   "wait": wait_s, "attempt": attempt + 1})
                time.sleep(wait_s)

    try:
        resp = _open_upstream()
    except Exception as e:
        # Surface the upstream error BODY (e.g. "No model loaded. Call POST /inference/load
        # first."), not just "HTTP Error 400: Bad Request" - that bare text hid the Black
        # overnight-unload incident for a full group cycle (2026-11-15).
        detail = str(e)
        if isinstance(e, urllib.error.HTTPError):
            try:
                body_txt = e.read().decode("utf-8", "replace")[:400]
                if body_txt:
                    detail += " - " + body_txt
            except Exception:
                pass
        _act_log(session, {"agent": who, "event": "error", "error": detail[:500]})
        wfile.write(b"data: " + json.dumps({"error": detail}).encode() + b"\n\n")
        wfile.write(b"data: [DONE]\n\n")
        return
    buf = b""
    full = ""
    seen_tools = set()
    _last_content = time.time()   # 2026-11-23 staleness watchdog (see loop below)
    stop_ev = getattr(wfile, "stop_event", None)
    try:
        for raw in resp:
            buf += raw
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.strip()
                if not line.startswith(b"data:"):
                    continue
                payload = line[5:].strip()
                if payload == b"[DONE]":
                    break
                try:
                    obj = json.loads(payload)
                except Exception:
                    continue
                delta = ""
                ch = obj.get("choices") or [{}]
                d = (ch[0] or {}).get("delta") or {}
                if d.get("content"):
                    delta += d["content"]
                    full += delta
                think = d.get("reasoning_content") or d.get("reasoning") or ""
                tool = d.get("tool_calls") or d.get("tools") or obj.get("tool_call")
                if tool:
                    for nm in _tool_names(tool):
                        if nm not in seen_tools:
                            seen_tools.add(nm)
                            _act_log(session, {"agent": who, "event": "tool", "tool": nm})
                if delta or think or tool:
                    _last_content = time.time()
                    wfile.write(b"data: " + json.dumps(
                        {"content": delta, "thinking": think, "tool": tool},
                        ensure_ascii=False).encode() + b"\n\n")
                    wfile.flush()
                # 2026-11-23 hang fix: a stalled upstream (model evicted mid-generation on an
                # overloaded host) keeps the SSE socket open with no content frames, so the 300 s
                # socket timeout never fires and this loop blocks forever - freezing the whole pass
                # (run g-1a20817c: all seats hung, autoloop dead). Abort on staleness or stop.
                if (stop_ev is not None and stop_ev.is_set()) or \
                   (time.time() - _last_content) > 300:
                    raise OSError("upstream stream stalled")
    except OSError:
        # Browser aborted the stream (■ Stop / tab closed): stop forwarding AND kill the
        # upstream request so Studio stops generating instead of burning GPU on a dead stream.
        _act_log(session, {"agent": who, "event": "aborted"})
        return
    finally:
        resp.close()
    # PORTAL API CALLS (2026-11-25): [[PORTAL-API]] blocks in the reply execute against the
    # request queue; the blocks are stripped from the stored/displayed text.
    if full.strip():
        try:
            full, n_api = _apiq_execute(who, full)
            if n_api:
                _act_log(session, {"agent": who, "event": "portal_api", "calls": n_api})
        except Exception as e:
            _act_log(session, {"agent": who, "event": "portal_api_error", "error": str(e)[:200]})
    # STOREMEM (2026-11-14): cheap aux round distills at most one hot note from the reply.
    if mem_cycle and full.strip():
        _txt, is_silent, _ = _effective_reply(full)
        if not is_silent:
            t_sm = time.time()
            _mem_recall_round(agent, messages, full)
            note = _mem_store_round(agent, messages, full)
            stored = bool(note) and _append_hot_note(note)
            _act_log(session, {"agent": who, "event": "storemem",
                               "dur": round(time.time() - t_sm, 2),
                               "stored": bool(stored), "note": note[:HOT_NOTE_CHARS]})
    silent, concluded = _finish_chat(wfile, agent, mode, kind, full)
    _act_log(session, {"agent": who, "event": "end", "dur": round(time.time() - t0, 2),
                       "chars": len(full), "silent": bool(silent), "concluded": bool(concluded)})


def _effective_reply(full):
    """Parse leading control markers. Returns (text, is_silent, concluded)."""
    t = (full or "").strip()
    low = t.lower()
    if low.startswith("[silent]"):
        rest = t[len("[silent]"):].lstrip(" :-").strip()
        return rest, not rest, False
    if low.startswith("[concluded]"):
        rest = t[len("[concluded]"):].lstrip(" :-").strip()
        return (rest or "(concluded)"), False, True
    return t, False, False


def _finish_chat(wfile, agent, mode, kind, full):
    """Update the shared counter in memory.md after a group reply, then close.

    Emits ONE authoritative meta frame per group reply. The `silent` flag is the
    single source of truth for [SILENT] detection (Python _effective_reply), so the
    frontend no longer needs its own regex to agree - it just trusts this flag."""
    is_silent = concluded = False
    if mode == "group" and full.strip():
        text, is_silent, concluded = _effective_reply(full)
        if kind != "cross-talk":
            concluded = False   # a conclusion only means something mid-debate
        st_now = None
        if not is_silent:
            # Atomic RMW - parallel streams can finish simultaneously (see _bump_counter).
            st_now = _bump_counter(agent.get("name", "?")[:60], kind, text)
        meta = {"silent": is_silent}
        if concluded:
            meta["concluded"] = True
        if st_now is not None:
            meta["inter_agent_replies"] = st_now["inter_agent_replies"]
            meta["limit"] = None if st_now.get("infinite_budget", True) else XTALK_LIMIT  # null = ∞
        wfile.write(b"data: " + json.dumps({"meta": meta}, ensure_ascii=False).encode() + b"\n\n")
    wfile.write(b"data: [DONE]\n\n")
    wfile.flush()
    return is_silent, concluded


# ---- Group run engine (2026-11-15): backend-owned group orchestration ----
# The cross-talk / auto-nudge loop used to live in the browser (index.html send()); a hard
# refresh killed every in-flight stream and lost the whole run. Now a daemon thread owns
# each group run: state persists in group_run.json, every SSE frame is journaled into
# runs/<run_id>.journal, and ANY client (including one that just reloaded) replays from
# seq 0 via /api/run-events and keeps watching live. Queued human messages ride the UMQ
# (user_messages.json) and are injected by stream_chat itself - refresh-proof.

GROUP_RUN_FILE = os.path.join(HERE, "group_run.json")
RUNS_DIR = os.path.join(HERE, "runs")
RUN_MAX_EVENTS = 150000   # per-run journal cap (2026-11-15: 30k was hit in minutes by per-token frames, after which ALL output was silently dropped and invisible to every client; with token coalescing below this is ~10h of headroom)
RUN_KEEP = 5               # keep the N newest journals on disk
NUDGE_MAX_RUN = 3          # auto-continue passes (mirrors the old frontend cap)
XTALK_GUARD_RUN = 8        # max cross-talk rounds per pass
MAX_CALLS_RUN = 16         # max agent calls per pass

_group_run_lock = threading.Lock()
_history_lock = threading.Lock()
_journal_lock = threading.Lock()
_active_run_id = None      # at most one live group run
_run_stops = {}            # run_id -> threading.Event (■ Stop)
_run_seq = {}              # run_id -> next seq
_run_last_frame = {}       # run_id -> wall time of last journaled frame (stall watchdog)
RUN_STALL_S = 240          # no frames for this long => /api/run-state flags stalled=True
STALL_KILL_S = 900         # (2026-11-15) no frames for THIS long => watchdog kills the run (wedge guard)
PASS_TIMEOUT_S = 900       # (2026-11-23, Arnold: fleet slower than one LLM) hard cap on ONE parallel pass:
                           # a hung seat used to hold the whole pass open until a human hit Stop; now the
                           # remaining turns are torn down cleanly and marked stalled so the round can end
AUTO_RESUME_MAX = 5        # (2026-11-15) consecutive auto-resumes before a human follow-up is required
AUTO_RESUME_DELAY_S = 45   # settle time after a run ends before the watchdog starts the continuation
AUTOLOOP_IDLE_S = 60       # (2026-11-16, Arnold) max seconds an agent may sit idle before re-entering the work queue
AUTOLOOP_BATCH_MAX = 8     # (2026-11-17) auto-loop fires ALL idle agents at once; cap on seats per batch pass
AUTOLOOP_PROBE_TIMEOUT_S = 45  # (2026-11-17) model probe timeout in the autoloop; 27B models take >15s to load
AUTOLOOP_TICK_S = 15       # autoloop scheduler tick
AUTOLOOP_MAX_STREAK = 40   # consecutive auto passes without human input before the loop pauses (GPU budget)
AUTOLOOP_MAINT_COOLDOWN_S = 1800   # min gap between maintenance passes for an agent at 100%

_IDLE_ROTATION_CACHE = {"ts": 0.0, "tasks": {}}  # role -> [5 daily tasks] from the rotation table
_FLEET_MODE_CACHE = {"ts": 0.0, "mode": None}    # memory/ops/fleet-mode.json, 60s TTL

def _idle_rotation_task(agent_name):
    """Role-specific idle maintenance task (2026-11-24 B1): parses the role row of
    memory/ops/idle-maintenance-rotation-2026-11-24.md and picks the day-of-week task.
    Returns "task (DayLabel)" or None."""
    now = time.time()
    if now - _IDLE_ROTATION_CACHE["ts"] > 3600 or not _IDLE_ROTATION_CACHE["tasks"]:
        tasks = {}
        try:
            rp = os.path.join(HERE, "memory", "ops", "idle-maintenance-rotation-2026-11-24.md")
            with open(rp, encoding="utf-8") as f:
                for line in f:
                    m = re.match(r"^\|\s*([A-Za-z]+)\s*\|(.+)\|\s*$", line.strip())
                    if not m or m.group(1).lower() == "role":
                        continue
                    cells = [c.strip() for c in m.group(2).split("|") if c.strip()]
                    if len(cells) >= 5:
                        tasks[m.group(1).lower()] = cells[:5]
            _IDLE_ROTATION_CACHE.update(ts=now, tasks=tasks)
        except Exception:
            return None
    row = _IDLE_ROTATION_CACHE["tasks"].get(agent_name.lower())
    if not row:
        return None
    idx = time.localtime().tm_wday % 5   # Mon=0..Sun=6; rotation wraps Sat/Sun into Tue/Wed
    days = ["Mon", "Tue", "Wed", "Thu", "Fri"]
    return "%s (%s)" % (row[idx], days[idx])

def _fleet_mode_now():
    """Current fleet mode from memory/ops/fleet-mode.json (60s TTL). None on error."""
    now = time.time()
    if now - _FLEET_MODE_CACHE["ts"] > 60:
        mode = None
        try:
            with open(os.path.join(HERE, "memory", "ops", "fleet-mode.json"), encoding="utf-8") as f:
                mode = json.load(f).get("mode")
        except Exception:
            pass
        _FLEET_MODE_CACHE.update(ts=now, mode=mode)
    return _FLEET_MODE_CACHE["mode"]


class _RunStopped(OSError):
    """Raised by the run sink when ■ Stop is requested. stream_chat's existing
    `except OSError` branch catches it, so a stopped turn tears down cleanly."""


def _load_group_run():
    try:
        with open(GROUP_RUN_FILE, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _save_group_run(run):
    tmp = GROUP_RUN_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(run, f, ensure_ascii=False)
    os.replace(tmp, GROUP_RUN_FILE)


def _append_history(mode, entries):
    """Append messages to the mode history (backend-owned group runs). Atomic RMW."""
    if not entries or mode not in CHAT_HISTORY_FILES:
        return
    with _history_lock:
        h = _load_history(mode)
        h.extend(entries)
        _save_history(mode, h)


def _run_event(run_id, obj):
    """Journal one seq-numbered event into the run's JSONL log (the replay source)."""
    with _journal_lock:
        nxt = _run_seq.get(run_id)
        if nxt is None:  # first event for this run in this process: resume from disk
            nxt = 1
            try:
                with open(os.path.join(RUNS_DIR, run_id + ".journal"), encoding="utf-8") as f:
                    last = None
                    for ln in f:
                        last = ln
                if last:
                    nxt = int(json.loads(last).get("seq", 0)) + 1
            except Exception:
                pass
        if nxt > RUN_MAX_EVENTS:
            return
        _run_seq[run_id] = nxt + 1
        if obj.get("kind") == "frame":
            _run_last_frame[run_id] = time.time()
        line = json.dumps({"seq": nxt, "ts": int(time.time() * 1000), **obj}, ensure_ascii=False) + "\n"
        try:
            os.makedirs(RUNS_DIR, exist_ok=True)
            with open(os.path.join(RUNS_DIR, run_id + ".journal"), "a", encoding="utf-8") as f:
                f.write(line)
        except Exception:
            pass


class _FrameSink:
    """File-like stand-in for wfile: journals the SSE frames of one backend turn.

    stream_chat only needs .write/.flush, so the ENTIRE turn pipeline (counter bump,
    UMQ injection, ReadMem/StoreMem aux rounds, activity log) runs unchanged."""

    def __init__(self, on_frame=None, stop_event=None):
        self.on_frame = on_frame
        self.stop_event = stop_event
        self.buf = b""
        self.content = ""
        self.meta = {}
        self.error = None
        self.blocked = None
        self._pend = None      # coalesced token frame in flight (see write)
        self._pend_t = 0.0

    def _emit_pend(self):
        if not self._pend:
            return
        p, self._pend = self._pend, None
        obj = {"agent": p.get("agent")}
        if p["thinking"]:
            obj["thinking"] = p["thinking"]
        if p["content"]:
            obj["content"] = p["content"]
        if self.on_frame:
            try:
                self.on_frame(obj)
            except Exception:
                pass

    def write(self, data):
        if self.stop_event is not None and self.stop_event.is_set():
            raise _RunStopped("run stopped")
        self.buf += data
        while b"\n\n" in self.buf:
            chunk, self.buf = self.buf.split(b"\n\n", 1)
            line = chunk.strip()
            if not line.startswith(b"data:"):
                continue
            payload = line[5:].strip()
            if payload == b"[DONE]":
                continue
            try:
                obj = json.loads(payload)
            except Exception:
                continue
            if obj.get("content"):
                self.content += obj["content"]
            if "meta" in obj:
                self.meta = obj["meta"]
            if obj.get("error"):
                self.error = str(obj["error"])[:300]
            if obj.get("blocked"):
                self.blocked = str(obj["blocked"])[:300]
            if not self.on_frame:
                continue
            # Coalesce (2026-11-15): batch consecutive thinking/content token frames into ONE
            # journaled event every ~300ms. Per-token journaling filled the run cap in minutes,
            # after which every frame was dropped - live progress became invisible to ALL clients.
            if (obj.get("thinking") or obj.get("content")) and not (
                    obj.get("tool") or "meta" in obj or obj.get("error") or obj.get("blocked")):
                if self._pend is None:
                    self._pend = {"agent": obj.get("agent"), "thinking": "", "content": ""}
                    self._pend_t = time.time()
                self._pend["thinking"] += obj.get("thinking") or ""
                self._pend["content"] += obj.get("content") or ""
                if time.time() - self._pend_t >= 0.3:
                    self._emit_pend()
            else:
                self._emit_pend()   # flush tokens before the structural frame
                try:
                    self.on_frame(obj)
                except Exception:
                    pass
        return len(data)

    def flush(self):
        self._emit_pend()


def run_turn_captured(agent, messages, mode, kind, session, on_frame=None, stop_event=None):
    """Run one agent turn exactly like /api/chat but capture the SSE frames instead of
    streaming them to a browser. Returns the sink (.content/.meta/.error/.blocked)."""
    sink = _FrameSink(on_frame, stop_event)
    stream_chat(sink, agent, messages, mode, kind, session)
    sink.flush()   # ensure the final token batch is journaled before the turn's done event
    return sink


def _parallel_turns(run_id, names, kind, hist, stop_event):
    """Run one turn per agent, ALL AGENTS IN PARALLEL (2026-11-15, Arnold: async,
    not turn-taking). Returns result dicts in `names` order:
    {name, full, silent, concluded, error, blocked}.

    One worker thread per agent. Agents on DIFFERENT Studio hosts truly overlap;
    the two local agents (Orchestrator+Researcher) are queued by White's Studio
    internally (parallel_slots=1) and simply start a beat apart - harmless. Bubbles
    open on each agent's `turn` event before its stream starts, and token frames are
    journaled as they arrive, so live progress shows from the first host that answers.
    Concurrency is safe: journal writes take _journal_lock per event, memory RMWs take
    _lock, UMQ takes _umq_lock - no lock is ever held across a generation."""
    agents_by_name = {a.get("name", "?"): a for a in load_agents()["agents"]}
    out = [None] * len(names)

    def work(i, nm):
        ag = agents_by_name.get(nm)
        if not ag:
            return
        try:
            _run_event(run_id, {"agent": nm, "kind": kind, "turn": True})  # frontend opens a bubble here
            sink = run_turn_captured(ag, hist, "group", kind, run_id,
                                     on_frame=lambda o: _run_event(
                                         run_id, {"agent": nm, "kind": kind, "frame": o}),
                                     stop_event=stop_event)
            if sink.content.strip():
                _, is_silent, concluded = _effective_reply(sink.content)
            else:
                is_silent, concluded = False, False
            out[i] = {"name": nm, "full": sink.content, "silent": bool(is_silent),
                      "concluded": bool(concluded), "error": sink.error, "blocked": sink.blocked}
        except Exception as e:  # one agent's crash must not kill the other parallel turns
            out[i] = {"name": nm, "full": "", "silent": False, "concluded": False,
                      "error": str(e)[:300], "blocked": None}

    if stop_event.is_set():
        return out
    from concurrent.futures import ThreadPoolExecutor, as_completed, TimeoutError as _FTimeout
    pool = ThreadPoolExecutor(max_workers=max(1, len(names)))
    futs = {pool.submit(work, i, nm): (i, nm) for i, nm in enumerate(names)}
    try:
        try:
            for _ in as_completed(futs, timeout=PASS_TIMEOUT_S):
                pass
        except _FTimeout:
            # 2026-11-23 (Arnold: fleet slower than one LLM): cap the pass. stop_event tears the
            # remaining turns down cleanly (existing path); whatever hasn't landed gets a stalled
            # result so the round ends and the next pass can start instead of waiting on a dead seat.
            stop_event.set()
            for fut, (i, nm) in futs.items():
                if not out[i]:
                    try:
                        fut.result(timeout=20)
                    except Exception:
                        out[i] = {"name": nm, "full": "", "silent": False, "concluded": False,
                                  "error": "turn stalled - no completion within %d min (pass cap)" % (PASS_TIMEOUT_S // 60),
                                  "blocked": None}
    finally:
        # 2026-11-23 hang fix: the implicit shutdown(wait=True) here froze the whole fleet when an
        # upstream stream stalled (model evicted mid-generation on an overloaded host - run
        # g-1a20817c hung 30+ min, no done events, autoloop dead). Stragglers now die on their own
        # via the stream staleness watchdog in stream_chat; the round must not wait for them.
        pool.shutdown(wait=False, cancel_futures=True)
    for r in out:  # terminal event per turn - the frontend finalizes each bubble on this
        if r:
            _run_event(run_id, {"agent": r["name"], "kind": kind, "done": True})
            autoloop_touch(r["name"])   # AUTO-LOOP: last activity for idle tracking
    return out


def _group_run_worker(run_id):
    """Backend port of the frontend group loop: parallel prompt phase -> cross-talk rounds
    (settled / budget / guard caps) -> auto-nudge passes -> verdict. Every frame is journaled;
    state survives tab refreshes, and a portal restart marks the run interrupted."""
    global _active_run_id
    run = _load_group_run()
    stop_event = _run_stops.get(run_id) or threading.Event()
    agents_by_name = {a.get("name", "?"): a for a in load_agents()["agents"]}
    cast = [n for n in (run.get("cast") or []) if n in agents_by_name]
    settled, no_output = set(), []
    err_streak, errored = {}, set()   # 2026-11-15: per-agent consecutive error passes; names that ever errored
    last_concluded = pass_any = truncated = False
    nudges = 0
    verdict = None

    def expand_mentions(text):
        nonlocal cast
        for nm in agents_by_name:
            if nm not in cast and re.search(r"@" + re.escape(nm), text or "", re.I):
                cast.append(nm)
                run["cast"] = list(cast)
                _save_group_run(run)

    try:
        while True:
            if stop_event.is_set():
                # (2026-11-16) honest stop: a user stop is NOT a conclusion - the previous wording
                # showed a green "concluded" while goals were still open and agents had produced no output.
                verdict = {"note": "\u25a0 Stopped by user \u2014 round ended without [CONCLUDED]; task state unconfirmed.", "cls": "warn"}
                break
            if nudges > 0:
                nt = ("\u21bb AUTO-CONTINUE %d/%d: the previous pass ended without [CONCLUDED]. Keep going: "
                      "finish in-flight work, then either reply [CONCLUDED] when the task is done or go "
                      "[SILENT] if there is nothing left to do.") % (nudges, NUDGE_MAX_RUN)
                _append_history("group", [{"speaker": "You", "content": nt}])
                _run_event(run_id, {"run": "nudge", "text": nt})
            try:
                _sync_workspace_to_sandbox()   # per-pass mirror (2026-11-15): goal progress reaches HERE
                                               # WHILE the run is alive, not only at run end - a crashed or
                                               # interrupted run no longer strands 80 min of work in the sandbox
            except Exception:
                pass
            hist = _load_history("group")
            run["phase"] = "prompt"
            _save_group_run(run)
            _run_event(run_id, {"run": "phase", "phase": "prompt"})
            results = [r for r in _parallel_turns(run_id, cast, "prompt", hist, stop_event) if r]
            entries = []
            for r in results:
                if r["error"]:
                    errored.add(r["name"])   # keep the verdict honest even when others conclude
                if r["blocked"] or r["error"]:
                    continue
                if r["full"].strip() and not r["silent"]:
                    entries.append({"speaker": r["name"], "content": r["full"]})
                    pass_any = True
                    if re.search(r"stopped before completing its tool calls", r["full"], re.I):
                        truncated = True
                else:
                    no_output.append(r["name"])
            _append_history("group", entries)
            for r in results:  # @-mention expansion (same rule as the old frontend loop)
                expand_mentions(r["full"])
            if run.get("solo"):
                # AUTO-LOOP solo pass (2026-11-16): ONE turn is the whole pass - no self cross-talk,
                # no nudges. The autoloop watchdog re-queues the next idle agent; the evidence sweep
                # + _auto_commit in `finally` persist this pass's work before the next one starts.
                last_concluded = True
                verdict = {"note": "\u21bb Auto-loop solo pass (%s) complete." % (run.get("autoloop_why") or "idle re-entry"), "cls": "dim"}
                break
            guard = calls = 0
            while (not stop_event.is_set() and guard < XTALK_GUARD_RUN and calls < MAX_CALLS_RUN):
                _, st = load_memory()
                if not st.get("infinite_budget", True) and st["inter_agent_replies"] >= XTALK_LIMIT:
                    break
                active = [nm for nm in cast if nm not in settled]
                if not active:
                    break
                calls += len(active)
                hist = _load_history("group")
                run["phase"] = "cross-talk"
                _save_group_run(run)
                _run_event(run_id, {"run": "phase", "phase": "cross-talk"})
                results = [r for r in _parallel_turns(run_id, active, "cross-talk", hist, stop_event) if r]
                any_new = False
                for r in results:
                    if r["blocked"]:
                        continue
                    if r["full"].strip() and not r["silent"]:
                        err_streak.pop(r["name"], None)
                        _append_history("group", [{"speaker": r["name"], "content": r["full"]}])
                        any_new = True
                        pass_any = True
                        if r["concluded"]:
                            last_concluded = True
                        expand_mentions(r["full"])
                    else:
                        if not r["full"].strip():
                            no_output.append(r["name"])
                        if r["error"]:
                            # 2026-11-15: an errored turn (HTTP 400 / context exhaustion) is NOT
                            # "settled" - the agent retries on the next pass. Only settle after 3
                            # consecutive error passes, so one bad host hiccup can't silence an
                            # agent for the whole run (Builder/Verifier vanished mid-run on 11-15,
                            # and the remaining agents concluded without them).
                            err_streak[r["name"]] = err_streak.get(r["name"], 0) + 1
                            errored.add(r["name"])
                            if err_streak[r["name"]] >= 3:
                                settled.add(r["name"])
                        else:
                            settled.add(r["name"])
                guard += 1
                if last_concluded or not any_new:
                    break
            run["settled"] = sorted(settled)
            _save_group_run(run)
            if last_concluded:
                # 2026-11-15: a clean conclusion while agents were erroring is NOT "task complete"
                note = "\u2713 Concluded \u2014 task complete."
                cls = "ok"
                if errored:
                    note += " (note: %s failed this run - their lane may be incomplete)" % ", ".join(sorted(errored))
                    cls = "warn"
                verdict = {"note": note, "cls": cls}
                break
            if pass_any and nudges < NUDGE_MAX_RUN:  # task incomplete -> AUTO-NUDGE next pass
                nudges += 1
                run["nudges"] = nudges
                _save_group_run(run)
                continue
            _, st = load_memory()
            spent = ("\u26a0 Auto-continue limit reached (%d/%d) \u2014 " % (nudges, NUDGE_MAX_RUN)) \
                if nudges >= NUDGE_MAX_RUN else ""
            if not st.get("infinite_budget", True) and st["inter_agent_replies"] >= XTALK_LIMIT:
                verdict = {"note": spent + "\u23f8 Agent-to-agent budget exhausted (%d/%d) with NO conclusion \u2014 task not confirmed complete. Send a follow-up to continue." % (st["inter_agent_replies"], XTALK_LIMIT), "cls": "warn"}
            elif truncated:
                verdict = {"note": (spent or "") + "\u26a0 Round ended with NO conclusion and truncated tool calls \u2014 the task is incomplete.", "cls": "warn"}
            else:
                tail = (" \u2014 %s produced no output" % ", ".join(sorted(set(no_output)))) if no_output else ""
                verdict = {"note": (spent or "\u2014 ") + "Round ended with NO conclusion. Task state unconfirmed%s. Send a follow-up to continue." % tail, "cls": "dim"}
            break
    except Exception as e:
        verdict = {"note": "Run error: %s" % str(e)[:200], "cls": "warn"}
        run["error"] = str(e)[:300]
    finally:
        try:  # pick up out-of-band flags written by the stall killer while we were blocked
            disk = _load_group_run()
            if disk.get("id") == run_id:
                for k in ("stalled", "auto_resume_count"):
                    if k in disk:
                        run[k] = disk[k]
        except Exception:
            pass
        stalled = bool(run.get("stalled"))
        if last_concluded:
            status = "concluded"
        elif stalled:
            status = "stalled"
        elif stop_event.is_set():
            status = "stopped"
        else:
            status = "done"
        run["status"] = status
        if verdict is None:
            if stalled:
                verdict = {"note": "\u26a0 Stalled \u2014 no model output for %d min; watchdog stopped the run. Auto-continuing shortly." % (STALL_KILL_S // 60), "cls": "warn"}
            else:
                verdict = {"note": "Round closed.", "cls": "dim"}
        run["verdict"] = verdict
        # Goal-aware verdict (2026-11-16): the fleet's evidence-gated count is appended to EVERY
        # round-end note, so "concluded" can never silently coexist with an open goal cycle - the
        # pill says whether the CYCLE is done too, not just this round's task. This is how the UI
        # answers "how can we reach a conclusion if the goals are not completed?": it can't be green.
        try:
            _gs = _goals_snapshot()
            if _gs.get("ok") and _gs.get("fleet_total"):
                _gsum = "%d/%d goals reached" % (_gs["fleet_done"], _gs["fleet_total"])
                if status == "concluded" and _gs["fleet_done"] < _gs["fleet_total"]:
                    verdict["note"] += ("  [goals] %s - cycle NOT complete; conclusion covers this round's task only." % _gsum)
                elif status != "concluded":
                    verdict["note"] += ("  [goals] %s" % _gsum) + ("" if _gs["fleet_done"] >= _gs["fleet_total"] else " - cycle not complete")
        except Exception:
            pass
        run["ended"] = time.time()
        if status == "concluded":
            run["auto_resume_count"] = 0   # clean conclusion resets the auto-resume budget
        _save_group_run(run)
        _run_event(run_id, {"run": "end", "status": run["status"], "verdict": verdict})
        try:
            _sync_workspace_to_sandbox()
            # Evidence sweep (2026-11-15): auto-write (pointer:) markers for open goals whose
            # evidence leaf already exists AND is linked from an index - so completed work
            # stops being invisible to /api/goals. Runs BEFORE _auto_commit so markers commit.
            _gl = _goal_ledger_mod()
            sweep_ch = _gl.sweep_evidence(HERE) if hasattr(_gl, "sweep_evidence") else []
            run["evidence_sweep"] = sweep_ch
            if sweep_ch:
                verdict["note"] += ("  [evidence] %d marker(s) auto-written (%s)"
                                    % (len(sweep_ch), ", ".join(c["leaf"].split("/")[-1] for c in sweep_ch[:4])))
                run["verdict"] = verdict
            # Keep the root goal_ledger.json snapshot current (2026-11-16: it went stale - still showed
            # cycle-1 80/80 while the cycle-2 files were open, so anyone reading the file saw a fake 100%).
            try:
                _gl.GOALS_DIR = os.path.join(HERE, "memory", "goals")
                with open(os.path.join(HERE, "goal_ledger.json"), "w", encoding="utf-8") as _gjf:
                    json.dump(_gl.build_ledger(), _gjf, indent=1)
            except Exception:
                pass
            _auto_commit()
        except Exception:
            pass
        if run.get("evidence_sweep"):
            _save_group_run(run)
            _run_event(run_id, {"run": "end", "status": run["status"], "verdict": run["verdict"]})
        _active_run_id = None
        # 2026-11-17 (starnet): advance the belt - a run queued while we were busy starts now.
        threading.Thread(target=_aq_pump, args=(run.get("status") != "stopped",), daemon=True).start()


def _aq_pump(advance=True):
    """Belt advance (starnet workitem.delivered): once we're free, start the oldest queued run.
    E-STOP idiom: if a human stopped the finishing run, don't auto-advance - leave it parked."""
    time.sleep(1.0)   # let the finishing run release locks/state
    try:
        if not advance:
            print("[run-queue] parked after stop; %d waiting" % _aq.status()["queue_depth"], flush=True)
            return
        item = _aq.pop_next()
        if not item:
            return
        run, err = start_group_run(item.get("text") or "", item.get("extra"))
        print("[run-queue] advanced %s -> %s" % (item["id"], (run or {}).get("id", err)), flush=True)
    except Exception as e:
        print("[run-queue] pump error: %s" % e, flush=True)


def start_group_run(text, extra=None):
    """Create + launch a backend-owned group run. Returns (run, error).
    `extra` is merged into the run record BEFORE the first save (e.g. the auto-resume budget)."""
    global _active_run_id
    with _group_run_lock:
        if _active_run_id:
            # 2026-11-17 (starnet workitem.placed): busy no longer rejects - it ENQUEUES.
            # The caller gets a queue receipt (position + depth); 'at-capacity' deferral
            # is explicit, never silent (starnet NS-0).
            wi, qerr = _aq.enqueue(text, extra)
            if qerr:
                return None, "a group run is already in progress (%s) and the queue is %s (cap %d)" % (
                    _active_run_id, qerr, _aq.cap())
            return {"queued": True, "id": wi["id"], "position": wi["position"],
                    "depth": wi["depth"], "maxCapacity": wi["maxCapacity"], "cast": []}, None
        agents = load_agents()["agents"]
        names = [a.get("name", "") for a in agents]
        mentioned = [n for n in names if re.search(r"@" + re.escape(n), text or "", re.I)]
        # Goal-cycle upgrade (2026-11-15): when every agent's goals are 100% reached, the
        # backend armed memory/goals/GOAL_RESET_PENDING.json. Consume it here: this run MUST
        # open a NEW goal-setting round before any other work.
        # 2026-11-16 fix: rid must exist BEFORE the consumption write (was referenced in
        # json.dump before its assignment -> NameError swallowed by except, which truncated
        # GOAL_RESET_PENDING.json to 0 bytes via open("w") and left the flag corrupted).
        rid = "g-%x-%s" % (int(time.time() * 1000), os.urandom(3).hex())
        reset_note = ""
        try:
            _gf = os.path.join(HERE, "memory", "goals", "GOAL_RESET_PENDING.json")
            with open(_gf, encoding="utf-8") as _f:
                if json.load(_f).get("armed"):
                    reset_note = ("\n\n[GOAL CYCLE COMPLETE - 100% REACHED FOR ALL AGENTS] This run MUST begin "
                                  "with a NEW GOAL-SETTING round: Orchestrator chairs; each agent proposes ~10 new "
                                  "goals for the next cycle; collect them verbatim into TODO.md '## AGENT GOALS' and "
                                  "memory/goals/<name>.md (move old files to memory/goals/archive/ first). Old goal "
                                  "files are replaced, not appended to.")
                    _rec = json.dumps({"armed": False,
                                       "consumed_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                                       "run_id": rid})   # serialize BEFORE truncating the file
                    with open(_gf, "w", encoding="utf-8") as _f:
                        _f.write(_rec)
        except Exception:
            pass
        if reset_note:
            # ROUND TOPIC (P1, 2026-11-22): a queued user topic steers the new round; otherwise
            # the Orchestrator must set one before goals are drafted. The anti-repeat list keeps
            # the fresh goal set genuinely new work.
            try:
                _rt = _load_round_topic()
                _q = _rt.get("queue") or []
                if _q:
                    _nxt = _q.pop(0)
                    if _rt.get("current") and (_rt["current"] or {}).get("topic"):
                        _rt.setdefault("past", []).append(_rt["current"]["topic"][:120])
                        _rt["past"] = _rt["past"][-10:]
                    _rt["current"] = {"topic": (_nxt.get("topic") or "").strip()[:200],
                                      "description": (_nxt.get("description") or "").strip()[:1200],
                                      "set_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                                      "source": "user-queue"}
                    _save_round_topic(_rt)
                    reset_note += ("\n\n[ROUND TOPIC - USER QUEUED] This goal-setting round's focus: \"%s\". %s "
                                   "Every agent's new goals MUST serve this topic - each goal traceable to it."
                                   % ((_nxt.get("topic") or "").strip(), (_nxt.get("description") or "").strip()))
                else:
                    _past = [t for t in (_rt.get("past") or []) if t]
                    reset_note += ("\n\n[ROUND TOPIC] No user-queued topic this round. Orchestrator: BEFORE goals are "
                                   "drafted, set this round's focus - a short topic + 2-3 sentence paragraph describing "
                                   "the collection of goals for the round - by writing memory/goals/round_topic.json as "
                                   "{\"current\": {\"topic\": \"...\", \"description\": \"...\"}} (move the previous topic into "
                                   "\"past\"). Do NOT reuse a recent topic"
                                   + ((" (recent: %s)" % ", ".join(_past[-5:])) if _past else "") + ".")
                _closed = _closed_topics_recent(20)
                if _closed:
                    reset_note += ("\n\n[ANTI-REPEAT] These goals were already completed in earlier rounds - do NOT "
                                   "re-set them verbatim or near-verbatim (if genuinely needed again, cite the prior "
                                   "evidence pointer instead):\n" + "\n".join("- " + c for c in _closed))
            except Exception:
                pass
        _goal_round_cast = None
        if reset_note:
            # 2026-11-23 fix (round topic stuck >40 min after level-up): auto-loop passes kept
            # CONSUMING this flag and merely appending the note to a partial-cast "work your open
            # goals" prompt - the Orchestrator often wasn't even in the cast, so the new goal round
            # never started and the round topic never updated. Consumption must now IMPLY
            # execution: machine-triggered runs become a full-cast goal-setting round (canonical
            # chair prompt replaces the pass text); human-sent runs keep their text but still get
            # the full cast so the chair can run the round alongside it.
            _goal_round_cast = list(names)
            if (extra or {}).get("autoloop_why") or (extra or {}).get("auto_resume_count"):
                full_text = ("\nGOAL-SETTING ROUND (new cycle) - the previous goal set is 100% complete. "
                             "This run's ONLY job is to produce the NEXT cycle's goals; do NOT work "
                             "old-cycle goals - they are done and get archived by the Orchestrator. "
                             "Orchestrator: CHAIR this round - open it, state the ROUND TOPIC first "
                             "(see below), then collect every agent's ~10 proposed goals VERBATIM into "
                             "TODO.md '## AGENT GOALS' and memory/goals/<name>.md (move each old file to "
                             "memory/goals/archive/ as you go). Every other agent: propose your ~10 NEW "
                             "goals for the next cycle NOW, in this run - each traceable to the round "
                             "topic, none from the [ANTI-REPEAT] list. Reply [CONCLUDED] only after your "
                             "new goal file is written." + reset_note)
            else:
                full_text = (text or "") + reset_note
        else:
            full_text = text or ""
        # 2026-11-17: admin is the DEFAULT for every agent (user directive). When this shell is
        # not elevated, route admin commands through the elevated helper service (elev.py ->
        # 127.0.0.1:8098, SYSTEM) instead of telling agents to give up.
        try:
            if not _shell_elevated():
                full_text += ("\n\n[SHELL] Shell is not elevated, but admin commands DO work via the helper: run "
                              "`python elev.py <cmd...>` or `python elev.py --shell \"cmd string\"` (auto-escalates to SYSTEM). "
                              "Admin is the default for all agents - never treat elevation as a blocker. "
                              "Only if elev.py exits 5 (helper down) log NEEDS-HUMAN in memory/ops/blockers.md once, then move on.")
        except Exception:
            pass
        # Model-load governance: flag seats whose model is not loaded BEFORE the run
        # starts, so agents stop waiting on a chair that can never answer (2026-11-16).
        # HOST-AGNOSTIC PLACEMENT (2026-11-22): a seat whose HOME model is down is NOT missing
        # when another reachable host has its model resident - the turn runs there. Only truly
        # unplaceable seats are flagged; relocated ones are announced as normal seats, not mourned.
        _mls = None
        _relocated = {}
        try:
            _mls = _model_load_status()
            _missing = {}
            for n, s in _mls.items():
                if s.get("status") == "ok":
                    continue
                _agx = _agents_by_name().get(n) or {}
                try:
                    _sx = _resolve_seat(_agx)
                except Exception:
                    _sx = None
                if _sx and _sx["base"] != _studio_base(_agx):
                    _relocated[n] = "%s (home %s)" % (_sx.get("host"), s.get("status"))
                else:
                    _missing[n] = s
            if _missing or _relocated:
                _note = "\n\n[MODEL LOAD STATUS]"
                if _relocated:
                    _note += (" Relocated - home model down, running on another host, treat as NORMAL seats: " +
                              ", ".join("%s -> %s" % (n, v) for n, v in sorted(_relocated.items())) + ".")
                if _missing:
                    _note += (" Seats NOT ready anywhere at run start: " +
                              ", ".join("%s=%s" % (n, s["status"]) for n, s in sorted(_missing.items())) +
                              ". Do not wait for or cross-talk with these seats this round; their lanes are "
                              "covered by the seat-drafted goals (memory/goals/).")
                full_text += _note
                try:
                    with open(os.path.join(HERE, "memory", "ops", "model-load.jsonl"), "a", encoding="utf-8") as _f:
                        _f.write(json.dumps({"ts": time.strftime("%Y-%m-%d %H:%M:%S"), "run": rid,
                                             "missing": {n: s.get("status") for n, s in _missing.items()},
                                             "relocated": _relocated}) + "\n")
                except Exception:
                    pass
            if MODEL_LOAD_BLOCK and _missing:
                return None, ("blocked: model not loaded/unreachable for " + ", ".join(sorted(_missing)))
        except Exception:
            pass
        hist = _load_history("group")
        run = {"id": rid, "status": "running", "prompt": full_text[:4000],
               "cast": (_goal_round_cast or (extra or {}).get("cast_override") or mentioned or names),
               "settled": [], "nudges": 0, "phase": "prompt",
               "started": time.time(), "ended": None, "verdict": None, "error": None,
               "hist_start": len(hist)}
        if _mls is not None:
            run["model_load"] = _mls
        if extra:
            run.update(extra)
        _save_group_run(run)
        _append_history("group", [{"speaker": "You", "content": full_text}])
        _run_stops[rid] = threading.Event()
        _active_run_id = rid
    _run_event(rid, {"run": "start", "prompt": full_text[:4000]})
    _save_run_state({"busy": True, "mode": "group", "phase": "prompt",
                     "ts": int(time.time() * 1000), "run_id": rid})
    threading.Thread(target=_group_run_worker, args=(rid,), daemon=True).start()
    threading.Thread(target=_stall_killer, args=(rid,), daemon=True).start()
    return run, None


def _agent_goals_block(name):
    """One short nudge per agent: its own open goals from memory/goals/<slug>.md, so group
    turns push toward progress instead of re-verification (2026-11-15 goal-drift fix).
    2026-11-16 (goal-stall fix): parses with the STRICT ledger so evidence-closed goals no longer
    show as open - the old naive regex re-listed them every turn and agents kept re-verifying
    finished work. Also spells out the closure procedure: chat claims do not count, only a
    (verified:)/(pointer:) marker on the goal line does."""
    try:
        path = os.path.join(HERE, "memory", "goals", name.lower() + ".md")
        items, reached_n = [], 0
        try:
            for g in _goal_ledger_mod().parse_agent_file(path):
                if g["status"] == "reached":
                    reached_n += 1
                    continue
                it = g["text"].replace("\n", " ")
                items.append(it[:160])
                if len(items) >= 5:
                    break
        except Exception:
            with open(path, encoding="utf-8") as f:      # ledger import failed - naive fallback
                for ln in f.read(8000).splitlines():
                    m = re.match(r"^\s*(?:\d+[.)]\s+|[-*]\s*\[ \]\s*)(.*)", ln)
                    if not m or "(verified:" in ln:
                        continue
                    it = m.group(1).strip()
                    if it and len(it) >= 12:
                        items.append(it[:160])
                        if len(items) >= 5:
                            break
        items_txt = ("\n".join(items) if items else "(none open - you are at 100%; assist other agents' open goals)")
        base = ("YOUR OPEN GOALS (memory/goals/%s.md, %d/10 reached - make progress on these):\n%s"
                % (name.lower(), reached_n, items_txt))
        base += ("\nCLOSURE PROCEDURE (chat claims do NOT count): when a goal's acceptance test passes, run "
                 "`python memory/researcher/goal_ledger.py --record %s <goal#> --note '<what ran + artifact path>'` - "
                 "it appends the (verified:) marker the dashboard counts. Or write an evidence leaf in memory/%s/ "
                 "AND add a line to that lane's INDEX.md - the end-of-run sweep auto-links it." % (name.lower(), name.lower()))
        base += ("\nTEAM RULES: (1) You may ASSIST another agent's open goal when you can unblock it - "
                 "coordinate in cross-talk and credit the original owner in the evidence note. "
                 "(2) ANTI-LOOP: if your last two turns produced no new file change, measurement or evidence, "
                 "stop re-verifying and take ONE concrete next step (or hand off / assist). "
                 "(3) ANTI-REPEAT: never re-issue a goal already in your file or closed in an earlier round "
                 "(memory/goals/closed_topics.json); new work must be genuinely new.")
        try:
            _rt = (_load_round_topic().get("current") or {})
            if _rt.get("topic"):
                base += ("\nROUND TOPIC (this cycle's focus - new work should serve it): %s"
                         % str(_rt["topic"])[:140])
        except Exception:
            pass
        return base[:2200]
    except Exception:
        return ""


_portal_live = False          # (2026-11-15) True once THIS process has bound the port; only it may mutate run state
AUTO_RESUME_WINDOW_S = 6 * 3600   # resume interrupted/stalled runs ended within this window


def _stall_killer(run_id):
    """Wall-clock wedge guard (2026-11-15): a socket timeout only bounds idle reads - a model that
    trickles one token per minute never trips it, and a wedged turn x 8 agents froze the fleet for
    71 min. If NO frame is journaled for STALL_KILL_S, stop the run; the auto-resume watchdog then
    restarts it (a fresh process/model state usually clears the wedge)."""
    while True:
        time.sleep(30)
        if _active_run_id != run_id:
            return
        last = _run_last_frame.get(run_id)
        if last is None:
            # 2026-11-16 zero-frame guard: a hang BEFORE the first token never sets
            # _run_last_frame, so the old check could never fire (fleet wedged 2x today).
            # Fall back to run start time as the reference.
            try:
                r0 = _load_group_run()
                if r0.get("id") == run_id and r0.get("started"):
                    last = r0["started"]
            except Exception:
                pass
        if last and time.time() - last > STALL_KILL_S:
            try:
                run = _load_group_run()
                if run.get("id") == run_id:
                    run["stalled"] = True
                    _save_group_run(run)
            except Exception:
                pass
            ev = _run_stops.get(run_id)
            if ev:
                ev.set()
            return


def _auto_resume_watchdog():
    """Backend-owned continuity (2026-11-15): when a group run ends interrupted/stalled - or ends
    without [CONCLUDED] while goals are still open - start the continuation automatically. Nothing
    waits on the frontend; a hard refresh or a portal crash no longer idles the fleet.
    Capped at AUTO_RESUME_MAX consecutive auto-resumes (reset by a clean conclusion); after that a
    human follow-up is required, per the run verdict."""
    while True:
        time.sleep(20)
        if not _portal_live or _active_run_id:
            continue
        try:
            run = _load_group_run()
            rid = run.get("id")
            if not rid:
                continue
            status = run.get("status")
            age = time.time() - (run.get("ended") or 0)
            resumable = ((status in ("interrupted", "stalled") and age < AUTO_RESUME_WINDOW_S)
                         or (status == "done" and age < 1800))
            if not resumable:
                continue
            n = int(run.get("auto_resume_count") or 0) + 1
            if n > AUTO_RESUME_MAX:
                continue   # budget spent - wait for a human follow-up
            time.sleep(AUTO_RESUME_DELAY_S)
            if _active_run_id:   # a human may have started one in the meantime
                continue
            why = {"interrupted": "interrupted by a portal restart",
                   "stalled": "stalled (no model output for %d min)" % (STALL_KILL_S // 60),
                   "done": "ended without [CONCLUDED]"}.get(status, status)
            prompt = ("\u21bb AUTO-RESUME %d/%d (backend watchdog): the previous group run was %s. "
                      "Continue exactly where it left off - do NOT re-read closed work or restate plans. "
                      "Each agent: take ONE concrete next step on your open goal lanes, update "
                      "memory/goals/<you>.md with evidence as you go, then reply [CONCLUDED] when the "
                      "cycle's tasks are done." % (n, AUTO_RESUME_MAX, why))
            start_group_run(prompt, extra={"auto_resume_count": n})   # budget persisted atomically with the run
        except Exception:
            pass


# ---- AUTO-LOOP (2026-11-16, Arnold; 2026-11-17 batch fire): idle agents re-enter the work queue
# within ~1 minute. Rule: an agent that is idle must NOT wait for everyone else to finish.
# Per-agent task priority: (1) queued human messages, (2) its own open goals (one concrete step +
# ledger evidence), (3) a rare maintenance sweep at 100% ("what else can I do while we wait").
# 2026-11-17: the watchdog no longer picks ONE agent per tick - it fires ALL idle agents AT ONCE:
# one solo group run whose cast is every idle seat, with a per-agent task section in the broadcast
# (each seat acts only on its own section; behaviour analysis of their last reply steers the task).
# The pass runs through the normal group-run machinery (one parallel turn per seat), so it is
# journaled, stall-guarded, evidence-swept and auto-committed. Detail: memory/ops/autoloop.md
_agent_last_active = {}      # name -> epoch of last completed turn (in-memory truth)
_autoloop_lock = threading.Lock()
_ALOGGER_MOD = None


def _autoloop_file():
    return os.path.join(HERE, "memory", "ops", "autoloop.json")


def _autoloop_load():
    try:
        with open(_autoloop_file(), encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def _autoloop_save(d):
    try:
        os.makedirs(os.path.dirname(_autoloop_file()), exist_ok=True)
        tmp = _autoloop_file() + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False)
        os.replace(tmp, _autoloop_file())
    except Exception:
        pass


def autoloop_touch(name, ts=None):
    """Record that an agent just finished a turn (its idle clock restarts)."""
    with _autoloop_lock:
        _agent_last_active[name] = ts or time.time()
        d = _autoloop_load()
        d.setdefault("last_active", {})[name] = _agent_last_active[name]
        _autoloop_save(d)

    # Auto-Loop Pass Logger (Builder goal 4, cycle 15): one JSONL record per pass.
    global _ALOGGER_MOD
    try:
        if _ALOGGER_MOD is None:
            import importlib.util as _ilu
            _sp = _ilu.spec_from_file_location(
                "autoloop_logger",
                os.path.join(os.path.dirname(os.path.abspath(__file__)),
                             "memory", "builder", "autoloop_logger.py"))
            _ALOGGER_MOD = _ilu.module_from_spec(_sp)
            _sp.loader.exec_module(_ALOGGER_MOD)
        _ALOGGER_MOD.log_pass(name)
    except Exception:
        pass


def autoloop_note_human():
    """Any human input (queued message or run) resets the auto-pass streak budget."""
    with _autoloop_lock:
        d = _autoloop_load()
        if d.get("streak"):
            d["streak"] = 0
            d["last_human_ts"] = time.strftime("%Y-%m-%d %H:%M:%S")
            _autoloop_save(d)


def _agent_open_goals(name, limit=5):
    """One-line-per-open-goal list for pass prompts (2026-11-23): skips the ~minute of
    re-derivation each agent used to spend every pass re-reading its goal file and
    re-reasoning about what state things are in."""
    try:
        path = os.path.join(HERE, "memory", "goals", name.lower() + ".md")
        items = [g for g in _goal_ledger_mod().parse_agent_file(path) if g["status"] != "reached"]
        return [("%d. %s" % (i + 1, str(g.get("text") or "").strip()[:200])) for i, g in enumerate(items[:limit])]
    except Exception:
        return []


def _agent_open_goal_count(name):
    try:
        path = os.path.join(HERE, "memory", "goals", name.lower() + ".md")
        return sum(1 for g in _goal_ledger_mod().parse_agent_file(path) if g["status"] != "reached")
    except Exception:
        return 0


def _autoloop_behaviour_hint(name):
    """Behaviour analysis (2026-11-17): read this agent's LAST substantive group-chat reply and
    derive a one-line context for its next auto-loop task, so the batch pass continues where the
    agent actually left off instead of re-running what it already did.
    Signals, in priority order: (1) remaining-work lines ('Remaining open: ...', 'next step: ...')
    -> continue, don't redo; (2) blocker claims (unreachable / blocked by / powered off / must run
    on X) -> work AROUND it, don't re-probe the same wall; (3) an auto-loop pass that ended WITHOUT
    [CONCLUDED] -> finish the in-flight work first. [SILENT]-only tails are ignored."""
    try:
        hist = _load_history("group")
    except Exception:
        return ""
    last_text, last_concluded, was_autoloop = None, False, False
    for m in reversed(hist):
        who = (m.get("speaker") or "").strip().lower()
        content = (m.get("content") or "").strip()
        if not content:
            continue
        if who == "you":
            if last_text is None:   # the human message immediately before this agent's reply
                was_autoloop = content.lower().startswith("auto-loop")
            continue
        if who != name.lower():
            continue
        _, is_silent, concluded = _effective_reply(content)
        if is_silent:
            continue
        last_text = content
        # agents often put the marker at the END of the reply, not the start - count both
        last_concluded = concluded or "[concluded]" in content.lower()
        break
    if not last_text:
        return ""
    tail = last_text[-1400:]
    # a real remaining-work line is 'Remaining open: ...' / 'Next step (...): ...' - keyword
    # followed by a colon; narration like 'styles remain. Now I need...' has no colon and must not match
    mrem = re.search(r"\b(remaining|next step|still open)\s+[(a-z) ]{0,20}:[^\n]{0,160}", tail, re.I)
    if mrem:
        frag = mrem.group(0).replace("**", "").strip()[:200]
        return ("BEHAVIOUR: your last pass left remaining work - continue from there, do NOT redo it: %s"
                % frag)
    mblk = re.search(r"[^\n]*(blocked by|unreachable|can'?t be started|must run on|powered off)[^\n]*",
                     tail, re.I)
    if mblk:
        frag = mblk.group(0).strip(" *#-").replace("**", "")[:160]
        return ("BEHAVIOUR: you reported a blocker last pass (%s) - take ONE step that does NOT depend "
                "on it (another open goal, evidence/ledger upkeep, or assist another agent's lane); do "
                "not re-probe the same wall.") % frag
    if was_autoloop and not last_concluded:
        return ("BEHAVIOUR: your last auto-loop pass ended WITHOUT [CONCLUDED] - first finish whatever "
                "was in flight (check your evidence/ledger state), then take one more step on your "
                "oldest open goal.")
    return ""


def _autoloop_state():
    """GET /api/autoloop - live view of the idle re-entry loop."""
    with _autoloop_lock:
        d = dict(_autoloop_load())
        la = {k: float(v) for k, v in _agent_last_active.items()}
        la.update({k: float(v) for k, v in (d.get("last_active") or {}).items() if k not in la})
    now = time.time()
    agents = load_agents()["agents"]
    open_by_name = {a.get("name", ""): _agent_open_goal_count(a.get("name", ""))
                    for a in agents if a.get("name")}
    # paused only when the maintenance budget is spent AND no seat has real work left -
    # productive passes (queued msg / open goal) are exempt from the cap (2026-11-17 budget fix)
    paused = int(d.get("streak", 0)) >= AUTOLOOP_MAX_STREAK and not any(open_by_name.values())
    out = {"ok": True, "idle_s": AUTOLOOP_IDLE_S, "tick_s": AUTOLOOP_TICK_S,
           "streak": int(d.get("streak", 0)), "max_streak": AUTOLOOP_MAX_STREAK,
           "paused": paused,
           "last_human_ts": d.get("last_human_ts"), "last_pass": d.get("last_pass"),
           "agents": {}}
    for a in agents:
        n = a.get("name", "?")
        ts = float(la.get(n) or PORTAL_START)
        out["agents"][n] = {"idle_s": int(now - ts),
                            "open_goals": open_by_name.get(n, 0)}
    return out


def _autoloop_watchdog():
    """One scheduler tick every AUTOLOOP_TICK_S: when NO group run is active, ALL idle agents are
    fired at once (2026-11-17) - one solo pass whose cast is every idle seat, each with its own task
    section. Per-agent priority inside the broadcast: queued human messages first (UMQ injects them),
    else their oldest open goal, else a maintenance sweep at 100%. Seats whose model is not ready are
    excluded from the batch (their lanes stay covered by seat-drafted goals)."""
    while True:
        time.sleep(AUTOLOOP_TICK_S)
        if not _portal_live or _active_run_id:
            continue
        try:
            with _autoloop_lock:
                d = dict(_autoloop_load())
                la = {k: float(v) for k, v in (d.get("last_active") or {}).items()}
                la.update({k: float(v) for k, v in _agent_last_active.items()})
            now = time.time()
            names = [a.get("name", "") for a in load_agents()["agents"] if a.get("name")]
            for n in names:
                la.setdefault(n, PORTAL_START)   # fresh restart: no burst of passes
            idle = [n for n in names if now - la[n] >= AUTOLOOP_IDLE_S]
            if not idle:
                continue
            # 2026-11-17 batch fire: For(allThatsIdle) giveTask - every idle seat gets its task in
            # ONE parallel pass instead of one serial agent per tick. Seats whose model is not ready
            # are excluded (firing a dead seat only wastes a turn; the run-start check already notes
            # them for everyone else).
            try:
                mls = _model_load_status(timeout=AUTOLOOP_PROBE_TIMEOUT_S)
            except Exception:
                mls = {}
            # 2026-11-23 (Arnold: fleet slower than one LLM): only seats whose model is CONFIRMED loaded
            # run from home. A probe that timed out (no status) used to count as ready - dead seats were
            # fired, their turns hung tokenless for 20+ min and stretched every pass until a human stopped
            # it (journal g-1a204f69381: Archivist 2 frames in 20m52s). Unknown => down chain instead.
            ready = [n for n in idle if mls.get(n, {}).get("status") == "ok"]
            # HOST-AGNOSTIC PLACEMENT (2026-11-22): a seat whose home model is down can still
            # be fired when another reachable host has its model resident - single-host op.
            for n in idle:
                if n in ready:
                    continue
                _ag = _agents_by_name().get(n) or {}
                try:
                    _s = _resolve_seat(_ag)
                    if _s and _s["base"] != _studio_base(_ag):
                        ready.append(n)
                except Exception:
                    pass
            ready = ready[:AUTOLOOP_BATCH_MAX]
            # 2026-11-17/19: seats whose model stays down are NOT silently skipped forever.
            # Self-recovery chain - NO human step required (reboots approved 11-15):
            #   unreachable + model loaded -> busy while generating; unresponsive for
            #       30+ min = WEDGED engine: unload+reload (Archivist 11-18/19 case)
            #   not_loaded / unreachable   -> native /api/inference/load (the old
            #       /v1/models/<m>/load endpoint 405s on every host - was silently broken)
            #   host TCP down              -> remote reboot via WinRM; boot tasks reload models
            #   chain exhausted ~45 min    -> NEEDS-HUMAN line as LAST resort (retries
            #       continue on cooldowns regardless, so a human is never required)
            down = [n for n in idle if mls.get(n, {}).get('status') not in (None, 'ok')]
            streaks = d.setdefault('down_streak', {})
            busy_ticks = d.setdefault('busy_ticks', {})
            for _n in list(streaks):
                if _n not in down:
                    streaks.pop(_n, None)
            for _n in list(busy_ticks):
                if _n not in down:
                    busy_ticks.pop(_n, None)
            episodes = d.setdefault('down_episode', {})   # name -> {"since","reloads","last_reload","reboots","notified"}
            for _n in down:
                _st = mls.get(_n, {}).get('status')
                _agx = _agents_by_name().get(_n, {})
                if _st != 'ok' and _seat_busy(_agx):
                    # model IS resident but not answering: fine while generating; after 30 min
                    # of continuous silence the engine is wedged -> unload+reload same recipe
                    busy_ticks[_n] = busy_ticks.get(_n, 0) + 1
                    if busy_ticks[_n] >= 120:
                        epb = episodes.setdefault(_n, {"since": now, "reloads": 0, "last_reload": 0.0})
                        if epb["reloads"] >= 3 and now - epb.get("last_reload", 0) >= 1800:   # RE-ARM (2026-11-22)
                            epb.update(reloads=0, notified=False)
                        if epb["reloads"] < 3 and now - epb["last_reload"] >= 600:
                            epb["reloads"] += 1
                            epb["last_reload"] = now
                            _recover_seat_async(_n, _agx, 'wedged')
                        if now - epb.get("since", now) >= 2700 and epb.get("reboots", 0) < 1:
                            # WEDGED-ENGINE ESCALATION (2026-11-25): Scribe/Red case - engine hung,
                            # Studio HTTP alive, API unload+load can never clear it. Reboot the
                            # seat host like the TCP-down path does (boot tasks reload its models).
                            _ip = _remote_host_ip(_agx)
                            if _ip:
                                epb["reboots"] = 1

                                def _rbw(ip=_ip, n=_n):
                                    try:
                                        okk, det = _winrm_reboot(ip)
                                        print('[autoloop] reboot %s (%s): %s - %s' % (n, ip, 'OK' if okk else 'FAIL', det[:80]))
                                    except Exception as e:
                                        print('[autoloop] reboot %s failed: %s' % (n, str(e)[:80]))
                                threading.Thread(target=_rbw, daemon=True).start()
                    continue
                streaks[_n] = streaks.get(_n, 0) + 1
                ep = episodes.setdefault(_n, {"since": now, "reloads": 0, "last_reload": 0.0})
                # RE-ARM (2026-11-22): counters used to stay exhausted forever once spent
                # (Researcher: 4 loads tried, chain then silent all day). Fresh cycle after 30 min.
                if ep["reloads"] >= 4 and now - ep.get("last_reload", 0) >= 1800:
                    ep.update(reloads=0, reboots=0, notified=False, since=now)
                if _st == 'not_loaded' and streaks[_n] >= 4 and ep["reloads"] < 4 and now - ep["last_reload"] >= 300:
                    ep["reloads"] += 1
                    ep["last_reload"] = now
                    _recover_seat_async(_n, _agx, 'load')
                elif streaks[_n] >= 8 and ep["reloads"] < 3 and now - ep["last_reload"] >= 300:
                    if _host_alive(_agx) or not _remote_host_ip(_agx):
                        # Studio reachable (or local seat): unload+load the model
                        ep["reloads"] += 1
                        ep["last_reload"] = now
                        _recover_seat_async(_n, _agx, 'reload')
                    elif streaks[_n] >= 60 and ep.get("reboots", 0) < 1:
                        # host itself is down (TCP refused): reboot via WinRM - boot tasks
                        # reload its models on restart (approved 11-15, Mechanic #3)
                        _ip = _remote_host_ip(_agx)
                        ep["reboots"] = 1
                        ep["last_reload"] = now

                        def _rb(ip=_ip, n=_n):
                            try:
                                okk, det = _winrm_reboot(ip)
                                print('[autoloop] reboot %s (%s): %s - %s' % (n, ip, 'OK' if okk else 'FAIL', det[:80]))
                            except Exception as e:
                                print('[autoloop] reboot %s failed: %s' % (n, str(e)[:80]))
                        threading.Thread(target=_rb, daemon=True).start()
                # WEDGED-ENGINE ESCALATION (2026-11-25): Studio HTTP alive but engine hung -
                # API unload+load loops forever once reloads are spent (Scribe/Red 11-25 case).
                if _st not in (None, 'ok') and streaks[_n] >= 180 and ep["reloads"] >= 3 and ep.get("reboots", 0) < 1:
                    _ip = _remote_host_ip(_agx)
                    if _ip:
                        ep["reboots"] = 1

                        def _rbw2(ip=_ip, n=_n):
                            try:
                                okk, det = _winrm_reboot(ip)
                                print('[autoloop] reboot %s (%s): %s - %s' % (n, ip, 'OK' if okk else 'FAIL', det[:80]))
                            except Exception as e:
                                print('[autoloop] reboot %s failed: %s' % (n, str(e)[:80]))
                        threading.Thread(target=_rbw2, daemon=True).start()
                if streaks[_n] >= 180 and not ep.get('notified'):   # ~45 min: whole chain exhausted
                    ep['notified'] = True
                    try:
                        with open(os.path.join(HERE, 'memory', 'ops', 'blockers.md'), 'a', encoding='utf-8') as _bf:
                            _bf.write('- [%s] OPS-NOTE (auto-retry continues, no human step required): seat %s down ~%d min (%s) - auto-reload x%d + reboot x%d attempted; chain re-arms on cooldown.\n'
                                      % (time.strftime('%H:%M'), _n, streaks[_n] * AUTOLOOP_TICK_S // 60, _st, ep.get('reloads', 0), ep.get('reboots', 0)))
                    except Exception:
                        pass
            # machine-readable state so UI/tools can surface stuck seats; removed when all up.
            try:
                _ds = os.path.join(HERE, 'memory', 'ops', 'down-seats.json')
                if down:
                    with open(_ds, 'w', encoding='utf-8') as _f:
                        json.dump({"ts": time.strftime('%Y-%m-%dT%H:%M:%S'),
                                   "seats": [{"seat": _n, "status": mls.get(_n, {}).get('status'),
                                              "down_ticks": streaks.get(_n, busy_ticks.get(_n, 0)),
                                              "reload_attempts": episodes.get(_n, {}).get('reloads', 0),
                                              "reboots": episodes.get(_n, {}).get('reboots', 0)} for _n in down]}, _f)
                elif os.path.exists(_ds):
                    os.remove(_ds)
            except Exception:
                pass
            sections, why_bits, productive = [], [], False
            for n in ready:   # per-agent task, steered by behaviour analysis of their last reply
                try:
                    pend = umq_pending_for(n, names)
                except Exception:
                    pend = []
                og = _agent_open_goal_count(n)
                idle_s = int(now - la[n])
                hint = _autoloop_behaviour_hint(n)
                if pend:
                    productive = True
                    why_bits.append("%s:queued-msg" % n.lower())
                    body = ("a queued human message is waiting and will be injected below - handle it "
                            "FIRST, then take ONE concrete step on your open goals.")
                elif og > 0:
                    productive = True
                    why_bits.append("%s:%d-open" % (n.lower(), og))
                    glines = _agent_open_goals(n)
                    goal_list = ("\n".join(glines) + "\n") if glines else ""
                    # 2026-11-23 (Arnold: fleet slower than one LLM): work-to-completion passes.
                    # "ONE step" per pass meant a goal needing N steps took N x (pass time + idle
                    # gap); a single LLM iterates to done inside ONE turn - that's why it outpaced
                    # the whole fleet. Pass cap (PASS_TIMEOUT_S) is the backstop for long work.
                    body = ("Work your oldest open goal TO COMPLETION this pass. Your open goals:\n%s"
                            "Iterate tool calls (terminal/python/edit_file) until its verification criteria are "
                            "genuinely met, then mark it reached in memory/goals/%s.md with a timestamped evidence line. "
                            "If budget remains, take the next-oldest open goal and do the same. Keep reasoning terse - "
                            "act, don't deliberate. Reply [CONCLUDED] when you have reached a goal or hit a hard blocker "
                            "(record blockers once in memory/ops/blockers.md)." % (goal_list, n.lower()))
                elif now - la[n] >= AUTOLOOP_MAINT_COOLDOWN_S:
                    why_bits.append("%s:maint" % n.lower())
                    _generic_menu = "pick ONE of: (a) write a prediction/forecast for another agent's open goal into memory/goals/, (b) draft a solution or workflow improvement into memory/ops/, (c) verify and close one stale evidence claim in the ledger, (d) do one concrete step on another agent's oldest open goal. Reply [SILENT] only if you genuinely checked all four and found nothing actionable."
                    rot = _idle_rotation_task(n)
                    fm = _fleet_mode_now()
                    if rot and fm in ("MAINTENANCE", "IDLE"):
                        body = ("your goals are 100% reached and the fleet is in %s mode - do this ONE role-specific maintenance task (rotated daily): %s. Complete it, produce its measurable output, then record a timestamped evidence line in memory/goals/%s.md. Only if that task is already done or blocked, " % (fm, rot, n.lower())) + _generic_menu
                    else:
                        body = ("your goals are 100% reached - contribute to the team while you wait - " + _generic_menu)
                else:
                    continue   # at 100% inside maintenance cooldown - no task for this seat yet
                sections.append((n, "@%s (idle %d s): %s%s" % (
                    n, idle_s, body, (" " + hint) if hint else "")))
            if not sections:
                continue   # all at 100% inside cooldown - genuinely nothing to do yet
            # 2026-11-17 budget fix: AUTOLOOP_MAX_STREAK exists to stop pointless maintenance
            # sweeps at 100% (GPU cost). It must NEVER pause real work - a pass that hands any seat
            # a queued human message or an open-goal task is productive and RESTARTS the counter;
            # only all-maintenance batches consume it. (Before this fix, 40 consecutive passes
            # paused the loop for hours while Designer/Scribe/Mechanic still held 9 open goals.)
            if not productive and int(d.get("streak", 0)) >= AUTOLOOP_MAX_STREAK:
                continue   # maintenance budget spent - wait for human input (autoloop_note_human resets)
            # cast = the seats that ACTUALLY got a task section. Firing a seat with no section only
            # burns a full turn on [SILENT] (2026-11-17: batch #2 fired 7, only 3 had sections).
            batch = [n for n, _ in sections]
            why = ", ".join(why_bits)
            prompt = ("AUTO-LOOP (batch pass, %d agents in parallel) - you have been idle. Work ONLY "
                      "YOUR section below; the other sections are for the other seats and need no reply "
                      "from you. Record evidence via the ledger as you go, then reply [CONCLUDED].\n"
                      "If a blocker has repeated across passes, do NOT re-probe it - record it once in memory/ops/blockers.md as an OPS-NOTE (exact command + error + automation path used) and move to your next goal. NEVER wait on a human step: the system is fully automated - admin commands go through `python elev.py <cmd>` (helper on 127.0.0.1:8098), scheduled tasks via schtasks, remote hosts via the WinRM chain.\n"
                      % len(batch)) + "\n".join(t for _, t in sections)
            run, err = start_group_run(prompt, extra={"solo": True, "autoloop_why": why,
                                                      "cast_override": batch})
            if not err:
                d["streak"] = 0 if productive else int(d.get("streak", 0)) + 1
                d["last_pass"] = {"agent": ", ".join(batch), "batch": len(batch), "why": why,
                                  "productive": productive,
                                  "ts": time.strftime("%Y-%m-%d %H:%M:%S")}
                with _autoloop_lock:
                    _autoloop_save(d)
        except Exception:
            pass


def _reap_stale_group_run():
    """Portal restarted mid-run: the worker thread is gone. Mark the run interrupted so the
    UI shows what happened; queued UMQ messages survive and ride the next run."""
    try:
        run = _load_group_run()
        if run.get("id") and run.get("status") == "running":
            run["status"] = "interrupted"
            run["verdict"] = {"note": "\u26a0 Portal restarted mid-run \u2014 this run was interrupted. Queued messages were kept; send a follow-up to continue.", "cls": "warn"}
            run["ended"] = time.time()
            _save_group_run(run)
            _run_event(run["id"], {"run": "end", "status": "interrupted", "verdict": run["verdict"]})
    except Exception:
        pass


def _prune_run_journals():
    try:
        os.makedirs(RUNS_DIR, exist_ok=True)
        files = sorted((f for f in os.listdir(RUNS_DIR) if f.endswith(".journal")), reverse=True)
        for f in files[RUN_KEEP:]:
            os.remove(os.path.join(RUNS_DIR, f))
    except Exception:
        pass


# NOTE (2026-11-15): _reap_stale_group_run / _clear_stale_busy / _prune_run_journals are NO LONGER
# called at import time. Any stray instance (or a debug import of this module) used to mark the
# LIVE run interrupted and clear busy - corrupting state while the real portal kept running.
# They now run in __main__ AFTER the port bind succeeds, so only the actual port owner mutates state.


def _clear_stale_busy():
    """A dead process leaves run_state.json with busy:true. If no group run is live, that flag
    is a lie - clear it so a fresh tab never thinks the portal is mid-run."""
    try:
        st = _load_run_state() or {}
        run = _load_group_run()
        if st.get("busy") and not (run.get("id") and run.get("status") == "running"):
            st["busy"] = False
            _save_run_state(st)
    except Exception:
        pass


# ---- Ops (2026-11-13): TODO pruning + local git repo management ----
TODO_FILE = os.path.join(HERE, "TODO.md")
DONE_FILE = os.path.join(HERE, "TODO_completed.md")
DONE_PART_DIR = os.path.join(HERE, "todo_done_parts")
DONE_MAX_LINES = 240   # completed file splits into numbered parts above this
DONE_PART_SIZE = 200   # lines moved per split (oldest first)
GIT_EXE = os.path.join(HERE, "mingit", "cmd", "git.exe")
PORTAL_START = time.time()   # process start - ground truth for the Ops panel uptime tile


def _ops_snapshot():
    """Ops panel host tiles (2026-11-15): disk usage of the workspace drive +
    portal uptime since this process started. Cross-checkable against
    Win32_LogicalDisk / Win32_Process CreationDate."""
    try:
        drive = os.environ.get("SystemDrive", "C:")
        du = shutil.disk_usage(drive)
        disk = {"drive": drive,
                "total_gb": round(du.total / 2 ** 30, 1),
                "free_gb": round(du.free / 2 ** 30, 1),
                "used_gb": round((du.total - du.free) / 2 ** 30, 1)}
    except Exception as e:
        disk = {"error": str(e)}
    up = int(time.time() - PORTAL_START)
    hh, rem = divmod(up, 3600); mm, ss = divmod(rem, 60)
    return {"ok": True, "pid": os.getpid(),
            "uptime_s": up, "uptime_hm": "%dh %02dm %02ds" % (hh, mm, ss),
            "started": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(PORTAL_START)),
            "disk": disk}


def _memory_health_snapshot():
    """GET /api/memory-health (Scribe goal 9, re-landed 2026-11-17 after clobber loss).
    Eight memory-system health metrics (six original + retrieval_quality + knowledge_gaps).
    Each metric: {value, status in pass|warn|fail, detail}. Never raises."""
    def _latest(subdir, prefix):
        try:
            fs = [f for f in os.listdir(os.path.join(HERE, "memory", subdir))
                  if f.startswith(prefix) and f.endswith(".json")]
            return os.path.join(HERE, "memory", subdir, sorted(fs)[-1]) if fs else None
        except Exception:
            return None

    def _jload(p):
        try:
            with open(p, encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return None

    m = {}
    # 1/6 hot_file_lines - MEMORY.md size vs the 40-line pointer budget.
    try:
        n = len(open(os.path.join(HERE, "MEMORY.md"), encoding="utf-8", errors="replace").read().splitlines())
        m["hot_file_lines"] = {"value": n, "status": "pass" if n <= 40 else ("warn" if n <= 60 else "fail"),
                               "detail": "MEMORY.md lines vs 40-line pointer budget"}
    except Exception as e:
        m["hot_file_lines"] = {"value": None, "status": "fail", "detail": str(e)[:120]}
    # 2/6 orphan_rate - latest orphan-sweep evidence (Scribe).
    d = _jload(_latest("scribe", "orphan-sweep-")) or {}
    if isinstance(d.get("orphan_rate_pct"), (int, float)):
        v = float(d["orphan_rate_pct"])
        m["orphan_rate"] = {"value": v, "status": "pass" if v == 0 else ("warn" if v <= 5 else "fail"),
                            "detail": "%s/%s files referenced by indexes (sweep %s)" % (
                                d.get("referenced_by_indexes", "?"), d.get("total_files_in_memory", "?"),
                                str(d.get("timestamp", "?"))[:10])}
    else:
        m["orphan_rate"] = {"value": None, "status": "fail", "detail": "no orphan-sweep evidence or key mismatch"}
    # 3/6 contradiction_count - latest detector run (Scribe).
    d = _jload(_latest("scribe", "contradiction-detector-")) or {}
    r = d.get("results") or {}
    if isinstance(r.get("failed"), int):
        m["contradiction_count"] = {"value": r["failed"], "status": "pass" if r["failed"] == 0 else "warn",
                                    "detail": "%d/%s claims failed (run %s)" % (r["failed"], r.get("total", "?"), str(d.get("timestamp", "?"))[:10])}
    else:
        m["contradiction_count"] = {"value": None, "status": "fail", "detail": "no detector evidence or key mismatch"}
    # 4/6 supersession_validity - every memory/*.md path cited on a SUPERSEDED line must exist.
    cites, missing = 0, []
    try:
        for f in os.listdir(os.path.join(HERE, "memory", "synthesis")):
            if not f.endswith(".md"):
                continue
            txt = open(os.path.join(HERE, "memory", "synthesis", f), encoding="utf-8", errors="replace").read()
            for line in txt.splitlines():
                if "SUPERSEDED" not in line.upper():
                    continue
                for pth in re.findall(r"memory/[A-Za-z0-9_\-./]+\.md", line):
                    cites += 1
                    if not os.path.isfile(os.path.join(HERE, pth)):
                        missing.append(pth)
    except Exception:
        pass
    m["supersession_validity"] = {"value": len(missing), "status": "pass" if not missing else "fail",
                                  "detail": "%d path cites on SUPERSEDED lines, %d dangling" % (cites, len(missing))}
    # 5/6 owner_coverage_pct - latest owner-coverage ledger (Scribe).
    d = _jload(_latest("scribe", "owner-coverage-ledger-")) or {}
    if isinstance(d.get("active_coverage_pct"), (int, float)):
        v = float(d["active_coverage_pct"])
        m["owner_coverage_pct"] = {"value": v, "status": "pass" if v >= 80 else ("warn" if v >= 50 else "fail"),
                                   "detail": "%s/%s active goals owned (%s)" % (d.get("active_owned", "?"), d.get("active", "?"), d.get("date", "?"))}
    else:
        m["owner_coverage_pct"] = {"value": None, "status": "fail", "detail": "no owner-coverage ledger or key mismatch"}
    # 6/6 durable_copy_integrity - every Scribe leaf referenced by some INDEX.md.
    idx_txt = ""
    try:
        for root, _dirs, files in os.walk(os.path.join(HERE, "memory")):
            if "INDEX.md" in files:
                idx_txt += open(os.path.join(root, "INDEX.md"), encoding="utf-8", errors="replace").read()
    except Exception:
        pass
    unref = []
    try:
        for f in sorted(os.listdir(os.path.join(HERE, "memory", "scribe"))):
            if f.endswith(".md") and f not in idx_txt:
                unref.append(f)
    except Exception:
        pass
    m["durable_copy_integrity"] = {"value": len(unref), "status": "pass" if not unref else "fail",
                                   "detail": "%d Scribe leaves unreferenced by any INDEX.md" % len(unref)}
    # 7/8 retrieval_quality - latest archivist retrieval benchmark (cycle-5 goal 9).
    d = _jload(os.path.join(HERE, "memory", "archivist", "retrieval_metrics.json")) or {}
    if isinstance(d.get("precision_at_5"), (int, float)):
        rts = d.get("run_ts", "?")
        try:
            rts = time.strftime("%Y-%m-%d", time.localtime(float(rts)))
        except Exception:
            pass
        m["retrieval_quality"] = {"value": round(float(d.get("mrr", 0)), 3),
                                  "status": "pass" if d.get("recall_at_10", 0) >= 0.9 else ("warn" if d.get("precision_at_5", 0) >= 0.7 else "fail"),
                                  "detail": "P@5=%s R@10=%s MRR=%s over %s queries (%s)" % (d.get("precision_at_5"), d.get("recall_at_10"), d.get("mrr"), d.get("n_queries", "?"), rts)}
    else:
        m["retrieval_quality"] = {"value": None, "status": "fail", "detail": "no retrieval_metrics.json (run archivist/retrieval_benchmark.py)"}
    # 8/8 knowledge_gaps - open gaps from latest gap report (cycle-5 goal 9).
    try:
        gtxt = open(os.path.join(HERE, "memory", "archivist", "knowledge_gaps.md"), encoding="utf-8", errors="replace").read()
        ngaps = len(re.findall(r"^## \d+\. Suggested title", gtxt, re.M))
        m["knowledge_gaps"] = {"value": ngaps, "status": "warn" if ngaps else "pass",
                               "detail": "%d recurring topics without a KB entry (archivist/knowledge_gaps.md)" % ngaps}
    except Exception as e:
        m["knowledge_gaps"] = {"value": None, "status": "fail", "detail": "no knowledge_gaps.md: %s" % str(e)[:80]}
    try:
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
    except Exception:
        ts = "?"
    return {"ok": True, "ts": ts, "metrics": m}


# ---- LEVEL COUNTER (2026-11-20, user request) ---------------------------------------
# Every time ALL agent goals reach 100% for a goal set that differs from the one at the
# previous level-up, the fleet level goes up by 1 and a "what changed" report is written
# to memory/levels/. Signature-gated (SHA-256 of the current goal files): re-parsing the
# same completed set never double-counts; the post-100% goal re-draft changes the
# signature and arms the next cycle. State: memory/levels.json. Never raises - a level
# failure must not break /api/goals or the auto-loop tick that also calls _goals_snapshot.
LEVELS_FILE = os.path.join(HERE, "memory", "levels.json")
LEVELS_DIR = os.path.join(HERE, "memory", "levels")
LEVEL_HEARTBEAT_S = 120   # autonomous level-check tick (2026-11-23): worst-case lag from 100% to level-up
_LEVEL_LOCK = None


def _level_lock():
    global _LEVEL_LOCK
    if _LEVEL_LOCK is None:
        import threading as _th
        _LEVEL_LOCK = _th.Lock()
    return _LEVEL_LOCK


def _goal_parser():
    """parse_agent_file from the strict goal_ledger (memory/researcher/) first, portal-root
    goal_ledger.py only as last resort (its EVIDENCE_PAT matches '[x]' itself)."""
    import importlib.util as _ilu
    for _cand in (os.path.join(HERE, "memory", "researcher", "goal_ledger.py"),):
        try:
            _spec = _ilu.spec_from_file_location("_gl_strict", _cand)
            _mod = _ilu.module_from_spec(_spec); _spec.loader.exec_module(_mod)
            return _mod.parse_agent_file
        except Exception:
            continue
    try:
        import goal_ledger as _gl
        return _gl.parse_agent_file
    except Exception:
        return None


def _level_sig():
    """SHA-256 over the sorted contents of every agent goal file - identity of the current
    goal set (same file filter as _goals_snapshot)."""
    import hashlib
    h = hashlib.sha256()
    gdir = os.path.join(HERE, "memory", "goals")
    try:
        names = {(a.get("name") or "").lower() for a in load_agents().get("agents", [])}
        for fn in sorted(os.listdir(gdir)):
            if not fn.endswith(".md") or fn[:-3] == "INDEX" or fn.startswith("GOAL_"):
                continue
            if names and fn[:-3].lower() not in names:
                continue
            with open(os.path.join(gdir, fn), "rb") as f:
                h.update(fn.encode()); h.update(f.read())
    except Exception:
        pass
    return h.hexdigest()


def _load_levels():
    try:
        with open(LEVELS_FILE, encoding="utf-8") as f:
            d = json.load(f)
        if not isinstance(d, dict) or "level" not in d:
            raise ValueError("bad shape")
        d.setdefault("history", [])
        return d
    except Exception:
        return {"level": 0, "last_sig": "", "last_sha": "", "history": []}


def _save_levels(d):
    try:
        os.makedirs(LEVELS_DIR, exist_ok=True)
        tmp = LEVELS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, indent=1)
        os.replace(tmp, LEVELS_FILE)
    except Exception:
        pass


def _level_report_md(level, prev_sha, snap):
    """Level-N report: what changed since the previous level-up (git log + diff stat
    between the two level-up commits) and which goals were completed this cycle."""
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    lines = ["# Level %d - all goals 100%%" % level, "",
             "Fleet: %s/%s goals reached at level-up (%s)." % (
                 snap.get("fleet_done"), snap.get("fleet_total"), ts), ""]
    if prev_sha:
        lg = _git(["log", "--oneline", "%s..HEAD" % prev_sha], max_out=12000)
        df = _git(["diff", "--stat", "%s..HEAD" % prev_sha], max_out=8000)
        lines += ["## What changed since level %d (git %s..HEAD)" % (level - 1, prev_sha[:7]), ""]
        if lg.get("ok") and lg["out"]:
            lines += ["```", lg["out"], "```", ""]
        else:
            lines += ["(no commits since the previous level-up)", ""]
        if df.get("ok") and df["out"]:
            lines += ["### Diff stat", "", "```", df["out"], "```", ""]
    else:
        lg = _git(["log", "--oneline", "-n", "20"], max_out=6000)
        lines += ["## What changed (first level - recent history)", ""]
        if lg.get("ok") and lg["out"]:
            lines += ["```", lg["out"], "```", ""]
    lines += ["## Goals completed this cycle", ""]
    parse = _goal_parser()
    gdir = os.path.join(HERE, "memory", "goals")
    for a in snap.get("agents", []):
        reached = []
        if parse:
            try:
                reached = [g["text"][:200] for g in parse(os.path.join(gdir, a["agent"] + ".md"))
                           if g["status"] == "reached"]
            except Exception:
                reached = []
        lines.append("### %s (%d/%d)" % (a["agent"], len(reached), a["total"]))
        for t in reached:
            lines.append("- " + t)
        lines.append("")
    lines += ["Next cycle: a new goal-setting round is armed (GOAL_RESET_PENDING); the next",
              "100%% on the fresh goal set will be level %d." % (level + 1)]
    return "\n".join(lines) + "\n"


def _check_level_up(snap):
    """All goals 100% for a goal set not yet leveled -> level += 1, write
    memory/levels/level_N_<ts>.md and persist memory/levels.json. Idempotent per
    goal-set signature; returns {level, latest_level_report} to merge into /api/goals."""
    with _level_lock():
        sig = _level_sig()
        st = _load_levels()
        if sig == (st.get("last_sig") or ""):
            hist = st.get("history") or []
            return {"level": int(st.get("level", 0)),
                    "latest_level_report": hist[-1].get("report") if hist else None,
                    "level_cycles": len(hist)}
        level = int(st.get("level", 0)) + 1
        prev_sha = (st.get("last_sha") or "").strip()
        head_r = _git(["rev-parse", "HEAD"])
        head_sha = head_r["out"].strip() if head_r.get("ok") else ""
        os.makedirs(LEVELS_DIR, exist_ok=True)
        report_rel = "memory/levels/level_%d_%s.md" % (level, time.strftime("%Y%m%d-%H%M%S"))
        try:   # build BEFORE opening the file - a failed build must not leave a 0-byte report
            md = _level_report_md(level, prev_sha, snap)
            with open(os.path.join(HERE, report_rel), "w", encoding="utf-8") as f:
                f.write(md)
        except Exception:
            pass
        entry = {"level": level, "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
                 "sha": head_sha[:7], "sig": sig[:16],
                 "fleet": "%s/%s" % (snap.get("fleet_done"), snap.get("fleet_total")),
                 "report": report_rel}
        st["history"] = (st.get("history") or []) + [entry]
        st["level"] = level
        st["last_sig"] = sig
        st["last_sha"] = head_sha
        _save_levels(st)
    return {"level": level, "latest_level_report": report_rel,
            "level_cycles": len(st["history"])}


# ---- ROUND TOPIC + ANTI-REPEAT LEDGER (P1, 2026-11-22, user request) -----------------
# Every goal-setting round has a TOPIC: a short name + paragraph describing the collection
# of goals for that round. The user can QUEUE topics (POST /api/goals/topic); each new round
# pops the next queued topic as its focus. If none is queued, the Orchestrator sets one before
# goals are drafted. Anti-repeat: every goal line at 100% is hashed into
# memory/goals/closed_topics.json; goal-setting prompts list recent closed topics so agents
# never re-issue finished work verbatim or near-verbatim.
ROUND_TOPIC_FILE = os.path.join(HERE, "memory", "goals", "round_topic.json")
CLOSED_TOPICS_FILE = os.path.join(HERE, "memory", "goals", "closed_topics.json")


def _norm_topic(t):
    return re.sub(r"\W+", " ", (t or "").lower()).strip()[:120]


def _load_round_topic():
    try:
        with open(ROUND_TOPIC_FILE, encoding="utf-8") as f:
            d = json.load(f)
        if not isinstance(d, dict):
            raise ValueError("bad shape")
        d.setdefault("current", None); d.setdefault("queue", []); d.setdefault("past", [])
        return d
    except Exception:
        return {"current": None, "queue": [], "past": []}


def _save_round_topic(d):
    try:
        tmp = ROUND_TOPIC_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(d, f, indent=1)
        os.replace(tmp, ROUND_TOPIC_FILE)
    except Exception:
        pass


def _round_topic_snapshot():
    d = _load_round_topic()
    return {"ok": True, "current": d.get("current"), "queue": d.get("queue") or [],
            "past": (d.get("past") or [])[-5:]}


def _round_topic_mutate(body):
    """POST /api/goals/topic - user controls the round focus. Actions: queue {topic,
    description} | remove {index} | set {topic, description}. Duplicate topics (vs current /
    queue / past, normalized) are rejected so queued focus never repeats."""
    try:
        d = _load_round_topic()
        act = (body.get("action") or "").strip().lower()
        topic = (body.get("topic") or "").strip()[:200]
        desc = (body.get("description") or "").strip()[:1200]
        known = {_norm_topic((d.get("current") or {}).get("topic"))}
        known |= {_norm_topic(q.get("topic")) for q in d.get("queue") or []}
        known.discard("")
        if act == "queue":
            if not topic:
                return False, {"error": "topic required (short name for the round focus)"}
            if _norm_topic(topic) in known:
                return False, {"error": "duplicate topic - it is already current, queued or used recently"}
            d["queue"].append({"topic": topic, "description": desc,
                               "at": time.strftime("%Y-%m-%d %H:%M:%S")})
            d["queue"] = d["queue"][-5:]
        elif act == "remove":
            q = d.get("queue") or []
            i = int(body.get("index") or 0)
            if not (0 <= i < len(q)):
                return False, {"error": "bad index"}
            q.pop(i)
        elif act == "set":
            if not topic:
                return False, {"error": "topic required"}
            if _norm_topic(topic) in known:
                return False, {"error": "duplicate topic - it is already current, queued or used recently"}
            if d.get("current") and d["current"].get("topic"):
                d.setdefault("past", []).append(d["current"]["topic"][:120])
                d["past"] = d["past"][-10:]
            d["current"] = {"topic": topic, "description": desc,
                            "set_at": time.strftime("%Y-%m-%d %H:%M:%S"), "source": "user"}
        else:
            return False, {"error": "action must be queue | remove | set"}
        _save_round_topic(d)
        return True, _round_topic_snapshot()
    except Exception as e:
        return False, {"error": str(e)[:200]}


def _goal_sig(text):
    import hashlib
    n = _norm_topic(text)
    return hashlib.sha1(n.encode()).hexdigest()[:16] if n else ""


def _record_reached_goals(reached_pairs):
    """reached_pairs = [(text, agent), ...] goal lines currently at 100%. New sigs are appended
    to the anti-repeat ledger (dedup by sig, capped). Called from _goals_snapshot every poll -
    idempotent and cheap (hash of <=80 short strings)."""
    if not reached_pairs:
        return
    try:
        with open(CLOSED_TOPICS_FILE, encoding="utf-8") as f:
            d = json.load(f)
        if not isinstance(d, list):
            raise ValueError("bad shape")
    except Exception:
        d = []
    have = {e.get("sig") for e in d}
    added = 0
    for text, agent in reached_pairs:
        sig = _goal_sig(text)
        if not sig or sig in have:
            continue
        d.append({"sig": sig, "text": text[:140], "agent": agent,
                  "at": time.strftime("%Y-%m-%d")})
        have.add(sig); added += 1
    if added:
        try:
            tmp = CLOSED_TOPICS_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(d[-800:], f, indent=0)
            os.replace(tmp, CLOSED_TOPICS_FILE)
        except Exception:
            pass


def _closed_topics_recent(n=20):
    try:
        with open(CLOSED_TOPICS_FILE, encoding="utf-8") as f:
            d = json.load(f)
        return [e.get("text", "") for e in (d or [])[-n:] if e.get("text")]
    except Exception:
        return []


_FORECAST_MOD = None
_FORECAST_LOCK = None
def _fl():
    global _FORECAST_LOCK
    if _FORECAST_LOCK is None:
        import threading
        _FORECAST_LOCK = threading.Lock()
    return _FORECAST_LOCK

def _forecast_mod():
    """memory/goals/forecast_engine.py - the 10-steps-ahead prediction engine (2026-11-23)."""
    global _FORECAST_MOD
    if _FORECAST_MOD is not None:
        return _FORECAST_MOD
    import importlib.util
    p = os.path.join(HERE, "memory", "goals", "forecast_engine.py")
    spec = importlib.util.spec_from_file_location("forecast_engine", p)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    _FORECAST_MOD = m
    return m

_PLAN_ROUND_MOD = None


def _one_pager_block():
    """One-pager planning round (2026-11-24): 3 planners draft today's per-agent
    plan, a judge seat picks the best; maybe_run() gates on goal-set signature +
    staleness and fires LLM work in the background, so this is cheap per poll."""
    global _PLAN_ROUND_MOD
    try:
        if _PLAN_ROUND_MOD is None:
            import importlib.util
            spec = importlib.util.spec_from_file_location(
                "_portal_plan_round", os.path.join(HERE, "memory", "goals", "plan_round.py"))
            m = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(m)
            _PLAN_ROUND_MOD = m
        res = _PLAN_ROUND_MOD.maybe_pipeline()
        return res or {}
    except Exception:
        pass
    return {}


def _forecast_snapshot(max_age_s=900):
    """GET /api/goals/forecast payload: next-10 queue + 5-horizon cards. Recomputes when stale."""
    nf = os.path.join(HERE, "memory", "goals", "next10.json")
    age = None
    try:
        age = time.time() - os.path.getmtime(nf)
    except OSError:
        pass
    if age is None or age > max_age_s:
        with _fl():
            try:
                age2 = time.time() - os.path.getmtime(nf)
            except OSError:
                age2 = 1e9
            if age2 > max_age_s:
                _forecast_mod().refresh()
    with open(nf, encoding="utf-8") as f:
        doc = json.load(f)
    try:
        doc["age_s"] = int(time.time() - os.path.getmtime(nf))
    except OSError:
        pass
    doc["ok"] = True
    return doc

_FC_CACHE = {"ts": 0.0, "txt": {}}
def _forecast_block(agent_name):
    """Compact per-agent forecast for prompt injection (goal-FOLLOWING alignment)."""
    name = (agent_name or "").lower()
    if not name:
        return ""
    now = time.time()
    if now - _FC_CACHE["ts"] > 60:
        _FC_CACHE["txt"].clear()
        _FC_CACHE["ts"] = now
    if name in _FC_CACHE["txt"]:
        return _FC_CACHE["txt"][name]
    try:
        doc = _forecast_snapshot(max_age_s=3600)
    except Exception:
        return ""
    mine = [it for it in doc.get("next10", []) if it.get("agent") == name][:3]
    lines = ["FORECAST - 10 steps ahead (memory/goals/next10.json; full cards in forecast-latest.md):"]
    if mine:
        lines.append("- Your lane next: " + " | ".join(
            "#%d %s (ETA %s, P %.0f%%)" % (it["rank"], it.get("title", it["goal"])[:48], it["eta"][11:16], 100 * it["p_reached"])
            for it in mine))
    else:
        lines.append("- Your lane: no open goals in the next-10 queue (idle - contribute to a shared goal).")
    fl = doc.get("fleet", {})
    h24 = next((h for h in doc.get("horizons", []) if h["hours"] == 24), None)
    tail = []
    if fl.get("total"):
        tail.append("fleet %s/%s now" % (fl.get("done"), fl.get("total")))
    if h24:
        tail.append("~%d%% by %s" % (h24["fleet_pct"], h24["end"][5:16]))
    lv = doc.get("level_up_eta")
    if lv:
        tail.append("all-clear ETA " + lv)
    lines.append("- " + "; ".join(tail) + ". Align your next step with this queue; if you spot a flaw, fix the engine.")
    out = "\n".join(lines)[:600]
    _FC_CACHE["txt"][name] = out
    return out

_LANE_CACHE = {}
def _agent_lane_block(agent_name):
    """Per-agent focused memory map (2026-11-23 pointer upgrade): the root INDEX.md is injected
    for everyone; this adds the agent's own lane sub-index so a small-context seat sees its
    pointer map without a tool call."""
    name = (agent_name or "").lower()
    if not name:
        return ""
    now = time.time()
    c = _LANE_CACHE.get(name)
    if c and now - c[0] < 300:
        return c[1]
    p = os.path.join(HERE, "memory", name, "INDEX.md")
    out = ""
    try:
        with open(p, encoding="utf-8") as f:
            t = f.read()
        if len(t) > 700:
            t = t[:700] + " [...]"
        out = "YOUR LANE MAP (memory/%s/INDEX.md - read deeper leaves on demand):\n%s" % (name, t.strip())
    except OSError:
        pass
    _LANE_CACHE[name] = (now, out)
    return out

def _hot_file_guard(budget=2600):
    """MEMORY.md hot-file budget (portal-memory-modular skill): the hot file is injected into
    every prompt, so it must stay small. When it grows past budget, move its oldest dated
    '## YYYY-MM-DD' sections into memory/synthesis/hotfile-archive-<date>.md. Keeps: state line,
    non-dated sections (Counter/Durable/GOAL/Hot Notes) and the 3 newest dated sections."""
    mf = os.path.join(HERE, "MEMORY.md")
    try:
        if os.path.getsize(mf) <= budget:
            return None
        txt = open(mf, encoding="utf-8").read()
    except OSError:
        return None
    m0 = re.search(r"(?m)^## ", txt)
    head, body = (txt[:m0.start()], txt[m0.start():]) if m0 else (txt, "")
    secs = [s for s in re.split(r"(?m)^(?=## )", body) if s.strip()]
    dated = [s for s in secs if re.match(r"## \d{4}-\d{2}-\d{2}", s)]
    keep_dated = set(sorted(dated, key=lambda s: s[:10])[-3:])
    drop = [s for s in dated if s not in keep_dated]
    if not drop:
        return None
    arch_dir = os.path.join(HERE, "memory", "synthesis")
    try:
        os.makedirs(arch_dir, exist_ok=True)
        af = os.path.join(arch_dir, "hotfile-archive-%s.md" % time.strftime("%Y%m%d"))
        with open(af, "a", encoding="utf-8") as f:
            f.write("\n<!-- moved from MEMORY.md by _hot_file_guard at %s -->\n%s"
                    % (time.strftime("%Y-%m-%d %H:%M"), "".join(drop)))
        with open(mf, "w", encoding="utf-8") as f:
            f.write(head + "".join(s for s in secs if s not in drop))
        return af
    except OSError:
        return None

def _goals_snapshot():
    """Goal Velocity dashboard (2026-11-15, Designer; Researcher evidence-gated v2).
    Counts a goal DONE only when an acceptance/evidence marker is present. Delegates to
    goal_ledger.parse_agent_file (single source of truth) so the portal can NEVER diverge
    from the evidence-honest ledger: closure is evidence-gated, a literal '[x]' substring
    in a goal's DESCRIPTION no longer counts, and an em-dash '— recorded' note IS counted.
    Import is location-independent: memory/researcher/goal_ledger.py first (the strict,
    verified variant), then portal-root goal_ledger.py only as last resort (its EVIDENCE_PAT
    is loose - it matches '[x]' itself - so it must never be preferred). Response schema
    unchanged. blocked = not-done item carrying an EXPLICIT marker: '(blocked: ...)' or
    '[BLOCKED]' on the goal line (2026-11-16: plain prose containing the word no longer
    counts - Mechanic cycle-2 goal 6 'outbound blocked + logged' was a false positive).
    Per-agent counts + fleet %."""
    try:
        _hot_file_guard()
    except Exception:
        pass
    GOAL_BLOCKED_PAT = re.compile(r"(?i)(\[BLOCKED\]|\bblocked\s*[:)])")
    gdir = os.path.join(HERE, "memory", "goals")
    try:
        names = {(a.get("name") or "").lower() for a in load_agents().get("agents", [])}
    except Exception:
        names = set()
    parse = _goal_parser()
    if parse is None:
        return {"ok": False, "error": "goal_ledger module not found (memory/researcher or portal root)", "agents": []}
    agents = []
    _reached_now = []   # (text, agent) pairs at 100% -> anti-repeat ledger
    try:
        for fn in sorted(os.listdir(gdir)):
            if not fn.endswith(".md") or fn[:-3] == "INDEX":
                continue
            if names and fn[:-3].lower() not in names:
                continue  # skip summary/dated rollup files (all-goals-*, *-agent-goals, etc.)
            goals = parse(os.path.join(gdir, fn))
            done = sum(1 for g in goals if g["status"] == "reached")
            not_done = [g["text"] for g in goals if g["status"] != "reached"]
            blocked = sum(1 for t in not_done if GOAL_BLOCKED_PAT.search(t))
            for g in goals:
                if g["status"] == "reached":
                    _reached_now.append((g["text"], fn[:-3]))
            agents.append({"agent": fn[:-3], "total": len(goals), "done": done,
                           "open": len(not_done), "blocked": blocked})
    except Exception as e:
        return {"ok": False, "error": str(e), "agents": []}
    try:
        _record_reached_goals(_reached_now)   # anti-repeat ledger (idempotent per sig)
    except Exception:
        pass
    total = sum(a["total"] for a in agents)
    done_all = sum(a["done"] for a in agents)
    resp = {"ok": True, "generated": time.strftime("%Y-%m-%d %H:%M:%S"),
            "fleet_pct": round(100.0 * done_all / total, 1) if total else 0.0,
            "fleet_done": done_all, "fleet_total": total, "agents": agents}
    # Goal-cycle upgrade (2026-11-15): at 100% for ALL agents the backend arms a persistent
    # flag; start_group_run() consumes it and forces a new goal-setting round. Idempotent:
    # re-arming refreshes 'at' while armed, never resurrects a consumed flag.
    # 2026-11-23 fix: the old code DID resurrect - its bare except caught the intentional
    # "consumed" raise and re-armed on EVERY poll, so auto-loop passes kept consuming a flag
    # they never acted on and the new round (and its topic) never started. A consumed flag is
    # now re-armed only when no run is active.
    # 2026-11-24 fix: the 11-23 mtime test ("no agent-file newer than consumed_at") DEADLOCKED
    # completed cycles: the consuming run itself writes evidence into the goal files, so after
    # a normal cycle _newest > _ca_t forever and the flag was never re-armed - fleet sat at
    # 102/102 (Lv9) with 0 active since 05:51. Every state with the outer gate true and no
    # run active genuinely wants an arm: round happened+completed -> next cycle; round was a
    # no-op -> retry. Each arm leads to at most one consume by start_group_run, which starts
    # a real run, so churn is bounded by run cadence - the active-run guard alone suffices.
    if total and done_all >= total:
        gf = os.path.join(HERE, "memory", "goals", "GOAL_RESET_PENDING.json")
        _armed_now = False
        try:
            try:
                with open(gf, encoding="utf-8") as f:
                    d = json.load(f)
            except Exception:
                d = {}   # missing/corrupt - treat as never armed
            if d.get("armed"):
                _armed_now = True
            elif not d or not d.get("consumed_at"):
                with open(gf, "w", encoding="utf-8") as f:
                    json.dump({"armed": True, "at": time.strftime("%Y-%m-%d %H:%M:%S"),
                               "note": "All agent goals 100% reached - next group run starts a new goal-setting round."}, f)
                _armed_now = True
            else:
                try:
                    _ca_t = time.mktime(time.strptime(d["consumed_at"], "%Y-%m-%d %H:%M:%S"))
                except Exception:
                    _ca_t = 0.0
                _newest = 0.0
                for f2 in os.listdir(gdir):
                    if f2.endswith(".md") and (not names or f2[:-3].lower() in names):
                        try:
                            _newest = max(_newest, os.path.getmtime(os.path.join(gdir, f2)))
                        except OSError:
                            pass
                if not _active_run_id:
                    with open(gf, "w", encoding="utf-8") as f:
                        json.dump({"armed": True, "at": time.strftime("%Y-%m-%d %H:%M:%S"),
                                   "note": "All agent goals 100% reached - next group run starts a new goal-setting round."}, f)
                    _armed_now = True
        except Exception:
            pass
        resp["goal_reset_pending"] = _armed_now
    else:
        resp["goal_reset_pending"] = False
    # Level counter (2026-11-20): at 100% for a NEW goal-set signature _check_level_up bumps
    # the level and writes memory/levels/level_N.md; otherwise just report current state.
    try:
        if total and done_all >= total:
            resp.update(_check_level_up(resp) or {})
        else:
            _lst = _load_levels()
            _lhist = _lst.get("history") or []
            resp["level"] = int(_lst.get("level", 0))
            resp["latest_level_report"] = _lhist[-1].get("report") if _lhist else None
            resp["level_cycles"] = len(_lhist)
    except Exception:
        pass
    # Level counter always present in the response (UI renders it even at level 0).
    resp.setdefault("level", 0)
    resp.setdefault("latest_level_report", None)
    resp.setdefault("level_cycles", 0)
    return resp


_GOALS_HIST_CACHE = {"head": None, "ts": 0.0, "resp": None}
_GOAL_LINE_PAT = re.compile(r"^\s*(?:\d+[.)]\s+|[-*]\s*\[[ xX]\]\s*)")
_GOAL_MARKER_PAT = re.compile(r"\(\s*verified\s*:|(?:\u2014|--)\s*recorded\b|\(\s*pointer\s*:", re.IGNORECASE)


def _reached_at_commit(sha):
    """True reached count at one commit: reads the 8 agent goal files via `git show` and counts
    goal lines carrying an evidence marker (verified/recorded/pointer - presence, not re-validated
    against today's indexes). Missing file = 0 goals. Returns int or None on git failure."""
    total = 0
    for agent in ("orchestrator", "researcher", "builder", "archivist",
                  "scribe", "verifier", "designer", "mechanic"):
        r = _git(["show", "%s:memory/goals/%s.md" % (sha, agent)], max_out=30000)
        if not r["ok"] or not r["out"]:
            continue
        for ln in r["out"].splitlines():
            if _GOAL_LINE_PAT.match(ln) and _GOAL_MARKER_PAT.search(ln):
                total += 1
    return total


def _goals_history(max_commits=60, checkpoints=8):
    """Git-based goal progress (2026-11-16): goals ARE registered in git (memory/goals/*.md is
    tracked + auto-committed per turn) - this makes that history usable. Checkpoints = recent
    commits that touched memory/goals/; at each, the 8 goal files are read from that commit and
    marker-bearing goal lines counted (true count, not diff arithmetic - rewrites/marker churn
    made net-diff reconstruction unreliable). Cached 30 s per HEAD so panel polls stay cheap.
    stall_commits = consecutive recent commits with NO change to goal files (stall signal)."""
    resp = {"ok": False, "series": [], "stall_commits": 0, "last_change_commit": None,
            "commits_scanned": 0, "fleet_now": None}
    try:
        if not os.path.isdir(os.path.join(HERE, ".git")):
            resp["error"] = "no git repo"
            return resp
        r_head = _git(["rev-parse", "HEAD"])
        head = (r_head["out"] or "").strip().splitlines()[-1].strip() if r_head["ok"] else "?"
        if (_GOALS_HIST_CACHE["resp"] and _GOALS_HIST_CACHE["head"] == head
                and time.time() - _GOALS_HIST_CACHE["ts"] < 30):
            return dict(_GOALS_HIST_CACHE["resp"])
        # wider window for the timestamp lookup - goal-touching commits can be older than the
        # last `max_commits` overall commits (auto-commits between goal changes)
        r_all = _git(["log", "--format=%H|%cI", "-n", str(max(120, max_commits * 2))])
        if not r_all["ok"]:
            resp["error"] = "git log failed: " + (r_all["err"] or r_all["out"])[:120]
            return resp
        commits = [ln.split("|", 1) for ln in r_all["out"].splitlines() if "|" in ln]
        resp["commits_scanned"] = len(commits)
        # checkpoints: recent commits that touched goal files (newest first), thinned to `checkpoints`
        r_goal = _git(["log", "--format=%H", "-n", str(max_commits), "--", "memory/goals/"])
        goal_shas_full = [ln.strip() for ln in r_goal["out"].splitlines() if len(ln.strip()) == 40]
        ts_by_sha = {sha: ts for sha, ts in commits}
        goal_shas = goal_shas_full
        if len(goal_shas) > checkpoints:   # thin to `checkpoints` evenly spaced (keep newest)
            step = len(goal_shas) / float(checkpoints)
            goal_shas = [goal_shas[int(i * step)] for i in range(checkpoints)]
        series = []
        for sha in reversed(goal_shas):   # oldest first
            n = _reached_at_commit(sha)
            if n is None:
                continue
            series.append({"sha": sha[:7], "ts": ts_by_sha.get(sha, ""), "fleet_reached": n})
        resp["series"] = series
        stall = 0
        goal_set = set(goal_shas_full)    # FULL set - thinning is only for the curve
        for sha, _ts in commits:          # newest first -> stall count + last change
            if sha not in goal_set:
                stall += 1
            else:
                resp["last_change_commit"] = {"sha": sha[:7], "ts": _ts}
                break
        resp["stall_commits"] = stall
        try:
            snap = _goals_snapshot()
            resp["fleet_now"] = snap.get("fleet_done")
            resp["fleet_total"] = snap.get("fleet_total")
        except Exception:
            pass
        resp["ok"] = True
        _GOALS_HIST_CACHE.update(head=head, ts=time.time(), resp=resp)
        return resp
    except Exception as e:
        resp["error"] = str(e)[:200]
        return resp


_EVOLUTION = None


def _evolution_mod():
    """Load the evolution engine (portal-root evolution.py) once. EVOLUTION_HOME is pinned
    to HERE/evolution via setdefault, so the island never depends on the portal's launch cwd;
    a pre-set env var still wins (scratch-island tests)."""
    global _EVOLUTION
    if _EVOLUTION is None:
        os.environ.setdefault("EVOLUTION_HOME", os.path.join(HERE, "evolution"))
        import importlib.util as _ilu
        _spec = _ilu.spec_from_file_location("_evolution_engine", os.path.join(HERE, "evolution.py"))
        _mod = _ilu.module_from_spec(_spec); _spec.loader.exec_module(_mod)
        _EVOLUTION = _mod
    return _EVOLUTION


