.hl-gb{width:90px;text-align:right;font-weight:700;font-size:var(--fs-11);white-space:nowrap}
.hl-free{font-size:var(--fs-11);white-space:nowrap;margin-left:auto;min-width:60px;text-align:right}
.hl-chips{display:flex;flex-wrap:wrap;gap:4px;padding:2px 0 2px 78px}
