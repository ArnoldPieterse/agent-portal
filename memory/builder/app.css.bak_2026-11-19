/* ---- FleetTopology diagram (Designer goal #9, 2026-11-17) — all values tokenized per :root layer ---- */
/* 2026-11-17 (Studio seat): REMOVED a self-referential :root alias block that was here
   (--bg:var(--bg) ... --faint:var(--faint), added with the FleetTopology section). A var()
   cycle makes every token guaranteed-invalid at computed-value time, so ALL themed rules
   fell back to browser defaults -> page rendered raw white ("too bright" report, 2026-11-17).
   Canonical production family = the dark :root above (Orchestrator ruling 2026-11-14,
   memory/portal/design-tokens.md). Do NOT re-add token aliases in a second :root; a
   light theme belongs under [data-theme=light] with literal values only. */
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,Segoe UI,Roboto,sans-serif;padding:20px}
h1{font-size:16px;margin:0 0 4px;font-weight:650}
.sub{color:var(--dim);font-size:12px;margin:0 0 14px;line-height:var(--lh-loose)}
code{background:var(--line);border-radius:5px;padding:1px 5px;font-size:11px;color:var(--text)}
#fleetTopo{max-width:860px}
.legend{display:flex;gap:18px;font-size:11.5px;color:var(--dim);margin-top:12px;flex-wrap:wrap}
.legend i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:middle}
.ft-wrap{position:relative;width:100%;min-height:240px;font-family:system-ui,Segoe UI,Roboto,sans-serif}
.ft-svg{width:100%;height:auto;display:block;background:var(--bg);border:1px solid var(--line);border-radius:12px}
.ft-link{stroke:var(--line);stroke-width:1.5}
.ft-agentlink{stroke:var(--faint);stroke-width:1;opacity:.5}
.ft-host rect{fill:var(--panel);stroke:var(--line);stroke-width:1.5;transition:stroke .15s, fill .15s}
.ft-host:hover rect,.ft-host:focus rect{stroke:var(--acc);fill:var(--panel2)}
.ft-host:focus{outline:none}
.ft-portal rect{fill:var(--panel2);stroke:var(--line);stroke-width:1.5}
.ft-agent circle{fill:var(--faint)}
.ft-hostname{fill:var(--text);font-size:13px;font-weight:600}
.ft-subline{fill:var(--dim);font-size:10.5px}
.ft-state{stroke:rgba(0,0,0,.25)}
.ft-tooltip{position:absolute;z-index:5;max-width:250px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:11.5px;color:var(--text);box-shadow:0 6px 20px rgba(0,0,0,.4);pointer-events:none;line-height:var(--lh-loose)}
.ft-tt-head{display:flex;align-items:center;gap:6px;font-weight:600;margin-bottom:4px}
.ft-tt-head em{color:var(--dim);font-style:normal;font-weight:400}
.ft-tt-row{color:var(--dim);word-break:break-all}
.ft-tt-row b{color:var(--text);font-weight:600;margin-right:2px}
.ft-detail{position:absolute;right:10px;top:10px;z-index:4;width:230px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:12px;color:var(--text);box-shadow:0 8px 24px rgba(0,0,0,.5)}
.ft-dt-head{display:flex;align-items:center;gap:6px;font-size:13px;margin-bottom:2px}
.ft-dt-head em{color:var(--dim);font-style:normal;font-weight:400;font-size:11px}
.ft-dt-base{font-family:ui-monospace,Consolas,monospace;font-size:10.5px;color:var(--faint);word-break:break-all;margin-bottom:8px}
.ft-dt-sub{color:var(--dim);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;margin:6px 0 3px;font-weight:600}
.ft-models{margin:0;padding-left:16px;line-height:var(--lh-mono)}
.ft-quant{color:var(--acc);font-size:10px}
.ft-agents{display:flex;flex-wrap:wrap;gap:4px}
.ft-chip{background:var(--line);border-radius:8px;padding:1px 7px;font-size:11px;color:var(--text)}
.ft-empty{color:var(--faint);font-style:italic}/* Fleet states (Designer #2) */
.ft-skel{fill:var(--s2);opacity:.6;animation:ftP 1.4s ease-in-out infinite}@keyframes ftP{50%{opacity:.9}}
.ft-loading-label,.ft-error-sub{fill:var(--fd);font-size:12px}
.ft-error rect{fill:var(--s2);stroke:var(--err);stroke-width:1.5}.ft-error-icon{fill:var(--err);font-size:22px}
.ft-error-text{fill:var(--tx);font-size:13px}.ft-empty-state rect{fill:var(--s2);stroke:var(--bd)}


/* ── State patterns: loading / error / empty / conn-lost ─────────────── */
.state-loading,.state-error,.state-empty,.state-conn-lost{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:var(--sp-8);padding:var(--sp-24) var(--sp-16);
  min-height:80px;font-size:var(--fs-13);color:var(--dim);text-align:center
}
/* Loading spinner */
.state-loading .spinner{
  width:24px;height:24px;border-radius:50%;
  border:2px solid var(--line);border-top-color:var(--acc);
  animation:spin .8s linear infinite
}
@keyframes spin{to{transform:rotate(360deg)}}
.state-loading .label{font-size:var(--fs-12);color:var(--faint)}
/* Error state */
.state-error{color:var(--err)}
.state-error .icon{font-size:var(--fs-16);line-height:var(--lh-tight)}
.state-error .label{font-size:var(--fs-13)}
.state-error .hint{font-size:var(--fs-12);color:var(--faint)}
/* Empty state */
.state-empty .icon{font-size:var(--fs-16);opacity:.5}
.state-empty .label{font-size:var(--fs-13);color:var(--dim)}
/* Connection lost banner (horizontal, not centered) */
.state-conn-lost{
  flex-direction:row;gap:var(--sp-8);padding:var(--sp-8) var(--sp-16);
  min-height:auto;font-size:var(--fs-12);color:var(--warn);
  background:var(--int-bg);border:1px solid var(--int-border);border-radius:4px;
  width:100%;box-sizing:border-box
}
.state-conn-lost .dot{width:8px;height:8px;border-radius:50%;background:var(--warn);flex-shrink:0}

/* Reduced motion - disables non-essential animations for accessibility */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ---- UI Component Library v1 (ui/components.js) ---- */
.ui-card{display:flex;flex-direction:column;gap:var(--sp-4);padding:var(--sp-8);border-radius:8px;border:1px solid var(--line);background:var(--panel2);margin-bottom:var(--sp-4)}
.ui-card--sel{border-color:var(--acc);background:var(--sel-bg,rgba(79,140,255,.06))}
.ui-card[role=button]{cursor:pointer}
.ui-card__head{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-4)}
.ui-card__titles{display:flex;flex-direction:column;gap:2px;min-width:0}
.ui-card__title{font-size:var(--fs-13);overflow:hidden;text-overflow:ellipsis}
.ui-card__sub{font-size:var(--fs-11);color:var(--dim)}
.ui-card__body{font-size:var(--fs-12);color:var(--txt)}

.ui-badge{display:inline-flex;align-items:center;gap:4px;font-size:var(--fs-10);padding:1px 6px;border-radius:10px;background:var(--line);color:var(--dim)}
.ui-badge__dot{width:7px;height:7px;border-radius:50%;background:currentColor;flex-shrink:0}
.ui-badge--ok{color:var(--ok);background:rgba(61,220,132,.1)}
.ui-badge--warn{color:var(--warn);background:rgba(255,159,67,.1)}
.ui-badge--err{color:var(--err,#e05252);background:rgba(224,82,82,.1)}
.ui-badge--info{color:var(--acc,#4f8cff);background:rgba(79,140,255,.1)}
.ui-badge--dim{color:var(--dim);background:var(--line)}

.ui-gauge__label{font-size:10px;color:var(--dim)}

.ui-tl-node{display:inline-flex;flex-direction:column;align-items:center;padding:4px 8px;border-radius:6px;cursor:pointer;border:1px solid transparent}
.ui-tl-node:hover,.ui-tl-node:focus{border-color:var(--line);background:var(--panel2)}
.ui-tl-node--active{border-color:var(--acc);background:rgba(79,140,255,.06)}
.ui-tl-node__label{font-size:var(--fs-11);font-weight:600;margin-top:2px}
.ui-tl-node__stats{margin-top:1px}

.ui-collapsible{border:1px solid var(--line);border-radius:8px;margin-bottom:var(--sp-4);overflow:hidden}
.ui-collapsible__head{display:flex;align-items:center;gap:6px;width:100%;padding:var(--sp-8);background:var(--panel2);border:none;color:var(--txt);font-size:var(--fs-13);font-weight:600;cursor:pointer;text-align:left}
.ui-collapsible__head:hover{background:var(--panel)}
.ui-collapsible__body{padding:var(--sp-8);font-size:var(--fs-12);color:var(--txt)}
/* ---- Fleet Health Dashboard (Builder goal #3, 2026-11-18) ---- */
#fleetHealth{padding:var(--sp-8) var(--sp-16);border-bottom:1px solid var(--line)}
.fh-wrap{display:flex;flex-direction:column;gap:var(--sp-8)}
.fh-composite{display:flex;align-items:center;gap:var(--sp-8)}
.fh-composite-label{font-size:var(--fs-12);font-weight:600;color:var(--text);white-space:nowrap}
.fh-bar{flex:1;height:8px;background:var(--line);border-radius:4px;overflow:hidden}
.fh-bar-fill{height:100%;background:var(--fh-color,#2ecc71);border-radius:4px;transition:width .3s ease}
.fh-composite-score{font-size:var(--fs-14);font-weight:700;color:var(--fh-color,#2ecc71);min-width:50px;text-align:right}
.fh-hosts{display:flex;gap:var(--sp-8);flex-wrap:wrap}
.fh-host-badge{display:flex;align-items:center;gap:6px;padding:4px 10px;border:1px solid var(--fh-color,#2ecc71);border-radius:12px;font-size:var(--fs-11);cursor:default}
.fh-dot{width:8px;height:8px;border-radius:50%;background:var(--fh-color,#2ecc71)}
.fh-host-name{color:var(--text);font-weight:500}
.fh-score{color:var(--fh-color,#2ecc71);font-weight:700;font-size:var(--fs-12)}
.fh-footer{display:flex;gap:var(--sp-16);font-size:var(--fs-10);color:var(--dim)}
.fh-empty{font-size:var(--fs-12);color:var(--dim);font-style:italic;padding:var(--sp-8) 0}

/* Uploads v2: file-type icon, progress bar, error toast */
.chipfile .ficon{flex:none;font-size:14px;width:18px;text-align:center}
.chipfile .pbar{position:relative;flex:1;height:3px;background:var(--line);border-radius:2px;min-width:24px;overflow:hidden}
.chipfile .pbar .fill{position:absolute;left:0;top:0;bottom:0;background:var(--acc);border-radius:2px;transition:width .15s}
.chipfile .pbar.done .fill{background:var(--ok)}
.chipfile .pbar.err .fill{background:var(--err)}
#toast-wrap{position:fixed;bottom:var(--sp-16);right:var(--sp-16);z-index:9999;display:flex;flex-direction:column;gap:var(--sp-8);pointer-events:none}
.toast{pointer-events:auto;background:var(--panel2);border:1px solid var(--err);border-radius:8px;padding:var(--sp-8) var(--sp-16);font-size:var(--fs-12);color:var(--text);box-shadow:0 4px 16px rgba(0,0,0,.25);animation:toast-in .25s ease;max-width:320px}
.toast.success{border-color:var(--ok)}
@keyframes toast-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* Capacity gauge strip (2026-11-18, Orchestrator cycle-5 goal 2) */
.cap-row{display:flex;align-items:center;gap:var(--sp-8);padding:3px 0;font-size:var(--fs-12)}
.cap-name{width:90px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cap-bar{flex:1;height:6px;background:var(--line);border-radius:3px;overflow:hidden;min-width:40px}
.cap-fill{height:100%;border-radius:3px;transition:width .4s ease}
.cap-pct{width:32px;text-align:right;font-weight:700;font-size:var(--fs-11)}
.cap-meta{font-size:var(--fs-11);white-space:nowrap;margin-left:auto}


/* ---- Mobile Responsive Pass (Builder goal #8, 2026-11-18) ---- */
@media (max-width:480px){
  /* Prevent horizontal scroll entirely */
  body{overflow-x:hidden}
  *{min-width:0;max-width:100%}

  /* Tap targets: all interactive elements >= 44px */
  button, .btn, input[type=text], input[type=password], input[type=number],
  select, textarea, label.toggle, .seg button, .toggles button,
  #addAgent, #attach, #send, #resetBtn, #stopBtn, #intResume, #intDismiss{
    min-height:44px;min-width:44px;padding:8px 12px;box-sizing:border-box
  }
  .seg button{flex:1;font-size:var(--fs-13)}
  /* Hamburger nav (Builder goal #8): collapse panel toggles behind a menu button */
  .nav-toggle{display:inline-flex;align-items:center;justify-content:center;font-size:var(--fs-16)}
  .toggles{display:none}
  #modeBar.nav-open .toggles{display:flex;flex-wrap:wrap;gap:4px;width:100%;order:10}
  .toggles button{flex:1 1 auto;font-size:var(--fs-11);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #modeBar{gap:var(--sp-4)}
  .vdiv{display:none}

  /* Composer: full-width send */
  #composer{flex-wrap:wrap}
  #send{width:100%;order:10;margin-top:4px}
  #attach{position:relative;z-index:2}

  /* Panels: no fixed widths that cause overflow */
  .opsrow,.fh-composite,.fh-hosts,.cap-row{flex-wrap:wrap}
  .fh-host-badge{min-height:44px;display:flex;align-items:center}
  .ui-tl-node{min-height:44px;justify-content:center}
  .ui-collapsible__head{min-height:44px;padding:12px var(--sp-8)}

  /* Agent list cards tappable */
  .acard{min-height:44px}
  .ah button{min-height:44px;min-width:44px}

  /* Dialogs: full screen, large close button */
  dialog{width:100vw;height:100vh;max-height:none;border-radius:0;padding:0}
  .dhead button{min-height:44px;min-width:44px;font-size:var(--fs-16)}
  .dfoot button{min-height:44px;flex:1}

  /* Files list items */
  #filesList li{min-height:44px;display:flex;align-items:center;padding:8px}

  /* Toast: full width on mobile */
  #toast-wrap{left:var(--sp-8);right:var(--sp-8);bottom:var(--sp-16)}
  .toast{max-width:100%}

  /* Queue panel items */
  #queueList>*{min-height:44px;display:flex;align-items:center}
}

@media (max-width:375px){
  header{flex-wrap:nowrap}
  header h1{font-size:var(--fs-12);white-space:nowrap}
  .hint{display:none}
  #status{order:0;margin-left:auto}
  #modeHint{display:none}
  .toggles button{padding:6px 8px;font-size:10px}

  /* Fleet health: stack vertically */
  .fh-composite{flex-direction:column;align-items:flex-start}
  .fh-bar{width:100%}
  .cap-name{width:70px}

  /* Ops panel: full-width inputs */
  #gitMsg{width:100%;order:-1;margin-bottom:4px}
  .opsrow{flex-direction:column}
  .opsrow .btn{width:100%}

  /* Activity panel header */
  #actHead{flex-wrap:wrap;gap:4px}
  #actRefresh{margin-left:0}
}
/* ---- End Mobile Responsive Pass ---- */

/* ---- Hotload VRAM Gauge (Orchestrator cycle-6 goal 6, 2026-11-18) ---- */
